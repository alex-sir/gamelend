<% 
  const activeUser = typeof currentUser !== 'undefined' && currentUser ? currentUser : {
    firstName: 'User',
    lastName: '',
    email: 'user@example.com',
    role: 'borrower',
    phoneNumber: '',
    address: ''
  };
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile Settings - GameLend</title>
    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <style>
      .profile-header {
        background: linear-gradient(135deg, rgba(8, 75, 166, 0.2) 0%, rgba(18, 18, 18, 1) 100%);
        border-radius: 1rem;
        padding: 3rem 2rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      .settings-card {
        background-color: var(--color-black);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        overflow: hidden;
      }
      .settings-card-header {
        background-color: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.5rem;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role text-capitalize"><%= activeUser.role %></span>
        </a>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/browse" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search GameLend" aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li>
                    <a class="dropdown-item" href="/<%= activeUser.role %>/dashboard">
                      <%= activeUser.role.charAt(0).toUpperCase() + activeUser.role.slice(1) %> Dashboard
                    </a>
                  </li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= activeUser.firstName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>

          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-5">
      <div class="container">
        
        <div class="row mb-5">
          <div class="col-12">
            <div class="profile-header d-flex align-items-center shadow">
              <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 80px; height: 80px; font-size: 2rem; flex-shrink: 0;">
                <%= activeUser.firstName.charAt(0).toUpperCase() %>
              </div>
              <div>
                <h1 class="h2 mb-1"><%= activeUser.firstName %> <%= activeUser.lastName %></h1>
                <p class="text-muted mb-0"><i class="bi bi-envelope me-2"></i><%= activeUser.email %></p>
              </div>
            </div>
          </div>
        </div>
        <div class="row g-4 justify-content-center">
          <div class="col-lg-8">
            
            <% if (typeof success !== 'undefined' && success) { %>
              <div class="alert alert-success d-flex align-items-center shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <div><%= success %></div>
              </div>
            <% } %>
            
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger d-flex align-items-center shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div><%= error %></div>
              </div>
            <% } %>

            <div class="settings-card shadow-lg mb-4">
              <div class="settings-card-header">
                <h3 class="h5 mb-0"><i class="bi bi-person-lines-fill me-2 text-info"></i>Personal Information</h3>
              </div>
              <div class="card-body p-4">
                <form action="/profile?_method=PUT" method="POST" class="needs-validation" novalidate>
                  <div class="row g-3 mb-3">
                    <div class="col-md-6">
                      <label for="firstName" class="form-label text-muted small text-uppercase">First Name</label>
                      <input type="text" class="form-control bg-dark text-white border-secondary" id="firstName" name="firstName" value="<%= activeUser.firstName %>" required>
                      <div class="invalid-feedback">First name is required.</div>
                    </div>
                    <div class="col-md-6">
                      <label for="lastName" class="form-label text-muted small text-uppercase">Last Name</label>
                      <input type="text" class="form-control bg-dark text-white border-secondary" id="lastName" name="lastName" value="<%= activeUser.lastName %>" required>
                      <div class="invalid-feedback">Last name is required.</div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="email" class="form-label text-muted small text-uppercase">Email Address</label>
                    <input type="email" class="form-control bg-dark text-white border-secondary" id="email" name="email" value="<%= activeUser.email %>" required>
                    <div class="invalid-feedback">Please provide a valid email.</div>
                  </div>

                  <div class="mb-3">
                    <label for="phoneNumber" class="form-label text-muted small text-uppercase">Phone Number</label>
                    <input type="tel" class="form-control bg-dark text-white border-secondary" id="phoneNumber" name="phoneNumber" value="<%= activeUser.phoneNumber %>" placeholder="(123) 456-7890">
                  </div>

                  <div class="mb-4">
                    <label for="address" class="form-label text-muted small text-uppercase">Address</label>
                    <textarea class="form-control bg-dark text-white border-secondary" id="address" name="address" rows="2" placeholder="123 Gaming Blvd, City, ST 12345"><%= activeUser.address %></textarea>
                  </div>

                  <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-main px-4"><i class="bi bi-save me-2"></i>Save Details</button>
                  </div>
                </form>
              </div>
            </div>

            <div class="settings-card shadow-lg">
              <div class="settings-card-header">
                <h3 class="h5 mb-0"><i class="bi bi-shield-lock-fill me-2 text-warning"></i>Security Settings</h3>
              </div>
              <div class="card-body p-4">
                <form action="/profile/password?_method=PUT" method="POST" class="needs-validation" novalidate>
                  <div class="mb-3">
                    <label for="currentPassword" class="form-label text-muted small text-uppercase">Current Password</label>
                    <input type="password" class="form-control bg-dark text-white border-secondary" id="currentPassword" name="currentPassword" required>
                    <div class="invalid-feedback">You must enter your current password to make changes.</div>
                  </div>
                  
                  <div class="mb-4">
                    <label for="newPassword" class="form-label text-muted small text-uppercase">New Password</label>
                    <input type="password" class="form-control bg-dark text-white border-secondary" id="newPassword" name="newPassword" required minlength="6">
                    <div class="invalid-feedback">New password must be at least 6 characters long.</div>
                  </div>

                  <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-alternate px-4"><i class="bi bi-key me-2"></i>Update Password</button>
                  </div>
                </form>
              </div>
            </div>

          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPT_S 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/form-validation.js"></script>
  </body>
</html>
