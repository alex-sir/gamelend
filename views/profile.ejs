<% 
  // Fallback to ensure the page renders even if currentUser isn't perfectly passed during testing
  const activeUser = typeof currentUser !== 'undefined' && currentUser ? currentUser : {
    firstName: 'User',
    lastName: '',
    email: 'user@example.com',
    role: 'borrower',
    phoneNumber: '',
    address: ''
  };
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile Settings - GameLend</title>

    <link rel="icon" href="/icons/controller.png" type="image/png" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    
    <style>
      .profile-header {
        background: linear-gradient(rgba(18, 18, 18, 0.7), rgba(18, 18, 18, 0.9)), url('/images/gaming-collage.jpg') center/cover;
        padding: 4rem 0;
        border-bottom: 2px solid var(--color-orange);
      }
      .settings-card {
        background-color: var(--color-gray);
        border: 1px solid var(--color-gray-hover);
        border-radius: 15px;
      }
      .avatar-circle {
        width: 120px;
        height: 120px;
        background-color: var(--color-blue);
        color: var(--color-white);
        font-size: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 1rem;
        border: 4px solid var(--color-black);
        box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-house me-1"></i>Home
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a></li>
                  <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <li><a class="dropdown-item" href="/admin/dashboard">Admin Dashboard</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= activeUser.firstName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <header class="profile-header text-center">
      <div class="container">
        <h1 class="display-5 fw-bold text-white mb-2">Account Settings</h1>
        <p class="lead text-light mx-auto">Manage your personal information and preferences.</p>
      </div>
    </header>

    <main class="flex-grow-1 py-5">
      <div class="container">
        
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <div class="row g-4">
          <div class="col-lg-4">
            <div class="settings-card p-4 text-center h-100">
              <div class="avatar-circle">
                <%= activeUser.firstName.charAt(0).toUpperCase() %>
              </div>
              <h3 class="fw-bold mb-1"><%= activeUser.firstName %> <%= activeUser.lastName %></h3>
              <p class="text-muted mb-3"><%= activeUser.email %></p>
              
              <div class="mb-4">
                <span class="badge bg-primary fs-6 text-capitalize px-3 py-2 rounded-pill">
                  <i class="bi bi-person-badge me-1"></i><%= activeUser.role %> Account
                </span>
              </div>

              <hr class="border-secondary my-4">
              
              <div class="text-start">
                <h6 class="text-muted mb-3">ACCOUNT STATUS</h6>
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-shield-check text-success fs-5 me-2"></i>
                  <span>Active and in good standing</span>
                </div>
                <div class="d-flex align-items-center">
                  <i class="bi bi-calendar3 text-muted fs-5 me-2"></i>
                  <span>Member since <%= new Date().getFullYear() %></span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-8">
            <div class="settings-card p-4 p-md-5 h-100">
              <h3 class="fw-bold mb-4 border-bottom border-secondary pb-2">Personal Information</h3>
              
              <form action="/profile?_method=PUT" method="POST">
                
                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <label for="firstName" class="form-label text-muted">First Name</label>
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="firstName" name="firstName" value="<%= activeUser.firstName %>" required>
                  </div>
                  <div class="col-md-6">
                    <label for="lastName" class="form-label text-muted">Last Name</label>
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="lastName" name="lastName" value="<%= activeUser.lastName %>" required>
                  </div>
                </div>

                <div class="mb-4">
                  <label for="email" class="form-label text-muted">Email Address</label>
                  <input type="email" class="form-control bg-dark text-muted border-secondary" id="email" value="<%= activeUser.email %>" readonly>
                  <div class="form-text text-secondary"><i class="bi bi-info-circle me-1"></i>Email addresses cannot be changed. Contact support if you need to migrate your account.</div>
                </div>

                <div class="mb-4">
                  <label for="phoneNumber" class="form-label text-muted">Phone Number</label>
                  <input type="tel" class="form-control bg-dark text-white border-secondary" id="phoneNumber" name="phoneNumber" value="<%= activeUser.phoneNumber || '' %>" placeholder="(555) 123-4567">
                  <div class="form-text text-secondary">Used for rental coordination and delivery updates.</div>
                </div>

                <div class="mb-4">
                  <label for="address" class="form-label text-muted">Delivery Address</label>
                  <textarea class="form-control bg-dark text-white border-secondary" id="address" name="address" rows="3" placeholder="Enter your full street address"><%= activeUser.address || '' %></textarea>
                  <div class="form-text text-secondary">Required if you plan to use the "Accept with Delivery" feature.</div>
                </div>

                <div class="d-flex justify-content-end mt-5 pt-3 border-top border-secondary">
                  <button type="submit" class="btn btn-main"><i class="bi bi-save me-2"></i>Save Changes</button>
                </div>
              </form>

            </div>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-github me-2"></i>GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>
            &copy; <%= new Date().getFullYear() %> GameLend. A WSU CPT_S 489 Course Project. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
