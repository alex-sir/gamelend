<% 
  // Note: In a real application, these variables (categories, featuredItems, user) 
  // should be passed from your Express controller (e.g., res.render('index', { categories, featuredItems, user })).
  // They are defined here as fallbacks so the page renders perfectly right away.

  const navCategories = typeof categories !== 'undefined' ? categories : 
    ['Consoles', 'Games', 'Controllers', 'VR', 'Peripherals', 'Retro'];

  const items = typeof featuredItems !== 'undefined' ? featuredItems : [
    { name: 'PlayStation 5', image: 'assets/images/ps5.jpg', platform: 'Console', brand: 'Sony' },
    { name: 'Donkey Kong Bananza', image: 'assets/images/donkey-kong-bananza.jpg', platform: 'Nintendo Switch 2', brand: 'Platformer' },
    { name: 'Xbox Wireless Controller', image: 'assets/images/xbox-wireless-controller.jpg', platform: 'Controller', brand: 'Microsoft' }
  ];
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'GameLend - Rent and Lend Physical Games' %></title>

    <link rel="icon" href="../public/icons/controller.png" type="image/png" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" type="text/css" href="../public/css/app.css" />
  </head>
  <body>
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/search" method="GET">
            <input
              class="form-control"
              type="search"
              name="q"
              placeholder="Search GameLend"
              aria-label="Search"
            />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="offcanvas"
            ></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button
                  class="btn btn-alternate dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                >
                  <i class="bi bi-house me-1"></i>Portals
                </button>

                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li>
                    <a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href="/admin/dashboard">Admin Dashboard</a>
                  </li>
                </ul>
              </div>

              <% if (typeof user !== 'undefined' && user) { %>
                <div class="dropdown">
                  <button
                    class="btn btn-alternate dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                  >
                    <i class="bi bi-person-circle me-1"></i><%= user.username || 'Account' %>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                    <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                  </ul>
                </div>
              <% } else { %>
                <a href="/auth/login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right me-1"></i> Log In</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <nav class="navbar navbar-secondary navbar-expand-lg p-1">
      <div class="container-fluid d-flex justify-content-center">
        <ul class="nav flex-nowrap overflow-auto">
          <% navCategories.forEach(function(category) { %>
            <li class="nav-item">
              <a class="nav-link px-3" href="/category/<%= category.toLowerCase() %>"><%= category %></a>
            </li>
          <% }); %>
        </ul>
      </div>
    </nav>

    <section class="hero-section pt-3 pb-4">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <h1 class="mb-4">
              Rent and Lend Physical Games With Your Community
            </h1>
            <p class="mb-4">
              GameLend is a peer-to-peer platform where gamers share physical
              video games, consoles, and accessories. Try before you buy, or
              earn from your collection.
            </p>
            <div class="d-flex flex-wrap buttons-group">
              <a href="/auth/register" class="btn btn-main">Get Started</a>
              <a href="/borrower/catalog" class="btn btn-alternate">View Marketplace</a>
            </div>
          </div>
          <div class="col-lg-6 mt-4 mt-lg-2">
            <img
              src="assets/images/gaming-collage.jpg"
              alt="Gaming collection collage"
              class="hero-image"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="how-it-works-section p-lg-5 p-sm-0">
      <div class="container">
        <h2 class="mb-lg-5">How It Works</h2>
        <div class="row">
          <div class="col-md-6">
            <div class="role-card lend">
              <i class="bi bi-box-seam"></i>
              <h3>Lend Your Games</h3>
              <p>
                List your physical games, consoles, and accessories for rent.
                Set your own terms, approve requests, and earn from items
                sitting idle on your shelf. Build your reputation as a trusted
                lender in the community.
              </p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="role-card borrow">
              <i class="bi bi-bag-check"></i>
              <h3>Borrow What You Need</h3>
              <p>
                Browse available items, filter by platform and location, and
                request rentals from fellow gamers. Try new games before buying,
                access hardware you need temporarily, and save money while
                expanding your gaming horizons.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="marketplace-section">
      <div class="container">
        <h2>Featured Items</h2>
        
        <% if (items && items.length > 0) { %>
          <div id="marketplaceCarousel" class="carousel slide" data-bs-ride="carousel">
            
            <div class="carousel-indicators">
              <% items.forEach(function(item, index) { %>
                <button
                  type="button"
                  data-bs-target="#marketplaceCarousel"
                  data-bs-slide-to="<%= index %>"
                  class="<%= index === 0 ? 'active' : '' %>"
                  <%= index === 0 ? 'aria-current="true"' : '' %>
                  aria-label="Slide <%= index + 1 %>"
                ></button>
              <% }); %>
            </div>

            <div class="carousel-inner">
              <% items.forEach(function(item, index) { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <img src="<%= item.image %>" alt="<%= item.name %>" />
                  <div class="carousel-caption">
                    <h5><%= item.name %></h5>
                    <p><%= item.platform %> · <%= item.brand %></p>
                  </div>
                </div>
              <% }); %>
            </div>

            <button
              class="carousel-control-prev"
              type="button"
              data-bs-target="#marketplaceCarousel"
              data-bs-slide="prev"
            >
              <span class="carousel-control-prev-icon"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button
              class="carousel-control-next"
              type="button"
              data-bs-target="#marketplaceCarousel"
              data-bs-slide="next"
            >
              <span class="carousel-control-next-icon"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
        <% } else { %>
          <p class="text-center text-muted">No featured items available at the moment.</p>
        <% } %>
      </div>
    </section>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-github me-2"></i>GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>
            &copy; <%= new Date().getFullYear() %> GameLend. A WSU CPT_S 489 Course Project. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
