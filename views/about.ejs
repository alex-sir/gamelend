<% 
  // Fallback user object to ensure the navbar renders correctly
  const currentUser = typeof user !== 'undefined' ? user : null;
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About GameLend</title>

    <link rel="icon" href="/icons/controller.png" type="image/png" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/app.css" />
    
    <style>
      .team-card {
        background-color: var(--color-gray);
        border: 1px solid var(--color-gray-hover);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .team-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.4);
        border-color: var(--color-orange);
      }
      .about-hero {
        background: linear-gradient(rgba(18, 18, 18, 0.8), rgba(18, 18, 18, 0.95)), url('/images/gaming-collage.jpg') center/cover;
        padding: 6rem 0;
        border-bottom: 2px solid var(--color-orange);
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-house me-1"></i>Home
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/borrower/borrower-dashboard.html">Borrower Dashboard</a></li>
                  <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <li><a class="dropdown-item" href="/admin/admin-dashboard.html">Admin Dashboard</a></li>
                </ul>
              </div>

              <% if (currentUser) { %>
                <div class="dropdown">
                  <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-1"></i><%= currentUser.username || 'Account' %>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                    <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                  </ul>
                </div>
              <% } else { %>
                <a href="/auth/login" class="btn btn-main m-0"><i class="bi bi-box-arrow-in-right me-1"></i> Log In</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <header class="about-hero text-center">
      <div class="container">
        <h1 class="display-3 fw-bold text-white mb-3">Powering the Peer-to-Peer <br><span style="color: var(--color-orange);">Gaming Economy</span></h1>
        <p class="lead text-light mx-auto" style="max-width: 700px;">
          GameLend bridges the gap between collectors with idle hardware and gamers looking to experience the latest titles without breaking the bank.
        </p>
      </div>
    </header>

    <main class="flex-grow-1">
      
      <section class="py-5">
        <div class="container">
          <div class="row align-items-center mb-5">
            <div class="col-lg-6 mb-4 mb-lg-0">
              <h2 class="fw-bold mb-4" style="color: var(--color-blue);">Our Mission</h2>
              <p class="fs-5" style="color: var(--color-light-gray); line-height: 1.7;">
                Gaming is an expensive hobby. Consoles sit gathering dust between major releases, and new $70 titles are often completed in a weekend and never touched again. 
              </p>
              <p class="fs-5" style="color: var(--color-light-gray); line-height: 1.7;">
                GameLend is a structured online marketplace designed to lower the financial barrier to gaming. By enabling short-term access to physical equipment across multiple platforms, we support a flexible "try before you buy" model while helping local lenders monetize their collections safely.
              </p>
            </div>
            <div class="col-lg-6 text-center">
              <i class="bi bi-controller" style="font-size: 12rem; color: var(--color-gray-hover);"></i>
            </div>
          </div>
        </div>
      </section>

      <hr style="border-color: var(--color-gray-hover); width: 80%; margin: 0 auto;">

      <section class="py-5 mb-4" id="team">
        <div class="container">
          <div class="text-center mb-5">
            <h2 class="fw-bold">Meet the Developers</h2>
            <p class="text-muted">Built from the ground up for CPT_S 489 Web Development.</p>
          </div>
          
          <div class="row justify-content-center g-4">
            <div class="col-md-4">
              <div class="card team-card h-100 text-center p-4 rounded-4">
                <div class="mb-3">
                  <i class="bi bi-person-bounding-box" style="font-size: 4rem; color: var(--color-blue);"></i>
                </div>
                <h4 class="fw-bold mb-1">Tyler Weddle</h4>
                <p style="color: var(--color-orange);">Full-Stack Developer</p>
                <p class="text-muted small mt-2">Focused on system architecture, database design, and integrating the Model-View-Controller framework.</p>
              </div>
            </div>
            
            <div class="col-md-4">
              <div class="card team-card h-100 text-center p-4 rounded-4">
                <div class="mb-3">
                  <i class="bi bi-person-bounding-box" style="font-size: 4rem; color: var(--color-blue);"></i>
                </div>
                <h4 class="fw-bold mb-1">Jonahtan Vasquez</h4>
                <p style="color: var(--color-orange);">Full-Stack Developer</p>
                <p class="text-muted small mt-2">Specializing in borrower marketplace logic, routing, and search functionality implementation.</p>
              </div>
            </div>

            <div class="col-md-4">
              <div class="card team-card h-100 text-center p-4 rounded-4">
                <div class="mb-3">
                  <i class="bi bi-person-bounding-box" style="font-size: 4rem; color: var(--color-blue);"></i>
                </div>
                <h4 class="fw-bold mb-1">Alex Carbajal</h4>
                <p style="color: var(--color-orange);">Full-Stack Developer</p>
                <p class="text-muted small mt-2">Leading the lender role experience, equipment listing logic, and frontend EJS templating integration.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-4" style="background-color: var(--color-blue);">
        <div class="container text-center">
          <h5 class="text-white mb-3">Powered By</h5>
          <div class="d-flex justify-content-center gap-4 flex-wrap fs-5 text-white opacity-75">
            <span><i class="bi bi-server me-1"></i> Node.js</span>
            <span><i class="bi bi-router me-1"></i> Express</span>
            <span><i class="bi bi-database me-1"></i> MariaDB & Sequelize</span>
            <span><i class="bi bi-bootstrap me-1"></i> Bootstrap 5</span>
            <span><i class="bi bi-filetype-html me-1"></i> EJS</span>
          </div>
        </div>
      </section>

    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-github me-2"></i>GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>
            &copy; <%= new Date().getFullYear() %> GameLend. A Washington State University CPT_S 489 Course Project. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
