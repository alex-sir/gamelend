<% 
  // Safety check for user session
  const activeUser = typeof currentUser !== 'undefined' && currentUser ? currentUser : (typeof user !== 'undefined' ? user : null);

  // Randomly select a primary image from active listings (if passed from the backend)
  let missionImage = null;
  if (typeof featuredListings !== 'undefined' && featuredListings.length > 0) {
      // Filter listings to ensure they actually have images
      const validListings = featuredListings.filter(l => l.images && l.images.length > 0);
      if (validListings.length > 0) {
          const randomListing = validListings[Math.floor(Math.random() * validListings.length)];
          const primary = randomListing.images.find(img => img.isPrimary);
          missionImage = primary ? primary.imageUrl : randomListing.images[0].imageUrl;
      }
  }
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/app.css" />
    
    <style>
      .team-card {
        background-color: var(--color-gray);
        border: 1px solid var(--color-gray-hover);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .team-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.4);
        border-color: var(--color-orange);
      }
      .about-hero {
        background: linear-gradient(rgba(18, 18, 18, 0.8), rgba(18, 18, 18, 0.95)), url('/images/gaming-collage.svg') center/cover;
        padding: 6rem 0;
        border-bottom: 2px solid var(--color-orange);
      }
      .accordion-button:not(.collapsed) {
        background-color: rgba(0, 210, 255, 0.1);
        color: var(--color-blue);
      }
      .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(0, 210, 255, 0.5);
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/browse" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search GameLend" aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-house me-1"></i>Home
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (activeUser) { %>
                    <li><a class="dropdown-item" href="/<%= activeUser.role %>/dashboard">My Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a></li>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                </ul>
              </div>

              <% if (activeUser) { %>
                <div class="dropdown">
                  <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                   <i class="bi bi-person-circle me-1"></i><%= activeUser.username || activeUser.firstName || 'Account' %>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                    <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                  </ul>
                </div>
              <% } else { %>
                <a href="/auth/login" class="btn btn-main m-0"><i class="bi bi-box-arrow-in-right me-1"></i> Log In</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <header class="about-hero text-center">
      <div class="container">
        <h1 class="display-3 fw-bold text-white mb-3">Powering the Peer-to-Peer <br><span style="color: var(--color-orange);">Gaming Economy</span></h1>
        <p class="lead text-light mx-auto" style="max-width: 700px;">
          GameLend bridges the gap between collectors with idle hardware and gamers looking to experience the latest titles without breaking the bank.
        </p>
      </div>
    </header>

    <main class="flex-grow-1">
      
      <section class="py-5">
        <div class="container">
          <div class="row align-items-center mb-5">
            <div class="col-lg-6 mb-4 mb-lg-0">
              <h2 class="fw-bold mb-4" style="color: var(--color-blue);">Our Mission</h2>
              <p class="fs-5" style="color: var(--color-light-gray); line-height: 1.7;">
                Gaming is an expensive hobby. Consoles sit gathering dust between major releases, and new $70 titles are often completed in a weekend and never touched again.
              </p>
              <p class="fs-5" style="color: var(--color-light-gray); line-height: 1.7;">
                GameLend is a structured online marketplace designed to lower the financial barrier to gaming. By enabling short-term access to physical equipment across multiple platforms, we support a flexible "try before you buy" model while helping local lenders monetize their collections safely.
              </p>
            </div>
            
            <div class="col-lg-6 text-center">
              <% if (missionImage) { %>
                <img src="<%= missionImage %>" alt="Available Equipment on GameLend" class="img-fluid rounded-4 shadow-lg border border-secondary" style="max-height: 450px; width: 100%; object-fit: cover;" />
              <% } else { %>
                <i class="bi bi-controller" style="font-size: 12rem; color: var(--color-gray-hover);"></i>
              <% } %>
            </div>

          </div>
        </div>
      </section>

      <hr style="border-color: var(--color-gray-hover); width: 80%; margin: 0 auto;">

      <section class="py-5 mb-4" id="team">
        <div class="container">
          <div class="text-center mb-5">
            <h2 class="fw-bold">Meet the Developers</h2>
            <p class="text-muted">Built from the ground up for CPT_S 489 Web Development.</p>
          </div>
          
          <div class="row justify-content-center g-4">
            <div class="col-md-4">
              <div class="card team-card h-100 text-center p-4 rounded-4">
                <div class="mb-3">
                  <i class="bi bi-person-bounding-box" style="font-size: 4rem; color: var(--color-blue);"></i>
                </div>
                <h4 class="fw-bold mb-1">Tyler Weddle</h4>
                <p style="color: var(--color-orange);">Full-Stack Developer</p>
                <p class="text-muted small mt-2">Focused on system architecture, database design, and integrating the Model-View-Controller framework.</p>
              </div>
            </div>
            
            <div class="col-md-4">
              <div class="card team-card h-100 text-center p-4 rounded-4">
                <div class="mb-3">
                  <i class="bi bi-person-bounding-box" style="font-size: 4rem; color: var(--color-blue);"></i>
                </div>
                <h4 class="fw-bold mb-1">Jonahtan Vasquez</h4>
                <p style="color: var(--color-orange);">Full-Stack Developer</p>
                <p class="text-muted small mt-2">Specializing in borrower marketplace logic, routing, and search functionality implementation.</p>
              </div>
            </div>

            <div class="col-md-4">
              <div class="card team-card h-100 text-center p-4 rounded-4">
                <div class="mb-3">
                  <i class="bi bi-person-bounding-box" style="font-size: 4rem; color: var(--color-blue);"></i>
                </div>
                <h4 class="fw-bold mb-1">Alex Carbajal</h4>
                <p style="color: var(--color-orange);">Full-Stack Developer</p>
                <p class="text-muted small mt-2">Leading the lender role experience, equipment listing logic, and frontend EJS templating integration.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr style="border-color: var(--color-gray-hover); width: 80%; margin: 0 auto;">

      <section class="py-5" id="faq">
        <div class="container">
          <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: var(--color-blue);">Frequently Asked Questions</h2>
            <p class="text-muted">Everything you need to know about borrowing and lending on GameLend.</p>
          </div>
          
          <div class="row justify-content-center">
            <div class="col-lg-8">
              <div class="accordion accordion-flush rounded-4 overflow-hidden border border-secondary" id="faqAccordion">
                
                <div class="accordion-item bg-dark border-secondary">
                  <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-bottom border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                      <strong>How does renting on GameLend work?</strong>
                    </button>
                  </h2>
                  <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted">
                      Borrowers can browse available games, consoles, and accessories. Once you find an item you want, select your rental dates and submit a request. The lender will review the request and, upon approval, coordinate a hand-off. You'll be charged the daily rental rate for the duration of the period.
                    </div>
                  </div>
                </div>

                <div class="accordion-item bg-dark border-secondary">
                  <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-bottom border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                      <strong>Is it safe to lend my equipment?</strong>
                    </button>
                  </h2>
                  <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted">
                      Yes! GameLend implements an active rental tracking system. Both lenders and borrowers must have verified accounts, and our moderation team oversees the marketplace to ensure safety and resolve disputes quickly.
                    </div>
                  </div>
                </div>

                <div class="accordion-item bg-dark border-secondary">
                  <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-bottom border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                      <strong>How do I get paid as a lender?</strong>
                    </button>
                  </h2>
                  <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted">
                      Lenders set their own daily rental rate. Once a rental period concludes and the item is safely returned and confirmed via your dashboard, the total earnings are credited to your account.
                    </div>
                  </div>
                </div>

                <div class="accordion-item bg-dark border-secondary">
                  <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                      <strong>What happens if an item is damaged or not returned?</strong>
                    </button>
                  </h2>
                  <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted">
                      If an item is returned damaged or goes missing, you can use the "Report Issue" button on your Active Rentals dashboard. This immediately alerts our moderation team, suspends the transaction, and locks the borrower's account while we investigate and resolve the issue.
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </section>

      <hr style="border-color: var(--color-gray-hover); width: 80%; margin: 0 auto;">

      <section class="py-5 mb-5" id="contact">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-lg-8">
              <div class="text-center mb-5">
                <h2 class="fw-bold" style="color: var(--color-orange);">Contact Us</h2>
                <p class="text-muted">Need help with a rental or have a question? Send us a message.</p>
              </div>

              <div class="card team-card p-4 p-md-5 rounded-4 shadow-lg">
                <form id="contactForm" action="#" method="POST">
                  
                  <div class="row g-3 mb-3">
                    <div class="col-md-6">
                      <label for="contactName" class="form-label text-light">Full Name</label>
                      <input type="text" class="form-control bg-dark text-white border-secondary" id="contactName" placeholder="John Doe" required>
                    </div>
                    <div class="col-md-6">
                      <label for="contactEmail" class="form-label text-light">Email Address</label>
                      <input type="email" class="form-control bg-dark text-white border-secondary" id="contactEmail" placeholder="name@example.com" required>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="contactSubject" class="form-label text-light">Subject</label>
                    <select class="form-select bg-dark text-white border-secondary" id="contactSubject" required>
                      <option value="" selected disabled>Select a topic...</option>
                      <option value="Rental Issue">Rental Issue / Dispute</option>
                      <option value="Account Support">Account Support</option>
                      <option value="Bug Report">Report a Bug</option>
                      <option value="General Inquiry">General Inquiry</option>
                    </select>
                  </div>

                  <div class="mb-4">
                    <label for="contactMessage" class="form-label text-light">Message</label>
                    <textarea class="form-control bg-dark text-white border-secondary" id="contactMessage" rows="5" placeholder="How can we help you?" required></textarea>
                  </div>

                  <div class="d-grid">
                    <button type="submit" id="submitContactBtn" class="btn btn-main py-2 fs-5 fw-bold">Send Message</button>
                  </div>

                  <div id="contactSuccessMessage" class="alert alert-success d-none mt-4 mb-0 border-0 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i> 
                    Message successfully sent to the GameLend Support Team! We will get back to you shortly.
                  </div>

                </form>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-4" style="background-color: var(--color-blue);">
        <div class="container text-center">
          <h5 class="text-white mb-3">Powered By</h5>
          <div class="d-flex justify-content-center gap-4 flex-wrap fs-5 text-white opacity-75">
            <span><i class="bi bi-server me-1"></i> Node.js</span>
            <span><i class="bi bi-router me-1"></i> Express</span>
            <span><i class="bi bi-database me-1"></i> MariaDB & Sequelize</span>
            <span><i class="bi bi-bootstrap me-1"></i> Bootstrap 5</span>
            <span><i class="bi bi-filetype-html me-1"></i> EJS</span>
          </div>
        </div>
      </section>

    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-github me-2"></i>GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>
            &copy; <%= new Date().getFullYear() %> GameLend. A Washington State University CPT_S 489 Course Project. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/about.js"></script>
  </body>
</html>
