<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= listing.title %> - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/borrower/borrower.css">
  </head>

  <body class="d-flex flex-column min-vh-100">

    <!-- NAVBAR -->
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">

        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Borrower</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex">
            <input class="form-control" type="search" placeholder="Search...">
            <button class="btn btn-primary search-submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Borrower Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>

          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i>Borrower Dashboard
                </button>

                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a></li>
                  <li><a class="dropdown-item" href="/borrower/my-rentals">My Rentals</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i>Account
                </button>

                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>

            </div>
          </div>
        </div>

      </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="flex-grow-1 py-4">

      <div class="container">

        <a href="/borrower/dashboard" class="btn btn-alternate mb-3">
          <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
        </a>

        <div class="row">

          <!-- LEFT SIDE -->
          <div class="col-lg-8">

            <!-- IMAGE GALLERY -->
            <div class="section-card mb-4">
              <div id="listingCarousel" class="carousel slide">
                <div class="carousel-inner" style="border-radius:10px; overflow:hidden">
                  <%
                    const images = (listing.images && listing.images.length > 0)
                      ? listing.images.slice().sort((a, b) => (b.isPrimary ? 1 : 0) - (a.isPrimary ? 1 : 0))
                      : [{ imageUrl: "/images/gaming-collage.svg" }];
                  %>
                  <% images.forEach((img, idx) => { %>
                    <div class="carousel-item <%= idx === 0 ? "active" : "" %>">
                      <img src="<%= img.imageUrl %>" class="d-block w-100" style="aspect-ratio:16/9; object-fit:cover">
                    </div>
                  <% }) %>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                  <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                  <span class="carousel-control-next-icon"></span>
                </button>
              </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="section-card mb-4">
              <h2 class="h5 mb-3">Description</h2>
              <p>
                <%= listing.description %>
              </p>

              <h3 class="h6 mt-4 mb-2">Details</h3>
              <div class="row">
                <div class="col-md-6">
                  <p><strong>Category:</strong> <%= listing.category %></p>
                </div>
                <div class="col-md-6">
                  <p><strong>Lender:</strong> <%= listing.lender?.firstName || listing.lender?.email?.split("@")[0] || "Lender" %></p>
                </div>
              </div>
            </div>

            <% if (error) { %>
              <div class="alert alert-warning"><%= error %></div>
            <% } %>

          </div>

          <!-- SIDEBAR -->
          <div class="col-lg-4">
            <div class="section-card sticky-top" style="top:90px">
              <div class="text-center mb-3">
                <h2 class="item-price">$<%= Number(listing.dailyRate).toFixed(2) %><span style="font-size:1rem;color:var(--color-light-gray)">/day</span></h2>
              </div>

              <hr>

              <h3 class="h6 mb-3">
                <i class="bi bi-calendar-event me-2"></i>Select Rental Dates
              </h3>

              <div class="d-grid gap-2">
                <a href="/borrower/listings/<%= listing.id %>/request" class="btn btn-main">
                  <i class="bi bi-cart-check me-2"></i>Request Rental
                </a>
                <a href="/borrower/listings/<%= listing.id %>/report" class="btn btn-alternate">
                  <i class="bi bi-flag me-2"></i>Report Listing
                </a>
                <button class="btn btn-alternate" type="button" onclick="shareListing()">
                  <i class="bi bi-share me-2"></i>Share
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="about.html">About GameLend</a></li>
              <li><a href="about.html#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="about.html#faq">FAQ</a></li>
              <li><a href="about.html#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend"
                  ><i class="bi bi-github me-2"></i>GitHub</a
                >
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>
            &copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights
            reserved.
          </p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      function shareListing() {
        const url = window.location.href;
        navigator.clipboard.writeText(url);
        alert("Link copied to clipboard");
      }
    </script>

  </body>
</html>
