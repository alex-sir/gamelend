<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rental Confirmation - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles -->
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/borrower/borrower.css" />
  </head>

  <body>
    <!-- PRIMARY NAVBAR -->
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Borrower</span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Right-side navbar buttons -->
        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Borrower Menu</h5>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="offcanvas"
            ></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <!-- Dashboard dropdown -->
              <div class="dropdown">
                <button
                  class="btn btn-alternate dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                >
                  <i class="bi bi-person-circle me-1"></i>Borrower Dashboard
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a></li>
                  <li><a class="dropdown-item" href="/borrower/my-rentals">My Rentals</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <!-- Account dropdown -->
              <div class="dropdown">
                <button
                  class="btn btn-alternate dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                >
                  <i class="bi bi-person-circle me-1"></i>Account
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="catalog-section py-4">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-7">
            <div class="card bg-dark border-success">
              <div class="card-body text-center">
                <div
                  class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                  style="
                    width: 64px;
                    height: 64px;
                    background-color: rgba(25, 135, 84, 0.15);
                  "
                >
                  <i class="bi bi-check2-circle text-success fs-1"></i>
                </div>

                <h1 class="h4 mb-2">Rental request submitted</h1>
                <p class="text-secondary mb-4">
                  We’ve sent your request to the lender. You’ll receive a
                  notification once they review and respond.
                </p>

                <div
                  class="border rounded-3 p-3 text-start mb-3 bg-black bg-opacity-25"
                >
                  <div class="row g-2 small">
                    <div class="col-md-6">
                      <p class="mb-1 text-secondary">Request ID</p>
                      <p class="mb-0 bold">REQ-<%= request.id %></p>
                    </div>
                    <div class="col-md-6">
                      <p class="mb-1 text-secondary">Status</p>
                      <p class="mb-0">
                        <span class="badge rounded-pill bg-warning text-dark">Pending lender approval</span>
                      </p>
                    </div>
                    <div class="col-md-6 mt-2">
                      <p class="mb-1 text-secondary">Item</p>
                      <p class="mb-0">
                        <span class="bold"><%= request.listing.title %></span>
                      </p>
                    </div>
                    <div class="col-md-6 mt-2">
                      <p class="mb-1 text-secondary">Lender</p>
                      <p class="mb-0">
                        <i class="bi bi-person-circle me-1"></i
                        ><span class="bold"><%= request.listing.lender?.firstName || request.listing.lender?.email?.split("@")[0] || "Lender" %></span>
                      </p>
                    </div>
                    <div class="col-md-6 mt-2">
                      <p class="mb-1 text-secondary">Rental dates</p>
                      <p class="mb-0 bold">
                        <%= new Date(request.startDate).toLocaleDateString() %> – <%= new Date(request.endDate).toLocaleDateString() %>
                      </p>
                    </div>
                    <div class="col-md-6 mt-2">
                      <p class="mb-1 text-secondary">Total cost</p>
                      <p class="mb-0 bold">$<%= cost.total.toFixed(2) %></p>
                    </div>
                  </div>
                </div>

                <p class="small text-secondary mb-4">
                  You can review or cancel this request any time from
                  <span class="bold text-white">My Rentals</span>.
                </p>

                <div class="d-flex flex-column flex-md-row gap-2 justify-content-center">
                  <a href="/borrower/my-rentals" class="btn btn-main px-4">
                    <i class="bi bi-clock-history me-1"></i>Go to My Rentals
                  </a>
                  <a href="/borrower/dashboard" class="btn btn-alternate px-4">
                    <i class="bi bi-search me-1"></i>Browse more items
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="about.html">About GameLend</a></li>
              <li><a href="about.html#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="about.html#faq">FAQ</a></li>
              <li><a href="about.html#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend"
                  ><i class="bi bi-github me-2"></i>GitHub</a
                >
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>
            &copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights
            reserved.
          </p>
        </div>
      </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

