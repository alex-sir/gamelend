<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My Rentals - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles -->
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/borrower/borrower.css" />
  </head>

  <body>
    <!-- PRIMARY NAVBAR -->
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Borrower</span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Right-side navbar buttons -->
        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Borrower Menu</h5>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="offcanvas"
            ></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <!-- Dashboard dropdown -->
              <div class="dropdown">
                <button
                  class="btn btn-alternate dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                >
                  <i class="bi bi-person-circle me-1"></i>Borrower Dashboard
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a></li>
                  <li><a class="dropdown-item" href="/borrower/my-rentals">My Rentals</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <!-- Account dropdown -->
              <div class="dropdown">
                <button
                  class="btn btn-alternate dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                >
                  <i class="bi bi-person-circle me-1"></i>Account
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="catalog-section py-4">
      <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div>
            <h1 class="h3 mb-1">My rentals</h1>
            <p class="text-secondary mb-0 small">
              Track your active, pending, and completed rentals.
            </p>
          </div>
          <div></div>
        </div>

        <!-- TABS -->
        <ul class="nav nav-tabs mb-3" role="tablist">
          <li class="nav-item" role="presentation">
            <button
              class="nav-link active"
              id="active-tab"
              data-bs-toggle="tab"
              data-bs-target="#active"
              type="button"
              role="tab"
            >
              Active
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="pending-tab"
              data-bs-toggle="tab"
              data-bs-target="#pending"
              type="button"
              role="tab"
            >
              Pending
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="completed-tab"
              data-bs-toggle="tab"
              data-bs-target="#completed"
              type="button"
              role="tab"
            >
              Completed
            </button>
          </li>
        </ul>

        <div class="tab-content">
          <!-- ACTIVE RENTALS -->
          <div
            class="tab-pane fade show active"
            id="active"
            role="tabpanel"
            aria-labelledby="active-tab"
          >
            <% if (!activeRentals || activeRentals.length === 0) { %>
              <p class="text-secondary small">No active rentals.</p>
            <% } %>
            <% (activeRentals || []).forEach((rental) => { %>
              <%
                const listing = rental.request.listing;
                const img = listing.images && listing.images.length > 0
                  ? (listing.images.find((i) => i.isPrimary) || listing.images[0]).imageUrl
                  : "/images/gaming-collage.svg";
                const lenderName = listing.lender?.firstName || listing.lender?.email?.split("@")[0] || "Lender";
              %>
              <div class="card bg-dark mb-3">
                <div class="card-body d-flex flex-wrap gap-3 align-items-center">
                  <img src="<%= img %>" alt="<%= listing.title %>" class="rounded" style="width: 72px; height: 72px; object-fit: cover" />
                  <div class="flex-grow-1">
                    <p class="mb-1 bold"><%= listing.title %></p>
                    <p class="mb-1 small text-secondary">Lender: <span class="bold text-white"><%= lenderName %></span></p>
                    <p class="mb-0 small text-secondary">
                      Rental:
                      <span class="bold text-white"><%= new Date(rental.request.startDate).toLocaleDateString() %> – <%= new Date(rental.request.endDate).toLocaleDateString() %></span>
                    </p>
                  </div>
                  <div class="text-end">
                    <span class="badge bg-success mb-2">Active</span>
                    <div class="d-flex flex-column gap-2 my-rentals-card-actions">
                      <a href="/borrower/rentals/<%= rental.id %>" class="btn btn-sm btn-myrentals-view">View details</a>
                      <a href="/borrower/rentals/<%= rental.id %>/extend" class="btn btn-sm btn-myrentals-extend">Extend rental</a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- PENDING REQUESTS -->
          <div
            class="tab-pane fade"
            id="pending"
            role="tabpanel"
            aria-labelledby="pending-tab"
          >
            <% if (!pendingRequests || pendingRequests.length === 0) { %>
              <p class="text-secondary small">No pending requests.</p>
            <% } %>
            <% (pendingRequests || []).forEach((req) => { %>
              <%
                const listing = req.listing;
                const img = listing.images && listing.images.length > 0
                  ? (listing.images.find((i) => i.isPrimary) || listing.images[0]).imageUrl
                  : "/images/gaming-collage.svg";
                const lenderName = listing.lender?.firstName || listing.lender?.email?.split("@")[0] || "Lender";
              %>
              <div class="card bg-dark mb-3">
                <div class="card-body d-flex flex-wrap gap-3 align-items-center">
                  <img src="<%= img %>" alt="<%= listing.title %>" class="rounded" style="width: 72px; height: 72px; object-fit: cover" />
                  <div class="flex-grow-1">
                    <p class="mb-1 bold"><%= listing.title %></p>
                    <p class="mb-1 small text-secondary">Lender: <span class="bold text-white"><%= lenderName %></span></p>
                    <p class="mb-0 small text-secondary">
                      Requested dates:
                      <span class="bold text-white"><%= new Date(req.startDate).toLocaleDateString() %> – <%= new Date(req.endDate).toLocaleDateString() %></span>
                    </p>
                  </div>
                  <div class="text-end">
                    <span class="badge bg-warning text-dark mb-2">Pending</span>
                    <div class="d-flex flex-column gap-2 my-rentals-card-actions">
                      <a href="/borrower/requests/<%= req.id %>" class="btn btn-sm btn-myrentals-view">View details</a>
                      <form action="/borrower/requests/<%= req.id %>/cancel" method="POST" class="m-0">
                        <button class="btn btn-sm btn-myrentals-cancel w-100" type="submit">Cancel request</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- COMPLETED RENTALS -->
          <div
            class="tab-pane fade"
            id="completed"
            role="tabpanel"
            aria-labelledby="completed-tab"
          >
            <% if (!completedRentals || completedRentals.length === 0) { %>
              <p class="text-secondary small">No completed rentals yet.</p>
            <% } %>
            <% (completedRentals || []).forEach((rental) => { %>
              <%
                const listing = rental.request.listing;
                const lenderName = listing.lender?.firstName || listing.lender?.email?.split("@")[0] || "Lender";
              %>
              <div class="card bg-dark mb-3">
                <div class="card-body d-flex flex-wrap gap-3 align-items-center">
                  <div class="flex-grow-1">
                    <p class="mb-1 bold"><%= listing.title %></p>
                    <p class="mb-1 small text-secondary">Lender: <span class="bold text-white"><%= lenderName %></span></p>
                    <p class="mb-0 small text-secondary">
                      Completed:
                      <span class="bold text-white"><%= new Date(rental.request.startDate).toLocaleDateString() %> – <%= new Date(rental.request.endDate).toLocaleDateString() %></span>
                    </p>
                  </div>
                  <div class="text-end">
                    <span class="badge bg-secondary mb-2">Completed</span>
                    <div class="my-rentals-card-actions">
                      <a href="/borrower/rentals/<%= rental.id %>" class="btn btn-sm btn-myrentals-view">View details</a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="about.html">About GameLend</a></li>
              <li><a href="about.html#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="about.html#faq">FAQ</a></li>
              <li><a href="about.html#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend"
                  ><i class="bi bi-github me-2"></i>GitHub</a
                >
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>
            &copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights
            reserved.
          </p>
        </div>
      </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

