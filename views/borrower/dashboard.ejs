<%
  const userName = (typeof currentUser !== "undefined" && currentUser && currentUser.firstName)
    ? currentUser.firstName
    : "Borrower";
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Borrower Dashboard - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/borrower/borrower.css" />
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Borrower</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/borrower/dashboard" method="GET">
            <input
              class="form-control"
              type="search"
              name="q"
              placeholder="Search listings..."
              value="<%= searchQuery %>"
            />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Borrower Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <a class="btn btn-alternate" href="/borrower/my-rentals">
                <i class="bi bi-clock-history me-1"></i>My Rentals
              </a>
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i>Account
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="catalog-section py-4 flex-grow-1">
      <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div>
            <h1 class="h3 mb-1">Welcome back, <%= userName %>!</h1>
            <p class="text-secondary mb-0 small">
              Browse active listings and request rentals.
            </p>
          </div>
          <div class="d-flex gap-2">
            <a href="/borrower/my-rentals" class="btn btn-main">
              <i class="bi bi-clock-history me-1"></i>My Rentals
            </a>
          </div>
        </div>

        <% if (!listings || listings.length === 0) { %>
          <div class="alert alert-secondary">
            No listings match your search. Try clearing filters or changing keywords.
          </div>
        <% } else { %>
          <div class="row g-3">
            <% listings.forEach((listing) => { %>
              <%
                const primaryImage =
                  listing.images && listing.images.length > 0
                    ? (listing.images.find((img) => img.isPrimary) || listing.images[0]).imageUrl
                    : "/images/gaming-collage.svg";
                const lenderName = listing.lender?.firstName || listing.lender?.email?.split("@")[0] || "Lender";
              %>
              <div class="col-sm-6 col-lg-4 col-xl-3">
                <a href="/borrower/listings/<%= listing.id %>" class="text-decoration-none">
                  <div class="card bg-dark h-100">
                    <img
                      src="<%= primaryImage %>"
                      class="card-img-top"
                      alt="<%= listing.title %>"
                      style="aspect-ratio: 16/9; object-fit: cover"
                    />
                    <div class="card-body">
                      <h2 class="h6 mb-1 text-white"><%= listing.title %></h2>
                      <p class="small text-secondary mb-2">
                        <span class="badge bg-secondary me-1"><%= listing.category %></span>
                        <span class="text-secondary">by <span class="text-white"><%= lenderName %></span></span>
                      </p>
                      <p class="mb-0 text-white">
                        $<%= Number(listing.dailyRate).toFixed(2) %><span class="text-secondary">/day</span>
                      </p>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="copyright">
          <p>&copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
