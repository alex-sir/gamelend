<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';

  // Extract primary image for the sidebar display
  let primaryImage = '/images/gaming-collage.jpg';
  if (listing && listing.images && listing.images.length > 0) {
    const primary = listing.images.find(img => img.isPrimary);
    primaryImage = primary ? primary.imageUrl : listing.images[0].imageUrl;
  }
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Listing - <%= listing.title %></title>

    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/search" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="lender-header mb-4">
          <a href="/lender/listings/<%= listing.id %>" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Listing
          </a>
          <h1>Edit Listing</h1>
          <p>Update your listing information</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <div id="generalErrorAlert" class="alert alert-danger d-none align-items-center" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <div>Please fix the highlighted fields below before saving changes.</div>
        </div>

        <div class="alert alert-info d-flex align-items-center border-info mb-4" role="alert">
          <i class="bi bi-info-circle-fill me-3 fs-5"></i>
          <div>
            <strong>Note:</strong> If this listing is currently being rented, certain fields (like Title and Daily Rate) will be locked by the system to protect the active transaction. Only your description updates will be applied.
          </div>
        </div>

        <div class="row">
          <div class="col-lg-8">
            
            <form id="editListingForm" action="/lender/listings/<%= listing.id %>?_method=PUT" method="POST" novalidate>
              
              <div class="section-card">
                <h2 class="h5 mb-3"><i class="bi bi-info-circle me-2"></i>Basic Information</h2>

                <div class="mb-3">
                  <label for="itemTitle" class="form-label">Item Title <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="itemTitle" name="title" value="<%= listing.title %>" required minlength="5" maxlength="100" />
                  <div class="invalid-feedback"></div>
                </div>

                <div class="mb-3">
                  <label for="category" class="form-label">Category</label>
                  <input type="text" class="form-control text-muted bg-dark" id="category" value="<%= listing.category %>" disabled />
                  <div class="form-text">The equipment category cannot be changed after a listing is created.</div>
                </div>

                <div class="mb-3">
                  <label for="itemDescription" class="form-label">Description <span class="text-danger">*</span></label>
                  <textarea class="form-control" id="itemDescription" name="description" rows="7" required minlength="50" maxlength="2000"><%= listing.description %></textarea>
                  <div class="invalid-feedback"></div>
                  <div class="form-text">
                    <span id="charCount"><%= listing.description ? listing.description.length : 0 %></span>/2000 characters (minimum 50)
                  </div>
                </div>
              </div>

              <div class="section-card">
                <h2 class="h5 mb-3"><i class="bi bi-cash me-2"></i>Pricing</h2>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="dailyRate" class="form-label">Daily Rental Rate <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <input type="number" class="form-control" id="dailyRate" name="dailyRate" value="<%= listing.dailyRate %>" step="0.01" min="1.00" max="500.00" required />
                      <div class="invalid-feedback"></div>
                    </div>
                    <div class="form-text">Between $1.00 and $500.00</div>
                  </div>
                </div>
              </div>

              <div class="d-flex gap-2 mb-4 align-items-center">
                <button type="submit" class="btn btn-main">
                  <i class="bi bi-save me-2"></i>Save Changes
                </button>
                <a href="/lender/listings/<%= listing.id %>" class="btn btn-alternate">
                  Cancel
                </a>
                
                <button type="button" class="btn btn-danger ms-auto" id="openDeleteModalBtn">
                  <i class="bi bi-trash me-2"></i>Delete Listing
                </button>
              </div>
            </form>
          </div>

          <div class="col-lg-4">
            
            <div class="section-card mb-4">
              <h2 class="h5 mb-3"><i class="bi bi-images me-2"></i>Photos</h2>
              <div class="position-relative mb-3">
                <img src="<%= primaryImage %>" class="img-fluid rounded w-100" style="aspect-ratio: 16/9; object-fit: contain !important; background-color: var(--color-black);" alt="Primary Listing Image" />
              </div>
              <p class="text-muted mb-3 small">
                To add, remove, or change your primary image, use the Image Manager.
              </p>
              <a href="/lender/listings/<%= listing.id %>/images" class="btn btn-alternate w-100">
                <i class="bi bi-images me-2"></i>Manage Images
              </a>
            </div>

            <div class="section-card sticky-top" style="top: 90px">
              <h3 class="h5 mb-3"><i class="bi bi-graph-up me-2"></i>Listing Stats</h3>

              <div class="mb-3">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Status</span>
                  <strong><%= listing.status %></strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Total Rentals</span>
                  <strong><%= listing.totalRentals || 0 %></strong>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-muted">Total Earned</span>
                  <strong style="color: var(--color-orange)">$<%= parseFloat(listing.totalEarnings || 0).toFixed(2) %></strong>
                </div>
              </div>

              <hr class="border-secondary" />

              <h3 class="h6 mb-2">View</h3>
              <div class="d-grid gap-2">
                <a href="/lender/listings/<%= listing.id %>" class="btn btn-alternate btn-sm">
                  <i class="bi bi-eye me-1"></i>View Public Listing
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </main>

    <form id="deleteListingForm" action="/lender/listings/<%= listing.id %>?_method=DELETE" method="POST" style="display: none;"></form>

    <div class="modal fade" id="deleteListingModal" tabindex="-1" aria-labelledby="deleteListingModalLabel" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white" id="deleteListingModalLabel">
              <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirm Deletion
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light">
            Are you sure you want to delete <strong class="text-orange"><%= listing.title %></strong>? 
            <br><br>
            <small class="text-muted">This action will permanently archive your listing and remove it from public search results.</small>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmListingDeleteBtn">
              <i class="bi bi-trash me-2"></i>Delete Listing
            </button>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/edit-listing.js"></script>
  </body>
</html>
