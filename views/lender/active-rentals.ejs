<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';

  // Categorize the rentals
  const activeList = [];
  const upcomingList = [];
  const completedList = [];
  
  let activeValue = 0;
  let overdueCount = 0;
  const now = new Date();

  if (typeof rentals !== 'undefined' && rentals.length > 0) {
    rentals.forEach(rent => {
      const startDate = new Date(rent.request.startDate);
      const endDate = new Date(rent.request.endDate);
      const total = parseFloat(rent.actualTotal) || 0;

      if (rent.status === 'Completed') {
        completedList.push(rent);
      } else if (rent.status === 'Active') {
        // If the start date is in the future, it's upcoming
        if (startDate > now) {
          upcomingList.push(rent);
        } else {
          // It has already started
          activeList.push(rent);
          activeValue += total;
          
          // Check if it was supposed to be returned by now
          // (Adding 24 hours to the end date to give them until the end of the day)
          const overdueThreshold = new Date(endDate);
          overdueThreshold.setDate(overdueThreshold.getDate() + 1);
          if (overdueThreshold < now) {
            overdueCount++;
          }
        }
      }
    });
  }
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Active Rentals - GameLend</title>

    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    
    <style>
      .rental-img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
        margin-right: 1.5rem;
        background-color: var(--color-black);
      }
      .timeline {
        position: relative;
        padding-left: 1.5rem;
        margin-top: 1.5rem;
      }
      .timeline::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 7px;
        width: 2px;
        background-color: var(--color-gray-hover);
      }
      .timeline-item {
        position: relative;
        margin-bottom: 1.5rem;
      }
      .timeline-item:last-child {
        margin-bottom: 0;
      }
      .timeline-marker {
        position: absolute;
        top: 5px;
        left: -1.5rem;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background-color: var(--color-black);
        border: 2px solid var(--color-gray-hover);
      }
      .timeline-marker.completed {
        background-color: #28a745;
        border-color: #28a745;
      }
      .timeline-marker.overdue {
        background-color: #dc3545;
        border-color: #dc3545;
      }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="lender-header mb-4">
          <a href="/lender/dashboard" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
          </a>
          <h1>Active Rentals</h1>
          <p>Manage your current and past rentals</p>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="stats-card">
              <div class="stat-value"><%= activeList.length %></div>
              <div class="stat-label">Active Rentals</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stats-card">
              <div class="stat-value">$<%= activeValue.toFixed(2) %></div>
              <div class="stat-label">Active Rental Value</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stats-card">
              <div class="stat-value <%= overdueCount > 0 ? 'text-danger' : '' %>"><%= overdueCount %></div>
              <div class="stat-label">Overdue Returns</div>
            </div>
          </div>
        </div>

        <ul id="filter-tabs" class="nav nav-tabs mb-4" id="rentalTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
              <i class="bi bi-clock-history me-2"></i>Active
              <span class="badge bg-secondary ms-2"><%= activeList.length %></span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button" role="tab">
              <i class="bi bi-calendar-check me-2"></i>Upcoming
              <span class="badge bg-secondary ms-2"><%= upcomingList.length %></span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
              <i class="bi bi-check-circle me-2"></i>Completed
              <span class="badge bg-secondary ms-2"><%= completedList.length %></span>
            </button>
          </li>
        </ul>

        <div class="tab-content" id="rentalTabsContent">
          
          <div class="tab-pane fade show active" id="active" role="tabpanel">
            <% if (activeList.length > 0) { %>
              <% activeList.forEach(function(rent) { %>
                <% 
                  const start = new Date(rent.request.startDate);
                  const end = new Date(rent.request.endDate);
                  const reqDate = new Date(rent.request.createdAt);
                  
                  // By enforcing the UTC timezone, Javascript won't mistakenly subtract 7 hours
                  // and push the date backward to the previous day (e.g., April 19 -> April 18)
                  const startStr = start.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
                  const endStr = end.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
                  
                  // The exact timestamp of confirmation can still be displayed in the local timezone
                  const reqDateStr = reqDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
                  
                  const duration = Math.ceil((end - start) / (1000 * 60 * 60 * 24)) || 1;
                  const daysRemaining = Math.ceil((end - now) / (1000 * 60 * 60 * 24));
                  const isOverdue = daysRemaining < 0;
                  
                  let imageUrl = '/images/gaming-collage.svg';
                  if (rent.request.listing.images && rent.request.listing.images.length > 0) {
                    const primary = rent.request.listing.images.find(img => img.isPrimary);
                    imageUrl = primary ? primary.imageUrl : rent.request.listing.images[0].imageUrl;
                  }
                  
                  const borrowerName = rent.request.borrower.firstName || rent.request.borrower.email.split('@')[0];
                %>
                
                <div class="section-card mb-4">
                  <div class="row">
                    <div class="col-md-8">
                      <div class="d-flex align-items-start mb-3">
                        <img class="rental-img" src="<%= imageUrl %>" alt="<%= rent.request.listing.title %>" />
                        <div class="flex-grow-1">
                          <h3 class="h5 mb-1"><%= rent.request.listing.title %></h3>
                          <div class="mb-2">
                            <span class="badge-status <%= isOverdue ? 'badge-suspended' : 'badge-active' %>">
                              <%= isOverdue ? 'Overdue' : 'In Progress' %>
                            </span>
                          </div>
                          <div class="listing-meta">
                            <i class="bi bi-person me-1"></i><%= borrowerName %>
                          </div>
                        </div>
                      </div>

                      <div class="row mb-3">
                        <div class="col-md-6">
                          <p class="mb-1"><strong>Rental Period:</strong></p>
                          <p class="text-muted"><%= startStr %> - <%= endStr %> (<%= duration %> days)</p>
                        </div>
                        <div class="col-md-6">
                          <p class="mb-1"><strong>Return Date:</strong></p>
                          <p>
                            <strong style="color: <%= isOverdue ? '#dc3545' : 'var(--color-orange)' %>"><%= endStr %></strong>
                            <span class="<%= isOverdue ? 'text-danger fw-bold' : 'text-muted' %>">
                              (<%= isOverdue ? Math.abs(daysRemaining) + ' days overdue' : daysRemaining + ' days remaining' %>)
                            </span>
                          </p>
                        </div>
                      </div>

                      <div class="timeline">
                        <div class="timeline-item">
                          <div class="timeline-marker completed"></div>
                          <div>
                            <strong>Rental Confirmed</strong>
                            <p class="text-muted mb-0"><%= reqDateStr %></p>
                          </div>
                        </div>
                        <div class="timeline-item">
                          <div class="timeline-marker completed"></div>
                          <div>
                            <strong>Item Picked Up</strong>
                            <p class="text-muted mb-0"><%= startStr %></p>
                          </div>
                        </div>
                        <div class="timeline-item">
                          <div class="timeline-marker <%= isOverdue ? 'overdue' : '' %>"></div>
                          <div>
                            <strong>Return Scheduled</strong>
                            <p class="<%= isOverdue ? 'text-danger' : 'text-muted' %> mb-0">By <%= endStr %></p>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="col-md-4">
                      <div class="section-card mt-3 mt-md-0" style="background-color: var(--color-black)">
                        <h4 class="h6 mb-3">Rental Details</h4>
                        <div class="d-flex justify-content-between mb-2">
                          <span class="text-muted">Daily Rate</span>
                          <strong>$<%= parseFloat(rent.request.listing.dailyRate).toFixed(2) %></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                          <span class="text-muted">Duration</span>
                          <strong><%= duration %> days</strong>
                        </div>
                        <hr class="border-secondary" />
                        <div class="d-flex justify-content-between mb-3">
                          <span><strong>Total</strong></span>
                          <strong style="color: var(--color-orange); font-size: 1.25rem">$<%= parseFloat(rent.actualTotal).toFixed(2) %></strong>
                        </div>

                        <div class="d-grid gap-2 w-100">
                          <button class="btn btn-main btn-sm w-100 btn-contact-borrower" data-borrower-name="<%= borrowerName %>">
                            <i class="bi bi-chat-dots me-1"></i>Contact Borrower
                          </button>
                          <button class="btn btn-main btn-sm w-100 btn-report-issue" data-listing-title="<%= rent.request.listing.title %>">
                            <i class="bi bi-exclamation-triangle me-1"></i>Report Issue
                          </button>
                          <button class="btn btn-alternate btn-sm w-100 btn-confirm-return" data-listing-title="<%= rent.request.listing.title %>" data-rental-id="<%= rent.id %>">
                            <i class="bi bi-check-circle me-1"></i>Confirm Return
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="p-5 text-center text-muted border border-secondary rounded">
                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                <p>You have no active rentals in progress.</p>
              </div>
            <% } %>
          </div>

          <div class="tab-pane fade" id="upcoming" role="tabpanel">
            <div class="section-card p-0">
              <% if (upcomingList.length > 0) { %>
                <% upcomingList.forEach(function(rent) { %>
                  <% 
                    const startStr = new Date(rent.request.startDate).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
                    const end = new Date(rent.request.endDate);
                    const duration = Math.ceil((end - new Date(rent.request.startDate)) / (1000 * 60 * 60 * 24)) || 1;
                    
                    let imageUrl = '/images/gaming-collage.svg';
                    if (rent.request.listing.images && rent.request.listing.images.length > 0) {
                      const primary = rent.request.listing.images.find(img => img.isPrimary);
                      imageUrl = primary ? primary.imageUrl : rent.request.listing.images[0].imageUrl;
                    }
                    const borrowerName = rent.request.borrower.firstName || rent.request.borrower.email.split('@')[0];
                  %>
                  <div class="listing-item d-flex align-items-center p-3 border-bottom border-secondary">
                    <img class="rental-img mb-0" src="<%= imageUrl %>" alt="<%= rent.request.listing.title %>" style="width: 70px; height: 70px;" />
                    <div class="listing-details flex-grow-1">
                      <div class="listing-title mb-1"><%= rent.request.listing.title %></div>
                      <div class="listing-meta">
                        <i class="bi bi-person me-1"></i><%= borrowerName %> •
                        <span class="ms-2">Starts: <strong class="text-white"><%= startStr %></strong></span>
                      </div>
                    </div>
                    <div class="text-end">
                      <span class="badge-status badge-pending">Upcoming</span>
                      <div class="mt-2">
                        <strong style="color: var(--color-orange)">$<%= parseFloat(rent.actualTotal).toFixed(2) %></strong>
                        <p class="text-muted mb-0 small"><%= duration %> days</p>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="p-5 text-center text-muted">
                  <p>No upcoming rentals confirmed.</p>
                </div>
              <% } %>
            </div>
          </div>

          <div class="tab-pane fade" id="completed" role="tabpanel">
            <div class="section-card p-0">
              <% if (completedList.length > 0) { %>
                <% completedList.forEach(function(rent) { %>
                  <% 
                    const endStr = new Date(rent.request.endDate).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
                    const duration = Math.ceil((new Date(rent.request.endDate) - new Date(rent.request.startDate)) / (1000 * 60 * 60 * 24)) || 1;
                    
                    let imageUrl = '/images/gaming-collage.svg';
                    if (rent.request.listing.images && rent.request.listing.images.length > 0) {
                      const primary = rent.request.listing.images.find(img => img.isPrimary);
                      imageUrl = primary ? primary.imageUrl : rent.request.listing.images[0].imageUrl;
                    }
                    const borrowerName = rent.request.borrower.firstName || rent.request.borrower.email.split('@')[0];
                  %>
                  <div class="listing-item d-flex align-items-center p-3 border-bottom border-secondary">
                    <img class="rental-img mb-0" src="<%= imageUrl %>" alt="<%= rent.request.listing.title %>" style="width: 70px; height: 70px;" />
                    <div class="listing-details flex-grow-1">
                      <div class="listing-title mb-1"><%= rent.request.listing.title %></div>
                      <div class="listing-meta">
                        <i class="bi bi-person me-1"></i><%= borrowerName %> •
                        <span class="ms-2">Completed: <strong class="text-white"><%= endStr %></strong></span>
                      </div>
                    </div>
                    <div class="text-end">
                      <strong style="color: var(--color-orange)">$<%= parseFloat(rent.actualTotal).toFixed(2) %></strong>
                      <p class="text-muted mb-0 small"><%= duration %> days</p>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="p-5 text-center text-muted">
                  <p>You have no completed rentals in your history.</p>
                </div>
              <% } %>
            </div>
          </div>
          
        </div>
      </div>
    </main>

    <div class="modal fade" id="contactModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white"><i class="bi bi-chat-dots text-info me-2"></i>Contact <span id="contactBorrowerName">Borrower</span></h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body text-light">
            <p>Send a message directly to the borrower.</p>
            <textarea class="form-control bg-black text-white border-secondary" rows="4" placeholder="Type your message here..."></textarea>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-main" data-bs-dismiss="modal">Send Message</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Report an Issue</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body text-light">
            <p>Are you experiencing an issue with the rental of <strong id="reportListingTitle" class="text-orange"></strong>?</p>
            <select class="form-select bg-black text-white border-secondary mb-3">
              <option value="" disabled selected>Select an issue type...</option>
              <option value="damage">Equipment returned damaged</option>
              <option value="late">Equipment not returned on time</option>
              <option value="communication">Unable to reach borrower</option>
              <option value="other">Other</option>
            </select>
            <textarea class="form-control bg-black text-white border-secondary" rows="3" placeholder="Provide additional details for the admin team..."></textarea>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmReportBtn">
              <i class="bi bi-flag me-2"></i>Submit Report
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white"><i class="bi bi-check-circle text-success me-2"></i>Confirm Item Return</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body text-light">
            Are you confirming that <strong id="returnListingTitle" class="text-orange"></strong> has been returned to you by the borrower in acceptable condition?
            <br><br>
            <small class="text-muted">Confirming the return will complete the transaction and release your earnings from escrow. This action cannot be undone.</small>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-success" id="confirmReturnBtn">
              <i class="bi bi-check-circle me-2"></i>Confirm Return
            </button>
          </div>
        </div>
      </div>
    </div>

    <form id="completeRentalForm" method="POST" style="display: none;"></form>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/active-rentals.js"></script>
  </body>
</html>
