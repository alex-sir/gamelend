<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';

  // Accurate Date Formatter
  function formatDateSafe(dateInput) {
    if (!dateInput) return 'N/A';
    const d = new Date(dateInput);
    return d.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
  }

  const activeList = [];
  const upcomingList = [];
  const completedList = [];
  
  let activeValue = 0;
  let overdueCount = 0;
  
  const now = new Date();
  const nowMs = now.getTime();
  const msPerDay = 1000 * 60 * 60 * 24;

  if (typeof rentals !== 'undefined' && rentals.length > 0) {
    rentals.forEach(rent => {
      const startDate = new Date(rent.request.startDate);
      const endDate = new Date(rent.request.endDate);
      endDate.setUTCHours(23, 59, 59, 999);
      
      const total = parseFloat(rent.actualTotal) || 0;

      if (rent.status === 'Completed') {
        completedList.push(rent);
      } else if (rent.status === 'Active') {
        if (startDate > now) {
          upcomingList.push(rent);
        } else {
          activeList.push(rent);
          activeValue += total;
          
          if (endDate.getTime() < nowMs) {
            overdueCount++;
          }
        }
      }
    });
  }

  function getPrimaryImage(listing) {
    if (!listing || !listing.images || listing.images.length === 0) return '/images/gaming-collage.svg';
    const primary = listing.images.find(img => img.isPrimary);
    return primary ? primary.imageUrl : listing.images[0].imageUrl;
  }
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Active Rentals - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    
    <style>
      :root {
        --gamelend-orange: #ff6b00;
        --gamelend-blue: #00d2ff;
      }
      .text-orange { color: var(--gamelend-orange) !important; }
      .bg-orange { background-color: var(--gamelend-orange) !important; }
      .border-orange { border-color: var(--gamelend-orange) !important; }
      .text-gl-blue { color: var(--gamelend-blue) !important; }
      .bg-gl-blue { background-color: var(--gamelend-blue) !important; }

      .custom-dashboard-pills { gap: 0.75rem; }
      .custom-dashboard-pills .nav-link {
        color: #adb5bd; background-color: transparent; border-radius: 12px;
        padding: 0.6rem 1.5rem; font-weight: 600; transition: all 0.2s ease; border: 1px solid transparent;
      }
      .custom-dashboard-pills .nav-link:hover { background-color: rgba(255,255,255,0.03); color: white; }
      .custom-dashboard-pills .nav-link.active {
        background-color: var(--color-gray); color: white; border-color: rgba(255,255,255,0.1);
      }

      .stat-widget {
        background: linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(0,0,0,0.2) 100%);
        border: 1px solid var(--color-gray-hover); border-radius: 16px; padding: 1.5rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease; height: 100%;
      }
      .stat-widget:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
      .stat-icon-wrapper {
        width: 54px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
      }
      .letter-spacing-1 { letter-spacing: 1px; }

      .rental-card {
        border-radius: 16px; overflow: hidden; border: 1px solid var(--color-gray-hover);
        background-color: rgba(255,255,255,0.02); transition: all 0.3s ease;
      }
      .rental-card:hover { transform: translateY(-5px); box-shadow: 0 12px 24px rgba(0,0,0,0.3); }
      .rental-card.border-danger { border-color: rgba(220, 53, 69, 0.4) !important; }
      .rental-img-wrapper {
        width: 72px; height: 72px; border-radius: 12px; overflow: hidden; flex-shrink: 0;
        border: 1px solid rgba(255,255,255,0.1); background-color: var(--color-black);
      }
      .rental-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }

      /* Responsive Timeline Styling */
      @media (max-width: 576px) {
        .timeline-header { flex-direction: column; align-items: flex-start !important; gap: 0.5rem; }
        .timeline-dates { flex-direction: column; gap: 0.5rem; }
        .timeline-dates .text-end { text-align: left !important; }
      }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>
        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        <div class="lender-header d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary">
          <div>
            <a href="/lender/dashboard" class="btn btn-alternate rounded-pill px-4 mb-3">
              <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
            </a>
            <h1 class="h2 mb-1">Active Rentals</h1>
            <p class="text-muted mb-0">Monitor items currently in the hands of borrowers</p>
          </div>
        </div>

        <div class="row mb-4 g-4">
          <div class="col-md-4">
            <div class="stat-widget">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <p class="text-muted text-uppercase small fw-bold mb-1 letter-spacing-1">Items Out</p>
                  <h2 class="display-5 fw-bold text-white mb-0"><%= activeList.length %></h2>
                </div>
                <div class="stat-icon-wrapper border shadow-sm" style="background-color: rgba(0, 210, 255, 0.1); color: var(--gamelend-blue); border-color: rgba(0, 210, 255, 0.3) !important;">
                  <i class="bi bi-box-arrow-up-right"></i>
                </div>
              </div>
              <p class="text-muted small mb-0"><i class="bi bi-arrow-right-short me-1"></i>Currently rented by borrowers</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-widget">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <p class="text-muted text-uppercase small fw-bold mb-1 letter-spacing-1">Active Earnings</p>
                  <h2 class="display-5 fw-bold text-orange mb-0">$<%= activeValue.toFixed(2) %></h2>
                </div>
                <div class="stat-icon-wrapper border border-orange shadow-sm" style="background-color: rgba(255, 107, 0, 0.1); color: var(--gamelend-orange); border-color: rgba(255, 107, 0, 0.3) !important;">
                  <i class="bi bi-currency-dollar"></i>
                </div>
              </div>
              <p class="text-muted small mb-0"><i class="bi bi-arrow-right-short me-1"></i>Total value of active rentals</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-widget <%= overdueCount > 0 ? 'border-danger' : '' %>" style="<%= overdueCount > 0 ? 'background: linear-gradient(145deg, rgba(220, 53, 69, 0.05) 0%, rgba(0,0,0,0.2) 100%);' : '' %>">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <p class="<%= overdueCount > 0 ? 'text-danger' : 'text-muted' %> text-uppercase small fw-bold mb-1 letter-spacing-1">Overdue Returns</p>
                  <h2 class="display-5 fw-bold <%= overdueCount > 0 ? 'text-danger' : 'text-white' %> mb-0"><%= overdueCount %></h2>
                </div>
                <div class="stat-icon-wrapper <%= overdueCount > 0 ? 'bg-danger text-danger bg-opacity-25 border border-danger border-opacity-25' : 'bg-secondary bg-opacity-10 text-secondary border border-secondary' %> shadow-sm">
                  <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
              </div>
              <p class="<%= overdueCount > 0 ? 'text-danger' : 'text-muted' %> small mb-0"><i class="bi bi-arrow-right-short me-1"></i>Require immediate attention</p>
            </div>
          </div>
        </div>

        <div class="section-card p-4">
          <ul class="nav nav-pills custom-dashboard-pills border-bottom border-secondary pb-3 mb-4" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                Currently Out <span class="badge bg-light text-dark"><%= activeList.length %></span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#upcoming" type="button" role="tab">
                Upcoming <span class="badge bg-info text-dark"><%= upcomingList.length %></span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                Completed <span class="badge bg-secondary"><%= completedList.length %></span>
              </button>
            </li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="active" role="tabpanel">
              <% if (activeList.length === 0) { %>
                <div class="text-center py-5 rounded border border-secondary" style="background: rgba(0,0,0,0.15);">
                  <i class="bi bi-box-seam display-4 text-muted mb-3 d-block"></i>
                  <h4 class="text-light">No items currently out</h4>
                  <p class="text-muted">All your rented items have been returned to you safely.</p>
                </div>
              <% } else { %>
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                  <% activeList.forEach(function(rent) { %>
                    <% 
                      const start = new Date(rent.request.startDate);
                      const end = new Date(rent.request.endDate);
                      end.setUTCHours(23, 59, 59, 999);
                      const startMs = start.getTime();
                      const endMs = end.getTime();
                      const totalDurationMs = Math.max(msPerDay, endMs - startMs);
                      let progressPercent = Math.min(100, Math.max(0, ((nowMs - startMs) / totalDurationMs) * 100));
                      const isOverdue = nowMs > endMs;
                      const totalDays = Math.max(1, Math.ceil(totalDurationMs / msPerDay));
                      
                      let timelineLabel = '';
                      let timeRemainingText = '';
                      if (isOverdue) {
                        const daysOverdue = Math.ceil((nowMs - endMs) / msPerDay);
                        timelineLabel = `${daysOverdue} Day${daysOverdue !== 1 ? 's' : ''} Overdue`;
                        timeRemainingText = 'Return is Overdue!';
                      } else {
                        let currentDay = Math.floor((nowMs - startMs) / msPerDay) + 1;
                        if (currentDay < 1) currentDay = 1;
                        timelineLabel = `Day ${currentDay} of ${totalDays}`;
                        const msRemaining = endMs - nowMs;
                        const daysRem = Math.floor(msRemaining / msPerDay);
                        const hoursRem = Math.floor((msRemaining % msPerDay) / (1000 * 60 * 60));
                        timeRemainingText = daysRem > 0 ? `${daysRem}d ${hoursRem}h remaining` : `${hoursRem}h remaining`;
                      }
                      const borrowerName = rent.request.borrower.firstName || rent.request.borrower.email.split('@')[0];
                    %>
                    <div class="col">
                      <div class="card h-100 rental-card <%= isOverdue ? 'border-danger' : '' %> shadow-sm">
                        <div class="card-body p-4">
                          <div class="d-flex justify-content-between align-items-start mb-4">
                            <span class="badge <%= isOverdue ? 'bg-danger text-white fw-semibold' : 'bg-success text-white fw-bold' %> rounded-pill px-3 py-2 shadow-sm">
                              <i class="bi <%= isOverdue ? 'bi-exclamation-circle' : 'bi-check-circle' %> me-1"></i>
                              <%= isOverdue ? 'Overdue' : 'Active' %>
                            </span>
                            <div class="text-end">
                              <span class="fs-5 fw-bold text-orange">$<%= parseFloat(rent.actualTotal).toFixed(2) %></span>
                              <span class="d-block small text-muted"><%= totalDays %> day<%= totalDays > 1 ? 's' : '' %> @ $<%= parseFloat(rent.request.listing.dailyRate).toFixed(2) %>/day</span>
                            </div>
                          </div>
                          <div class="d-flex mb-4 align-items-center">
                            <div class="rental-img-wrapper me-3 shadow-sm"><img src="<%= getPrimaryImage(rent.request.listing) %>" alt="Listing Image"></div>
                            <div style="min-width: 0;">
                              <a href="/lender/listings/<%= rent.request.listing.id %>" class="text-decoration-none text-light text-truncate d-block">
                                <h5 class="card-title mb-1 fs-5 fw-bold" title="<%= rent.request.listing.title %>"><%= rent.request.listing.title %></h5>
                              </a>
                              <p class="mb-0 text-muted small text-truncate"><i class="bi bi-person-badge me-2"></i><%= borrowerName %></p>
                            </div>
                          </div>
                          <div class="bg-black p-3 rounded-4 border border-secondary shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3 timeline-header">
                              <span class="small text-muted text-uppercase fw-bold letter-spacing-1">Timeline &middot; <%= timelineLabel %></span>
                              <span class="badge <%= isOverdue ? 'bg-danger text-white' : 'bg-orange text-black' %> px-2 py-1 rounded-pill shadow-sm">
                                <%= timeRemainingText %>
                              </span>
                            </div>
                            <div class="position-relative mb-4 mt-2" style="height: 8px;">
                              <div class="w-100 bg-dark rounded-pill position-absolute top-0 start-0 h-100" style="border: 1px solid rgba(255,255,255,0.1);"></div>
                              <div class="position-absolute top-0 start-0 h-100 rounded-pill <%= isOverdue ? 'bg-danger' : 'bg-orange' %> shadow-sm" style="width: <%= progressPercent %>%;"></div>
                              <div class="position-absolute top-50 translate-middle rounded-circle bg-white border border-3 <%= isOverdue ? 'border-danger' : 'border-orange' %>" style="width: 16px; height: 16px; left: <%= progressPercent %>%; box-shadow: 0 0 10px rgba(0,0,0,0.8); z-index: 2;"></div>
                            </div>
                            <div class="d-flex justify-content-between small timeline-dates">
                              <div class="text-muted fw-medium"><span class="d-block text-uppercase" style="font-size: 0.65rem; opacity: 0.7;">Out</span><span class="text-light"><%= formatDateSafe(rent.request.startDate) %></span></div>
                              <div class="text-end fw-medium"><span class="d-block text-uppercase <%= isOverdue ? 'text-danger' : 'text-muted' %>" style="font-size: 0.65rem; opacity: 0.7;">Due</span><span class="<%= isOverdue ? 'text-danger fw-bold' : 'text-light' %>"><%= formatDateSafe(rent.request.endDate) %></span></div>
                            </div>
                          </div>
                        </div>
                        <div class="card-footer bg-transparent border-top border-secondary p-3 d-flex gap-2">
                          <button class="btn btn-sm btn-outline-light flex-fill btn-contact-borrower rounded-pill fw-medium" data-borrower-name="<%= borrowerName %>">
                            <i class="bi bi-chat-text me-2"></i>Contact
                          </button>
                          <button class="btn btn-sm <%= isOverdue ? 'btn-danger' : 'btn-success' %> flex-fill btn-confirm-return rounded-pill fw-bold shadow-sm" data-rental-id="<%= rent.id %>" data-listing-title="<%= rent.request.listing.title %>">
                            <i class="bi bi-box-arrow-in-down me-2"></i>Return Item
                          </button>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div class="tab-pane fade" id="upcoming" role="tabpanel">
              <% if (upcomingList.length === 0) { %>
                <div class="text-center py-5 rounded border border-secondary" style="background: rgba(0,0,0,0.15);">
                  <i class="bi bi-calendar-event display-4 text-muted mb-3 d-block"></i>
                  <h4 class="text-light">No upcoming rentals</h4>
                  <p class="text-muted">You don't have any accepted requests waiting to start.</p>
                </div>
              <% } else { %>
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                  <% upcomingList.forEach(function(rent) { %>
                    <% 
                      const start = new Date(rent.request.startDate);
                      const msUntilStart = start.getTime() - nowMs;
                      const daysUntil = Math.floor(msUntilStart / msPerDay);
                      const hoursUntil = Math.floor((msUntilStart % msPerDay) / (1000 * 60 * 60));
                      let startsInText = daysUntil > 0 ? `Starts in ${daysUntil}d ${hoursUntil}h` : `Starts in ${hoursUntil} hours`;
                      const borrowerName = rent.request.borrower.firstName || rent.request.borrower.email.split('@')[0]; 
                    %>
                    <div class="col">
                      <div class="card h-100 rental-card shadow-sm">
                        <div class="card-body p-4">
                          <div class="d-flex justify-content-between align-items-start mb-4">
                            <span class="badge bg-gl-blue text-dark rounded-pill px-3 py-2 fw-semibold shadow-sm"><i class="bi bi-clock-history me-1"></i>Upcoming</span>
                            <div class="text-end"><span class="fs-5 fw-bold text-orange">$<%= parseFloat(rent.actualTotal).toFixed(2) %></span></div>
                          </div>
                          <div class="d-flex mb-4 align-items-center">
                            <div class="rental-img-wrapper me-3 shadow-sm"><img src="<%= getPrimaryImage(rent.request.listing) %>" alt="Listing Image"></div>
                            <div style="min-width: 0;">
                              <h5 class="card-title mb-1 fs-5 fw-bold text-light text-truncate"><%= rent.request.listing.title %></h5>
                              <p class="mb-0 text-muted small"><i class="bi bi-person-badge me-2"></i><%= borrowerName %></p>
                            </div>
                          </div>
                          <div class="bg-black p-3 rounded-4 border border-secondary text-center shadow-sm">
                            <span class="small text-muted d-block text-uppercase fw-bold letter-spacing-1 mb-1">Hand-off Date</span>
                            <span class="text-gl-blue fs-5 fw-bold"><i class="bi bi-calendar-event me-2"></i><%= formatDateSafe(rent.request.startDate) %></span>
                            <div class="small mt-1 text-info opacity-75"><%= startsInText %></div>
                          </div>
                        </div>
                        <div class="card-footer bg-transparent border-top border-secondary p-3">
                          <button class="btn btn-sm btn-outline-info w-100 btn-contact-borrower rounded-pill fw-medium" data-borrower-name="<%= borrowerName %>">
                            <i class="bi bi-chat-text me-2"></i>Coordinate Hand-off
                          </button>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div class="tab-pane fade" id="completed" role="tabpanel">
              <% if (completedList.length === 0) { %>
                <div class="text-center py-5 rounded border border-secondary" style="background: rgba(0,0,0,0.15);">
                  <i class="bi bi-journal-check display-4 text-muted mb-3 d-block"></i>
                  <h4 class="text-light">No rental history</h4>
                  <p class="text-muted">You haven't completed any rentals yet.</p>
                </div>
              <% } else { %>
                <div class="bg-dark rounded-4 border border-secondary overflow-hidden shadow-sm p-1">
                  <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                      <thead class="text-muted text-uppercase small letter-spacing-1">
                        <tr>
                          <th class="border-secondary fw-semibold py-3 ps-4">Item</th>
                          <th class="border-secondary fw-semibold py-3">Borrower</th>
                          <th class="border-secondary fw-semibold py-3">Dates</th>
                          <th class="border-secondary fw-semibold py-3">Earned</th>
                          <th class="border-secondary fw-semibold py-3">Status</th>
                          <th class="border-secondary fw-semibold py-3 text-end pe-4">Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% completedList.forEach(function(rent) { %>
                          <% const borrowerName = rent.request.borrower.firstName || rent.request.borrower.email.split('@')[0]; %>
                          <tr>
                            <td class="border-secondary border-opacity-50 ps-4 py-3">
                              <div class="d-flex align-items-center">
                                <img src="<%= getPrimaryImage(rent.request.listing) %>" class="rounded object-fit-cover me-3 border border-secondary" style="width: 48px; height: 48px;" alt="Img">
                                <span class="text-light fw-medium"><%= rent.request.listing.title %></span>
                              </div>
                            </td>
                            <td class="border-secondary border-opacity-50 text-muted"><%= borrowerName %></td>
                            <td class="border-secondary border-opacity-50 text-muted small"><%= formatDateSafe(rent.request.startDate) %> to <%= formatDateSafe(rent.request.endDate) %></td>
                            <td class="border-secondary border-opacity-50 text-success fw-bold fs-6">$<%= parseFloat(rent.actualTotal).toFixed(2) %></td>
                            <td class="border-secondary border-opacity-50"><span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary rounded-pill px-2 py-1">Completed</span></td>
                            <td class="border-secondary border-opacity-50 text-end pe-4">
                              <button class="btn btn-sm btn-outline-danger rounded-pill px-3 btn-report-issue" data-listing-title="<%= rent.request.listing.title %>">Report Issue</button>
                            </td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </main>

    <div class="modal fade" id="contactModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg rounded-4">
          <div class="modal-header border-secondary p-4">
            <h5 class="modal-title text-white fw-bold"><i class="bi bi-envelope text-info me-2"></i>Contact Borrower</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light p-4">
            <p>Send a message to <strong id="contactBorrowerName" class="text-info"></strong> regarding this rental.</p>
            <textarea class="form-control bg-black text-white border-secondary mt-3 p-3 rounded-3" rows="4" placeholder="Type your message here..."></textarea>
          </div>
          <div class="modal-footer border-secondary p-3">
            <button type="button" class="btn btn-alternate rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-main rounded-pill px-4" data-bs-dismiss="modal" onclick="alert('Message feature in development!');">Send Message</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg rounded-4">
          <div class="modal-header border-secondary p-4">
            <h5 class="modal-title text-white fw-bold"><i class="bi bi-flag-fill text-danger me-2"></i>Report an Issue</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light p-4">
            <p>Are you reporting damage or a missing item for <br><strong id="reportListingTitle" class="text-warning fs-5 mt-2 d-block"></strong></p>
          </div>
          <div class="modal-footer border-secondary p-3">
            <button type="button" class="btn btn-alternate rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmReportBtn" data-bs-dismiss="modal" onclick="alert('Support ticket created. Our team will contact you shortly.');">Submit Report</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-success shadow-lg rounded-4">
          <div class="modal-header border-secondary p-4">
            <h5 class="modal-title text-white fw-bold"><i class="bi bi-box-arrow-in-down text-success me-2"></i>Confirm Item Return</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light p-4">
            <p>Did you successfully receive <br><strong id="returnListingTitle" class="text-success fs-5 mt-2 d-block"></strong> <br>back from the borrower?</p>
            <div class="alert alert-dark border-secondary mb-0">
              <p class="small text-muted mb-0"><i class="bi bi-info-circle me-2"></i>Confirming this will end the active rental period and mark the transaction as complete. Ensure all components are present and undamaged before confirming.</p>
            </div>
          </div>
          <div class="modal-footer border-secondary p-3">
            <button type="button" class="btn btn-alternate rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <form id="completeRentalForm" method="POST" class="m-0">
              <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                <i class="bi bi-check-circle me-2"></i>Confirm Return
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li><a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/active-rentals.js"></script>
  </body>
</html>
