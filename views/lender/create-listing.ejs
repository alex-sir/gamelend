<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';
  const form = typeof formData !== 'undefined' ? formData : {};
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Listing - GameLend</title>

    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li>
                      <a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a>
                    </li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        <div class="lender-header mb-4">
          <a href="/lender/dashboard" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
          </a>
          <h1>Create New Listing</h1>
          <p>List your gaming equipment to start earning</p>
        </div>

        <div class="row">
          <div class="col-lg-8">
            
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div><%= error %></div>
              </div>
            <% } %>

            <div id="generalErrorAlert" class="alert alert-danger d-none align-items-center" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <div>Please fix the highlighted fields below before submitting your listing.</div>
            </div>

            <div class="section-card">
              <form id="createListingForm" action="/lender/listings" method="POST" novalidate>
                
                <div class="mb-4">
                  <label class="form-label">Equipment Category <span class="text-danger">*</span></label>
                  <div class="row g-3">
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="category" id="categoryGame" value="Video Game" required <%= form.category === 'Video Game' ? 'checked' : '' %> />
                      <label class="btn btn-outline-primary w-100 py-3" for="categoryGame">
                        <i class="bi bi-disc fs-3 d-block mb-2"></i>Video Game
                      </label>
                    </div>
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="category" id="categoryConsole" value="Console" <%= form.category === 'Console' ? 'checked' : '' %> />
                      <label class="btn btn-outline-primary w-100 py-3" for="categoryConsole">
                        <i class="bi bi-tv fs-3 d-block mb-2"></i>Console
                      </label>
                    </div>
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="category" id="categoryAccessory" value="Accessory" <%= form.category === 'Accessory' ? 'checked' : '' %> />
                      <label class="btn btn-outline-primary w-100 py-3" for="categoryAccessory">
                        <i class="bi bi-controller fs-3 d-block mb-2"></i>Accessory
                      </label>
                    </div>
                    <div class="col-md-3">
                      <input type="radio" class="btn-check" name="category" id="categoryOther" value="Other" <%= form.category === 'Other' ? 'checked' : '' %> />
                      <label class="btn btn-outline-primary w-100 py-3" for="categoryOther">
                        <i class="bi bi-three-dots fs-3 d-block mb-2"></i>More...
                      </label>
                    </div>
                  </div>
                </div>

                <hr class="border-secondary my-4" />

                <div class="mb-4">
                  <h3 class="h5 mb-3">Core Details</h3>

                  <div class="mb-3">
                    <label for="itemTitle" class="form-label">Title <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="itemTitle" name="title" placeholder="e.g., PlayStation 5 Digital Edition" value="<%= form.title || '' %>" required minlength="5" maxlength="100" />
                    <div class="invalid-feedback"></div>
                    <div class="form-text">5-100 characters</div>
                  </div>

                  <div class="mb-3">
                    <label for="itemDescription" class="form-label">Description <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="itemDescription" name="description" rows="5" placeholder="Describe your item in detail..." required minlength="50" maxlength="2000"><%= form.description || '' %></textarea>
                    <div class="invalid-feedback"></div>
                    <div class="form-text">
                      <span id="charCount"><%= form.description ? form.description.length : 0 %></span>/2000 characters (minimum 50)
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label for="condition" class="form-label">Condition <span class="text-danger">*</span></label>
                      <select class="form-select" id="condition" name="condition" required>
                        <option value="">Select condition...</option>
                        <option value="New" <%= form.condition === 'New' ? 'selected' : '' %>>New</option>
                        <option value="Like New" <%= form.condition === 'Like New' ? 'selected' : '' %>>Like New</option>
                        <option value="Very Good" <%= form.condition === 'Very Good' ? 'selected' : '' %>>Very Good</option>
                        <option value="Good" <%= form.condition === 'Good' ? 'selected' : '' %>>Good</option>
                        <option value="Acceptable" <%= form.condition === 'Acceptable' ? 'selected' : '' %>>Acceptable</option>
                      </select>
                      <div class="invalid-feedback"></div>
                    </div>

                    <div class="col-md-6 mb-3">
                      <label for="quantity" class="form-label">Quantity Available <span class="text-danger">*</span></label>
                      <input type="number" class="form-control" id="quantity" name="quantity" value="<%= form.quantity || '1' %>" min="1" max="99" required />
                      <div class="invalid-feedback"></div>
                    </div>
                  </div>
                </div>

                <hr class="border-secondary my-4" />

                <div id="gameFields" class="category-fields" style="display: <%= form.category === 'Video Game' ? 'block' : 'none' %>">
                  <h3 class="h5 mb-3">Video Game Specifics</h3>
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label for="platform" class="form-label">Platform <span class="text-danger">*</span></label>
                      <select class="form-select" id="platform" name="platform">
                        <option value="">Select platform...</option>
                        <option value="PlayStation 5" <%= form.platform === 'PlayStation 5' ? 'selected' : '' %>>PlayStation 5</option>
                        <option value="PlayStation 4" <%= form.platform === 'PlayStation 4' ? 'selected' : '' %>>PlayStation 4</option>
                        <option value="Xbox Series X/S" <%= form.platform === 'Xbox Series X/S' ? 'selected' : '' %>>Xbox Series X/S</option>
                        <option value="Xbox One" <%= form.platform === 'Xbox One' ? 'selected' : '' %>>Xbox One</option>
                        <option value="Nintendo Switch" <%= form.platform === 'Nintendo Switch' ? 'selected' : '' %>>Nintendo Switch</option>
                        <option value="PC" <%= form.platform === 'PC' ? 'selected' : '' %>>PC</option>
                      </select>
                      <div class="invalid-feedback">Please select a platform.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                      <label for="genre" class="form-label">Genre <span class="text-danger">*</span></label>
                      <select class="form-select" id="genre" name="genre">
                        <option value="">Select genre...</option>
                        <option value="Action" <%= form.genre === 'Action' ? 'selected' : '' %>>Action</option>
                        <option value="Adventure" <%= form.genre === 'Adventure' ? 'selected' : '' %>>Adventure</option>
                        <option value="RPG" <%= form.genre === 'RPG' ? 'selected' : '' %>>RPG</option>
                        <option value="Sports" <%= form.genre === 'Sports' ? 'selected' : '' %>>Sports</option>
                        <option value="Racing" <%= form.genre === 'Racing' ? 'selected' : '' %>>Racing</option>
                        <option value="Fighting" <%= form.genre === 'Fighting' ? 'selected' : '' %>>Fighting</option>
                        <option value="Strategy" <%= form.genre === 'Strategy' ? 'selected' : '' %>>Strategy</option>
                        <option value="Simulation" <%= form.genre === 'Simulation' ? 'selected' : '' %>>Simulation</option>
                      </select>
                      <div class="invalid-feedback">Please select a genre.</div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-4 mb-3">
                      <label for="esrbRating" class="form-label">ESRB Rating</label>
                      <select class="form-select" id="esrbRating" name="esrbRating">
                        <option value="">Select rating...</option>
                        <option value="E" <%= form.esrbRating === 'E' ? 'selected' : '' %>>E (Everyone)</option>
                        <option value="E10+" <%= form.esrbRating === 'E10+' ? 'selected' : '' %>>E10+ (Everyone 10+)</option>
                        <option value="T" <%= form.esrbRating === 'T' ? 'selected' : '' %>>T (Teen)</option>
                        <option value="M" <%= form.esrbRating === 'M' ? 'selected' : '' %>>M (Mature)</option>
                      </select>
                    </div>
                    <div class="col-md-4 mb-3">
                      <label for="publisher" class="form-label">Publisher</label>
                      <input type="text" class="form-control" id="publisher" name="publisher" placeholder="e.g., Sony" value="<%= form.publisher || '' %>" />
                    </div>
                    <div class="col-md-4 mb-3">
                      <label for="releaseYear" class="form-label">Release Year</label>
                      <input type="number" class="form-control" id="releaseYear" name="releaseYear" min="1970" max="2030" placeholder="2024" value="<%= form.releaseYear || '' %>" />
                    </div>
                  </div>
                </div>

                <div id="consoleFields" class="category-fields" style="display: <%= form.category === 'Console' ? 'block' : 'none' %>">
                  <h3 class="h5 mb-3">Console Specifics</h3>
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label for="consoleType" class="form-label">Console Type <span class="text-danger">*</span></label>
                      <select class="form-select" id="consoleType" name="consoleType">
                        <option value="">Select console...</option>
                        <option value="PlayStation 5" <%= form.consoleType === 'PlayStation 5' ? 'selected' : '' %>>PlayStation 5</option>
                        <option value="PlayStation 4" <%= form.consoleType === 'PlayStation 4' ? 'selected' : '' %>>PlayStation 4</option>
                        <option value="Xbox Series X/S" <%= form.consoleType === 'Xbox Series X/S' ? 'selected' : '' %>>Xbox Series X/S</option>
                        <option value="Xbox One" <%= form.consoleType === 'Xbox One' ? 'selected' : '' %>>Xbox One</option>
                        <option value="Nintendo Switch" <%= form.consoleType === 'Nintendo Switch' ? 'selected' : '' %>>Nintendo Switch</option>
                      </select>
                      <div class="invalid-feedback">Please select a console type.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                      <label for="storageCapacity" class="form-label">Storage Capacity</label>
                      <input type="text" class="form-control" id="storageCapacity" name="storageCapacity" placeholder="e.g., 1TB" value="<%= form.storageCapacity || '' %>" />
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6 mt-4">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="controllersIncluded" id="controllersIncluded" <%= form.controllersIncluded ? 'checked' : '' %>>
                        <label class="form-check-label" for="controllersIncluded">Controllers Included?</label>
                      </div>
                    </div>
                    <div class="col-md-6 mb-3">
                      <label for="controllerQuantity" class="form-label">Controller Quantity</label>
                      <input type="number" class="form-control" id="controllerQuantity" name="controllerQuantity" min="0" value="<%= form.controllerQuantity || '0' %>" />
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6 mt-4">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="cablesIncluded" id="cablesIncluded" <%= form.cablesIncluded ? 'checked' : '' %>>
                        <label class="form-check-label" for="cablesIncluded">Power/HDMI Cables Included?</label>
                      </div>
                    </div>
                    <div class="col-md-6 mb-3">
                      <label for="serialNumber" class="form-label">Serial Number (Private)</label>
                      <input type="text" class="form-control" id="serialNumber" name="serialNumber" placeholder="For hardware tracking" value="<%= form.serialNumber || '' %>" />
                    </div>
                  </div>
                </div>

                <div id="accessoryFields" class="category-fields" style="display: <%= form.category === 'Accessory' ? 'block' : 'none' %>">
                  <h3 class="h5 mb-3">Accessory Specifics</h3>
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label for="accessoryType" class="form-label">Accessory Type <span class="text-danger">*</span></label>
                      <select class="form-select" id="accessoryType" name="accessoryType">
                        <option value="">Select type...</option>
                        <option value="Controller" <%= form.accessoryType === 'Controller' ? 'selected' : '' %>>Controller</option>
                        <option value="Headset" <%= form.accessoryType === 'Headset' ? 'selected' : '' %>>Headset</option>
                        <option value="VR Equipment" <%= form.accessoryType === 'VR Equipment' ? 'selected' : '' %>>VR Equipment</option>
                        <option value="Racing Wheel" <%= form.accessoryType === 'Racing Wheel' ? 'selected' : '' %>>Racing Wheel</option>
                        <option value="Flight Stick" <%= form.accessoryType === 'Flight Stick' ? 'selected' : '' %>>Flight Stick</option>
                        <option value="Charging Station" <%= form.accessoryType === 'Charging Station' ? 'selected' : '' %>>Charging Station</option>
                        <option value="Other" <%= form.accessoryType === 'Other' ? 'selected' : '' %>>Other</option>
                      </select>
                      <div class="invalid-feedback">Please select an accessory type.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                      <label for="compatiblePlatforms" class="form-label">Compatible Platforms</label>
                      <input type="text" class="form-control" id="compatiblePlatforms" name="compatiblePlatforms" placeholder="e.g., PS5, PC" value="<%= form.compatiblePlatforms || '' %>" />
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-4 mt-4">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isWireless" id="isWireless" <%= form.isWireless ? 'checked' : '' %>>
                        <label class="form-check-label" for="isWireless">Is Wireless?</label>
                      </div>
                    </div>
                    <div class="col-md-4 mb-3">
                      <label for="brand" class="form-label">Brand</label>
                      <input type="text" class="form-control" id="brand" name="brand" placeholder="e.g., Logitech" value="<%= form.brand || '' %>" />
                    </div>
                    <div class="col-md-4 mb-3">
                      <label for="modelNumber" class="form-label">Model Number</label>
                      <input type="text" class="form-control" id="modelNumber" name="modelNumber" placeholder="e.g., G29" value="<%= form.modelNumber || '' %>" />
                    </div>
                  </div>
                </div>

                <div id="otherFields" class="category-fields" style="display: <%= form.category === 'Other' ? 'block' : 'none' %>">
                  <h3 class="h5 mb-3">Additional Categories</h3>
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label for="dynamicCategoryId" class="form-label">Select Specific Category <span class="text-danger">*</span></label>
                      <select class="form-select" id="dynamicCategoryId" name="dynamicCategoryId">
                        <option value="">Choose a category...</option>
                        <% if (typeof dynamicCategories !== 'undefined') { %>
                          <% dynamicCategories.forEach(cat => { %>
                            <option value="<%= cat.id %>" <%= form.dynamicCategoryId == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                          <% }) %>
                        <% } %>
                      </select>
                      <div class="invalid-feedback">Please select a specific category from the list.</div>
                      <div class="form-text">Don't see your item type? Request a new category from support.</div>
                    </div>
                  </div>
                </div>

                <hr class="border-secondary my-4" />

                <div class="mb-4">
                  <h3 class="h5 mb-3">Pricing</h3>
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label for="dailyRate" class="form-label">Daily Rental Rate <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" id="dailyRate" name="dailyRate" value="<%= form.dailyRate || '' %>" placeholder="15.00" step="0.01" min="1.00" max="500.00" required />
                        <div class="invalid-feedback">Please provide a valid daily rate.</div>
                      </div>
                      <div class="form-text">$1.00 - $500.00 per day</div>
                    </div>
                  </div>
                </div>

                <div class="d-flex gap-2 align-items-center mt-4">
                  <a href="/lender/dashboard" class="btn btn-alternate me-auto">Cancel</a>
                  <button type="submit" class="btn btn-main" id="continuePhotosBtn">
                    Continue to Photos <i class="bi bi-arrow-right ms-2"></i>
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="section-card mb-4">
              <h3 class="h5 mb-3"><i class="bi bi-lightbulb me-2"></i>Listing Tips</h3>
              <ul class="list-unstyled">
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Use a clear, descriptive title</li>
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Be honest about item condition</li>
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Set competitive daily rates</li>
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Include detailed descriptions</li>
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Upload high-quality photos (next step)</li>
              </ul>
            </div>
            
            <div class="section-card">
              <h3 class="h5 mb-3"><i class="bi bi-info-circle me-2"></i>What Happens Next?</h3>
              <ol class="ps-3 mb-0 text-muted">
                <li class="mb-2">Submit your listing details</li>
                <li class="mb-2">Upload photos of your item</li>
                <li class="mb-0">Listing goes live and starts earning!</li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li><a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/create-listing.js"></script>
  </body>
</html>
