<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';
    
  const imageCount = listing.images ? listing.images.length : 0;
  const isLastImage = imageCount <= 1;

  // Enforce frontend sorting by createdAt to respect our new drag-and-drop ordering logic
  if (listing.images && listing.images.length > 0) {
    listing.images.sort((a, b) => {
      if (a.isPrimary && !b.isPrimary) return -1;
      if (!a.isPrimary && b.isPrimary) return 1;
      return new Date(a.createdAt) - new Date(b.createdAt);
    });
    listing.images[0].isPrimary = true; // First image is always safely treated as primary
  }
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload Images - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    
    <style>
      .upload-zone {
        border: 2px dashed var(--color-gray-hover);
        border-radius: 10px;
        padding: 3rem 1rem;
        text-align: center;
        background-color: rgba(0, 0, 0, 0.2);
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .upload-zone:hover, .upload-zone.drag-over {
        border-color: var(--color-orange);
        background-color: rgba(255, 107, 0, 0.1);
      }
      .upload-zone i {
        font-size: 3rem;
        color: var(--color-orange);
        margin-bottom: 1rem;
      }
      .image-item {
        position: relative;
        margin-bottom: 1rem;
        transition: transform 0.2s ease;
      }
      .image-preview {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        aspect-ratio: 1;
        background-color: var(--color-black);
      }
      .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      
      /* Drag Handle Styling */
      .drag-handle {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        background-color: rgba(0, 0, 0, 0.6);
        color: white;
        border-radius: 6px;
        cursor: grab;
        z-index: 5;
        transition: background-color 0.2s;
      }
      .drag-handle:hover {
        background-color: var(--color-orange);
      }
      .drag-handle:active {
        cursor: grabbing;
      }
      .sortable-ghost {
        opacity: 0.4;
        border: 2px dashed var(--color-orange) !important;
      }

      .primary-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background-color: var(--color-orange);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: bold;
        z-index: 5;
      }
      
      .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        opacity: 0;
        transition: opacity 0.2s ease;
        z-index: 4;
      }
      .image-preview:hover .image-overlay {
        opacity: 1;
      }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    
    <div id="dynamicAlertsContainer" class="position-fixed top-0 end-0 p-4 mt-5" style="z-index: 1050; width: 100%; max-width: 450px;"></div>

    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        <div class="lender-header mb-4">
          <a href="/lender/listings/<%= listing.id %>" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Listing
          </a>
          <h1>Manage Images</h1>
          <p><%= listing.title %></p>
        </div>

        <div class="row">
          <div class="col-lg-8">
            
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger d-flex align-items-center shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                <div><%= error %></div>
              </div>
            <% } %>

            <div class="section-card">
              <h2 class="h5 mb-3">Upload New Images</h2>

              <form action="/lender/listings/<%= listing.id %>/images" method="POST" enctype="multipart/form-data" id="uploadForm" data-current-count="<%= imageCount %>">
                
                <div class="upload-zone" id="uploadZone">
                  <i class="bi bi-cloud-arrow-up"></i>
                  <h3 class="h5">Drag & Drop Images Here</h3>
                  <p class="text-muted mb-3">or</p>
                  <button type="button" class="btn btn-main" id="selectFilesBtn">
                    <i class="bi bi-folder2-open me-2"></i>Choose Files
                  </button>
                  
                  <input type="file" id="fileInput" name="listingImages" accept="image/jpeg,image/png,image/webp" multiple style="display: none" />
                  
                  <p class="text-muted mt-3 mb-0">
                    <small>Accepted formats: JPG, PNG, WEBP • Max 10MB per file • Up to 8 images total</small>
                  </p>
                </div>

                <div class="mt-4">
                  <label for="imageUrl" class="form-label text-muted">Or Add Image via URL</label>
                  <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-link-45deg"></i></span>
                    <input type="url" class="form-control bg-dark text-white border-secondary" id="imageUrl" placeholder="https://example.com/image.jpg">
                    <button class="btn btn-alternate border-secondary" type="button" id="addUrlBtn">Add URL</button>
                  </div>
                  <div class="form-text">You can add multiple URLs to your upload queue by clicking 'Add URL'.</div>
                </div>

                <div id="uploadActionDiv" class="mt-4 p-3 bg-dark border border-secondary rounded d-none">
                  <div class="text-center mb-3">
                    <p id="selectedFilesText" class="text-info fw-bold mb-2"></p>
                  </div>
                  
                  <div id="previewGallery" class="d-flex flex-wrap gap-3 justify-content-center mb-3"></div>

                  <div class="text-center">
                    <button type="submit" class="btn btn-main btn-lg">
                      <i class="bi bi-upload me-2"></i>Upload Selected Images
                    </button>
                  </div>
                </div>
              </form>
            </div>

            <div class="section-card">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">
                  <i class="bi bi-images me-2"></i>Current Images
                  <span class="badge bg-secondary ms-2" id="imageCount"><%= imageCount %> of 8</span>
                </h2>
                <% if (imageCount > 1) { %>
                  <span class="text-muted small"><i class="bi bi-grip-horizontal me-1"></i>Drag to reorder</span>
                <% } %>
              </div>

              <div class="row g-3" id="imageGallery" data-listing-id="<%= listing.id %>">
                <% if (listing.images && listing.images.length > 0) { %>
                  <% listing.images.forEach(function(image, index) { %>
                    
                    <div class="col-md-4 image-item" data-id="<%= image.id %>">
                      <div class="image-preview shadow-sm border border-secondary">
                        
                        <div class="drag-handle d-flex justify-content-center align-items-center" title="Drag to reorder">
                          <i class="bi bi-arrows-move"></i>
                        </div>

                        <div class="primary-badge <%= index === 0 ? '' : 'd-none' %>"><i class="bi bi-star-fill me-1"></i>Primary</div>
                        
                        <img src="<%= image.imageUrl %>" alt="Listing Image" />
                        
                        <div class="image-overlay flex-column px-3">
                          
                          <button type="button" class="btn btn-success btn-sm w-100 mb-2 btn-make-primary <%= index === 0 ? 'd-none' : '' %>" title="Set as Primary">
                            <i class="bi bi-star-fill me-1"></i> Make Primary
                          </button>

                          <form action="/lender/images/<%= image.id %>?_method=DELETE" method="POST" class="m-0 w-100 delete-image-form">
                            <button type="submit" class="btn btn-danger btn-sm w-100" title="<%= isLastImage ? 'Cannot delete the last image' : 'Delete Image' %>" <%= isLastImage ? 'disabled' : '' %>>
                              <i class="bi bi-trash me-1"></i> Delete
                            </button>
                          </form>
                        </div>
                      </div>
                    </div>

                  <% }); %>
                <% } else { %>
                  <div class="col-12">
                    <div class="alert alert-dark text-center text-muted border-secondary">
                      No images uploaded yet. You must upload at least one image to activate this listing.
                    </div>
                  </div>
                <% } %>
              </div>

              <div class="mt-4 d-flex justify-content-end gap-2 border-top border-secondary pt-3">
                <a href="/lender/listings/<%= listing.id %>" class="btn btn-main">
                  <i class="bi bi-check-circle me-2"></i>Finish & Return to Listing
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="section-card">
              <h3 class="h5 mb-3"><i class="bi bi-info-circle me-2"></i>Image Management</h3>
              <p class="text-muted mb-2">
                <strong>Primary Image:</strong> The first image (top-left) is automatically your primary image. 
                <span class="text-info">You can click and drag the images around to change their order!</span>
              </p>
              <p class="text-muted mb-0">
                <strong>Deleting:</strong> A listing must have at least one image. You cannot delete an image if it is the only one remaining.
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>

    <div class="modal fade" id="deleteImageModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white" id="deleteImageModalLabel">
              <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirm Deletion
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light">
            Are you sure you want to delete this image?
            <br><br>
            <small class="text-muted">This action cannot be undone. If you delete your primary image, the next image will automatically take its place.</small>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmImageDeleteBtn">
              <i class="bi bi-trash me-2"></i>Delete Image
            </button>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li><a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="/js/upload-images.js"></script> 
  </body>
</html>
