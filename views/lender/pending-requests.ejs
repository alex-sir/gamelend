<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';

  // Helper to format dates cleanly
  function formatDateSafe(dateInput) {
    if (!dateInput) return 'N/A';
    const d = new Date(dateInput);
    return d.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
  }

  function getPrimaryImage(listing) {
    if (!listing || !listing.images || listing.images.length === 0) return '/images/gaming-collage.svg';
    const primary = listing.images.find(img => img.isPrimary);
    return primary ? primary.imageUrl : listing.images[0].imageUrl;
  }
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pending Requests - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    
    <style>
      .request-card {
        background-color: var(--color-gray);
        border: 1px solid var(--color-gray-hover);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .request-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
      }
      .request-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--color-gray-hover);
        background-color: var(--color-black);
      }
      .detail-box {
        background-color: rgba(0,0,0,0.2);
        border-radius: 8px;
        padding: 1rem;
        border: 1px solid var(--color-gray-hover);
      }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="lender-header mb-4">
          <a href="/lender/dashboard" class="btn btn-alternate mb-3 rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
          </a>
          <div class="d-flex justify-content-between align-items-end">
            <div>
              <h1>Pending Requests</h1>
              <p class="text-muted mb-0">Review and respond to new rental requests from borrowers.</p>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            
            <% if (typeof requests !== 'undefined' && requests.length > 0) { %>
              
              <div class="alert alert-info border-info bg-dark text-light mb-4 shadow-sm">
                <i class="bi bi-info-circle-fill text-info me-2"></i>
                You have <strong><%= requests.length %></strong> pending request(s) awaiting your approval.
              </div>

              <% requests.forEach(function(req) { %>
                <% 
                  const start = new Date(req.startDate);
                  const end = new Date(req.endDate);
                  const totalDays = Math.max(1, Math.round((end - start) / (1000 * 60 * 60 * 24)));
                  const estTotal = parseFloat(req.listing.dailyRate) * totalDays;
                  const borrowerName = req.borrower.firstName || req.borrower.email.split('@')[0];
                %>
                
                <div class="request-card shadow-sm">
                  <div class="row align-items-center">
                    
                    <div class="col-md-5 mb-3 mb-md-0">
                      <div class="d-flex align-items-center">
                        <img src="<%= getPrimaryImage(req.listing) %>" class="request-img me-3 shadow-sm" alt="Listing">
                        <div>
                          <a href="/lender/listings/<%= req.listing.id %>" class="text-decoration-none text-light">
                            <h5 class="mb-1 text-truncate" style="max-width: 250px;"><%= req.listing.title %></h5>
                          </a>
                          <span class="badge bg-dark border border-secondary text-light fw-normal"><i class="bi bi-tag me-1"></i><%= req.listing.category %></span>
                        </div>
                      </div>
                    </div>

                    <div class="col-md-5 mb-3 mb-md-0">
                      <div class="detail-box">
                        <div class="row g-2">
                          <div class="col-12 border-bottom border-secondary pb-2 mb-2">
                            <span class="small text-muted d-block text-uppercase fw-bold">Borrower</span>
                            <div class="d-flex justify-content-between align-items-center">
                              <span class="fw-medium text-light"><i class="bi bi-person-circle me-2 text-info"></i><%= borrowerName %></span>
                              <button class="btn btn-sm btn-outline-info rounded-pill px-3 py-0 btn-contact-borrower" data-borrower-name="<%= borrowerName %>">Message</button>
                            </div>
                          </div>
                          <div class="col-6">
                            <span class="small text-muted d-block text-uppercase fw-bold">Dates (<%= totalDays %> Days)</span>
                            <span class="fw-medium text-light"><%= formatDateSafe(req.startDate) %> - <%= formatDateSafe(req.endDate) %></span>
                          </div>
                          <div class="col-6">
                            <span class="small text-muted d-block text-uppercase fw-bold">Est. Earnings</span>
                            <span class="fw-bold text-success fs-5">$<%= estTotal.toFixed(2) %></span>
                            <span class="small text-muted d-block" style="font-size: 0.7rem;">($<%= parseFloat(req.listing.dailyRate).toFixed(2) %>/day)</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="col-md-2 text-md-end mt-3 mt-md-0 d-flex flex-md-column gap-2 justify-content-end">
                      
                      <button type="button" class="btn btn-success fw-bold rounded-pill shadow-sm btn-accept-request w-100" 
                        data-request-id="<%= req.id %>" 
                        data-listing-title="<%= req.listing.title %>"
                        data-borrower-name="<%= borrowerName %>"
                        data-dates="<%= formatDateSafe(req.startDate) %> to <%= formatDateSafe(req.endDate) %>"
                        data-earnings="<%= estTotal.toFixed(2) %>">
                        <i class="bi bi-check-circle me-1"></i> Accept
                      </button>

                      <button type="button" class="btn btn-danger fw-bold rounded-pill shadow-sm btn-reject-request w-100" 
                        data-request-id="<%= req.id %>" 
                        data-listing-title="<%= req.listing.title %>"
                        data-borrower-name="<%= borrowerName %>">
                        <i class="bi bi-x-circle me-1"></i> Reject
                      </button>

                    </div>

                  </div>
                </div>
              <% }); %>

            <% } else { %>
              
              <div class="text-center py-5 bg-dark rounded-4 border border-secondary shadow-sm">
                <i class="bi bi-inbox display-1 text-muted mb-3 d-block"></i>
                <h3 class="text-light">You're all caught up!</h3>
                <p class="text-muted mb-4">There are currently no new rental requests for your items.</p>
                <a href="/lender/dashboard" class="btn btn-main rounded-pill px-4">Return to Dashboard</a>
              </div>

            <% } %>

          </div>
        </div>
      </div>
    </main>

    <div class="modal fade" id="acceptModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-success shadow-lg rounded-4">
          <div class="modal-header border-secondary p-4 pb-3">
            <h5 class="modal-title text-white fw-bold">
              <i class="bi bi-check-circle-fill text-success me-2"></i>Accept Rental Request
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light p-4 pt-2">
            <p>You are about to accept a rental request from <strong id="acceptBorrowerName" class="text-info"></strong> for <strong id="acceptListingTitle" class="text-white"></strong>.</p>
            
            <div class="bg-black p-3 rounded-3 border border-secondary mb-3 shadow-sm">
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Rental Period:</span>
                <strong id="acceptDates" class="text-light"></strong>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Expected Earnings:</span>
                <strong id="acceptEarnings" class="text-success fs-5"></strong>
              </div>
            </div>

            <p class="small text-muted mb-0"><i class="bi bi-info-circle me-1"></i>By accepting, this item will be marked as "Active" and blocked from other requests for these dates.</p>
          </div>
          <div class="modal-footer border-secondary p-3">
            <button type="button" class="btn btn-alternate rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <form id="acceptRequestForm" method="POST" class="m-0">
              <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-check-circle me-1"></i> Confirm Acceptance
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger shadow-lg rounded-4">
          <div class="modal-header border-secondary p-4 pb-3">
            <h5 class="modal-title text-white fw-bold">
              <i class="bi bi-x-circle-fill text-danger me-2"></i>Decline Rental Request
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light p-4 pt-2">
            <p>You are declining the request from <strong id="rejectBorrowerName" class="text-info"></strong> for <strong id="rejectListingTitle" class="text-white"></strong>.</p>
            
            <form id="rejectRequestForm" method="POST">
              <div class="mb-3">
                <label for="rejectReason" class="form-label text-muted small text-uppercase fw-bold">Reason for declining (Optional)</label>
                <textarea class="form-control bg-black text-white border-secondary" id="rejectReason" name="reason" rows="3" placeholder="Let the borrower know why (e.g., item unavailable, scheduling conflict)..."></textarea>
              </div>
            </form>
            <p class="small text-muted mb-0"><i class="bi bi-exclamation-circle me-1"></i>This action cannot be undone. The borrower will be notified.</p>
          </div>
          <div class="modal-footer border-secondary p-3">
            <button type="button" class="btn btn-alternate rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" form="rejectRequestForm" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
              <i class="bi bi-x-circle me-1"></i> Confirm Decline
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="contactModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg rounded-4">
          <div class="modal-header border-secondary p-4">
            <h5 class="modal-title text-white fw-bold"><i class="bi bi-envelope text-info me-2"></i>Contact Borrower</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light p-4">
            <p>Send a message to <strong id="contactBorrowerName" class="text-info"></strong> regarding their request.</p>
            <textarea class="form-control bg-black text-white border-secondary mt-3 p-3 rounded-3" rows="4" placeholder="Type your message here..."></textarea>
          </div>
          <div class="modal-footer border-secondary p-3">
            <button type="button" class="btn btn-alternate rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-main rounded-pill px-4" data-bs-dismiss="modal" onclick="alert('Message feature in development!');">Send Message</button>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/pending-requests.js"></script>
  </body>
</html>
