<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pending Requests - GameLend</title>

    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    
    <style>
      .request-card {
        background-color: var(--color-gray);
        border: 1px solid var(--color-gray-hover);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .request-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
      }
      .request-img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 8px;
        background-color: var(--color-black);
      }
      .request-dates {
        background-color: var(--color-black);
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid var(--color-orange);
      }
      .payout-highlight {
        color: var(--color-orange);
        font-size: 1.5rem;
        font-weight: 700;
      }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="lender-header mb-4">
          <a href="/lender/dashboard" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
          </a>
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h1>Pending Requests</h1>
              <p>Review and manage borrow requests for your listings</p>
            </div>
            <span class="badge bg-primary fs-5 px-3 py-2">
              <%= typeof requests !== 'undefined' ? requests.length : 0 %> Pending
            </span>
          </div>
        </div>

        <div class="row">
          <div class="col-lg-9 mx-auto">
            
            <% if (typeof requests !== 'undefined' && requests.length > 0) { %>
              <% requests.forEach(function(req) { %>
                <% 
                  // Calculate display variables
                  const startDate = new Date(req.startDate);
                  const endDate = new Date(req.endDate);
                  const reqDate = new Date(req.createdAt);
                  
                  const startStr = startDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                  const endStr = endDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                  const reqDateStr = reqDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
                  
                  const duration = Math.ceil((endDate - startDate) / (1000 * 60 * 60 * 24)) || 1;
                  const totalPayout = duration * req.listing.dailyRate;
                  
                  let imageUrl = '/images/gaming-collage.jpg';
                  if (req.listing.images && req.listing.images.length > 0) {
                    const primary = req.listing.images.find(img => img.isPrimary);
                    imageUrl = primary ? primary.imageUrl : req.listing.images[0].imageUrl;
                  }
                  
                  const borrowerName = req.borrower.firstName || req.borrower.email.split('@')[0];
                %>
                
                <div class="request-card">
                  <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-3">
                    <div class="text-muted small">
                      <i class="bi bi-clock me-1"></i>Requested on <%= reqDateStr %>
                    </div>
                    <div class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                      Action Required
                    </div>
                  </div>

                  <div class="row g-4">
                    <div class="col-md-3 text-center text-md-start">
                      <img src="<%= imageUrl %>" alt="<%= req.listing.title %>" class="request-img mb-3" />
                      <div>
                        <p class="text-muted mb-1 small">Requested by</p>
                        <p class="fw-bold mb-0"><i class="bi bi-person-circle me-2"></i><%= borrowerName %></p>
                        <button class="btn btn-link text-info p-0 text-decoration-none small mt-1 btn-contact-borrower" data-borrower-name="<%= borrowerName %>">
                          Message Borrower
                        </button>
                      </div>
                    </div>

                    <div class="col-md-5">
                      <h3 class="h5 mb-1"><a href="/lender/listings/<%= req.listing.id %>" class="text-white text-decoration-none hover-orange"><%= req.listing.title %></a></h3>
                      <p class="text-muted small mb-3"><i class="bi bi-tag me-1"></i><%= req.listing.category %></p>
                      
                      <div class="request-dates">
                        <div class="d-flex justify-content-between mb-2">
                          <span class="text-muted">Pick-up</span>
                          <strong><%= startStr %></strong>
                        </div>
                        <div class="d-flex justify-content-between">
                          <span class="text-muted">Return</span>
                          <strong><%= endStr %></strong>
                        </div>
                      </div>
                    </div>

                    <div class="col-md-4 d-flex flex-column justify-content-between">
                      <div class="bg-black p-3 rounded mb-3 text-center">
                        <p class="text-muted mb-1 small">Expected Payout (<%= duration %> days)</p>
                        <div class="payout-highlight">$<%= totalPayout.toFixed(2) %></div>
                      </div>
                      
                      <div class="d-grid gap-2">
                        <form action="/lender/requests/<%= req.id %>/accept" method="POST" class="m-0 accept-request-form">
                          <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle me-2"></i>Accept Request
                          </button>
                        </form>
                        
                        <button type="button" class="btn btn-outline-danger w-100 btn-reject-request" 
                          data-request-id="<%= req.id %>" 
                          data-listing-title="<%= req.listing.title %>"
                          data-borrower-name="<%= borrowerName %>">
                          <i class="bi bi-x-circle me-2"></i>Decline
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="section-card text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                <h2 class="h4 mt-3">All Caught Up!</h2>
                <p class="text-muted">You don't have any pending requests to review right now.</p>
                <a href="/lender/dashboard" class="btn btn-alternate mt-3">Return to Dashboard</a>
              </div>
            <% } %>
            
          </div>
        </div>
      </div>
    </main>

    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white"><i class="bi bi-x-circle text-danger me-2"></i>Decline Request</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form id="rejectRequestForm" method="POST">
            <div class="modal-body text-light">
              <p>You are about to decline <strong id="rejectBorrowerName" class="text-info">the borrower</strong>'s request for <strong id="rejectListingTitle" class="text-orange">your listing</strong>.</p>
              
              <div class="mb-3">
                <label for="rejectionReason" class="form-label text-muted">Reason for declining (Optional but recommended)</label>
                <textarea class="form-control bg-black text-white border-secondary" id="rejectionReason" name="rejectionReason" rows="3" placeholder="e.g., The item is currently unavailable..."></textarea>
              </div>
              <small class="text-muted"><i class="bi bi-info-circle me-1"></i> This message will be sent to the borrower.</small>
            </div>
            <div class="modal-footer border-secondary">
              <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger">
                <i class="bi bi-x-circle me-2"></i>Confirm Decline
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="modal fade" id="contactModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white"><i class="bi bi-chat-dots text-info me-2"></i>Message <span id="contactBorrowerName">Borrower</span></h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body text-light">
            <p>Send a message directly to the borrower before making a decision.</p>
            <textarea class="form-control bg-black text-white border-secondary" rows="4" placeholder="Type your message here..."></textarea>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-main" data-bs-dismiss="modal" onclick="alert('Message feature in development!');">Send Message</button>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/pending-requests.js"></script>
  </body>
</html>
