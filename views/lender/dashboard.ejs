<% 
  // Pull the actual user's first name from the active session
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lender Dashboard - GameLend</title>

    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    <style>
      .activity-icon-container {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .btn-action { width: 100%; margin-bottom: 0.5rem; }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="lender-header mb-4">
          <h1>Welcome back, <%= userName %>!</h1>
          <p>Manage your lending activity and track your earnings</p>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-3 col-6">
            <div class="stats-card">
              <div class="stat-value"><%= dashboardStats.activeListings %></div>
              <div class="stat-label">Active Listings</div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="stats-card">
              <div class="stat-value"><%= dashboardStats.pendingRequests %></div>
              <div class="stat-label">Pending Requests</div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="stats-card">
              <div class="stat-value"><%= dashboardStats.activeRentals %></div>
              <div class="stat-label">Active Rentals</div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="stats-card">
              <div class="stat-value"><%= dashboardStats.thisMonthEarnings %></div>
              <div class="stat-label">Total Earnings</div>
            </div>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-12 d-flex gap-3 flex-wrap">
            <a href="/lender/listings" class="btn btn-main btn-lg flex-grow-1 flex-md-grow-0">
              <i class="bi bi-list-ul me-2"></i>My Listings
            </a>
            <a href="/lender/listings/new" class="btn btn-main btn-lg flex-grow-1 flex-md-grow-0">
              <i class="bi bi-plus-circle me-2"></i>Create New Listing
            </a>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-lg-8">
            
            <div class="section-card mb-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2><i class="bi bi-inbox me-2"></i>Pending Requests</h2>
                <a href="/lender/requests" class="text-decoration-none view-all">View All <i class="bi bi-arrow-right"></i></a>
              </div>

              <% if (typeof pendingReqs !== 'undefined' && pendingReqs.length > 0) { %>
                <% pendingReqs.forEach(function(req) { %>
                  <div class="request-item bg-dark p-3 rounded border border-secondary mb-3">
                    <div class="row align-items-center">
                      <div class="col-md-8">
                        <div class="d-flex align-items-center">
                          <img src="<%= req.image %>" alt="<%= req.title %>" class="rounded me-3" style="width: 80px; height: 80px; object-fit: cover;" />
                          <div>
                            <h4 class="h5 mb-1"><%= req.title %></h4>
                            <div class="text-muted small mb-1">
                              <i class="bi bi-person me-1"></i><%= req.borrower %> 
                              <span class="mx-2">|</span> 
                              <i class="bi bi-calendar me-1"></i><%= req.dates %>
                            </div>
                            <div class="text-orange fw-bold"><%= req.price %> <span class="text-muted fw-normal">/ day</span></div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4 mt-3 mt-md-0">
                        <div class="d-flex flex-column gap-2">
                          <form action="/lender/requests/<%= req.id %>/accept" method="POST" class="m-0">
                            <button type="submit" class="btn btn-success btn-sm w-100"><i class="bi bi-check-circle me-1"></i>Accept</button>
                          </form>
                          <form action="/lender/requests/<%= req.id %>/reject" method="POST" class="m-0">
                            <button type="submit" class="btn btn-danger btn-sm w-100"><i class="bi bi-x-circle me-1"></i>Reject</button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="p-4 text-center border border-secondary rounded text-muted">
                  <p class="mb-0">No pending requests right now.</p>
                </div>
              <% } %>
            </div>

            <div class="section-card">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2><i class="bi bi-clock-history me-2"></i>Active Rentals</h2>
                <a href="/lender/history" class="text-decoration-none view-all">View All <i class="bi bi-arrow-right"></i></a>
              </div>

              <% if (typeof activeRents !== 'undefined' && activeRents.length > 0) { %>
                <% activeRents.forEach(function(rent) { %>
                  <div class="listing-item d-flex align-items-center p-3 border border-secondary rounded mb-2 bg-dark">
                    <img src="<%= rent.image %>" alt="<%= rent.title %>" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                    <div class="flex-grow-1">
                      <div class="fw-bold"><%= rent.title %></div>
                      <div class="text-muted small">
                        <i class="bi bi-person me-1"></i><%= rent.borrower %> &bull; Return by: <span class="text-light"><%= rent.returnDate %></span>
                      </div>
                    </div>
                    <div class="text-end ms-3">
                      <span class="badge bg-success bg-opacity-25 text-success border border-success px-2 py-1"><%= rent.status %></span>
                      <a href="/lender/history" class="btn btn-alternate btn-sm d-block mt-2">Manage</a>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="p-4 text-center border border-secondary rounded text-muted">
                  <p class="mb-0">No active rentals.</p>
                </div>
              <% } %>
            </div>

          </div>

          <div class="col-lg-4">
            <div class="section-card h-100">
              <h2 class="h5 mb-4"><i class="bi bi-activity me-2"></i>Recent Activity</h2>
              <div class="list-group list-group-flush border border-secondary rounded bg-dark overflow-hidden">
                
                <% if (typeof recentActivity !== 'undefined' && recentActivity && recentActivity.length > 0) { %>
                  <% recentActivity.forEach(function(activity) { %>
                    <div class="list-group-item bg-transparent border-secondary p-3">
                      <div class="d-flex align-items-start">
                        <div class="activity-icon-container bg-<%= activity.type %> bg-opacity-25 me-3">
                          <i class="bi <%= activity.icon %> text-<%= activity.type %> fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                          <div class="fw-bold text-light mb-1"><%= activity.label %></div>
                          <div class="text-muted small mb-2"><%= activity.text %></div>
                          <div class="text-secondary" style="font-size: 0.75rem;"><%= activity.time %></div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="list-group-item bg-transparent text-center p-5 text-muted border-0">
                    <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
                    No recent activity.
                  </div>
                <% } %>

              </div>
            </div>
          </div>
        </div>

      </div>
    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-github me-2"></i>GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPT_S 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
