<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) 
    ? currentUser.firstName 
    : 'Lender';
    
  const activeListings = [];
  const suspendedListings = [];
  const draftListings = [];
  
  if (typeof listings !== 'undefined' && listings.length > 0) {
    listings.forEach(listing => {
      if (listing.status === 'Active') activeListings.push(listing);
      else if (listing.status === 'Suspended') suspendedListings.push(listing);
      else if (listing.status === 'Draft') draftListings.push(listing);
    });
  }

  const currentSearch = (typeof searchQuery !== 'undefined') ? searchQuery : '';

  function getPrimaryImage(listing) {
    if (!listing.images || listing.images.length === 0) return '/images/gaming-collage.svg';
    const primary = listing.images.find(img => img.isPrimary);
    return primary ? primary.imageUrl : listing.images[0].imageUrl;
  }
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Listings - GameLend</title>

    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    <link rel="stylesheet" href="/css/lender/my-listings.css" />
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" value="<%= currentSearch %>" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="lender-header mb-4">
          <a href="/lender/dashboard" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
          </a>
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
              <h1>My Listings</h1>
              <p>Manage your inventory and availability</p>
            </div>
            <a href="/lender/listings/new" class="btn btn-main mt-3 mt-md-0">
              <i class="bi bi-plus-lg me-2"></i>Create New Listing
            </a>
          </div>
        </div>

        <div class="section-card">
          <ul class="nav nav-tabs border-secondary mb-4" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                Active <span class="badge bg-primary ms-2"><%= activeListings.length %></span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#draft" type="button" role="tab">
                Drafts <span class="badge bg-secondary ms-2"><%= draftListings.length %></span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#suspended" type="button" role="tab">
                Suspended <span class="badge bg-danger ms-2"><%= suspendedListings.length %></span>
              </button>
            </li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="active" role="tabpanel">
              <% if (activeListings.length === 0) { %>
                <div class="text-center py-5 bg-dark rounded border border-secondary">
                  <i class="bi bi-controller display-4 text-muted mb-3 d-block"></i>
                  <h4 class="text-light">No active listings</h4>
                  <p class="text-muted mb-4">You don't have any items currently available for rent.</p>
                  <% if (currentSearch) { %>
                    <a href="/lender/listings" class="btn btn-alternate">Clear Search</a>
                  <% } else { %>
                    <a href="/lender/listings/new" class="btn btn-main">Create Your First Listing</a>
                  <% } %>
                </div>
              <% } else { %>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                  <% activeListings.forEach(function(item) { %>
                    <div class="col">
                      <div class="card h-100 bg-dark border-secondary listing-card shadow-sm hover-lift">
                        <a href="/lender/listings/<%= item.id %>" class="text-decoration-none">
                          <div class="position-relative">
                            <span class="badge bg-success position-absolute top-0 start-0 m-2 shadow"><i class="bi bi-check-circle me-1"></i>Active</span>
                            <img src="<%= getPrimaryImage(item) %>" class="card-img-top object-fit-cover" alt="<%= item.title %>" style="height: 200px; border-bottom: 1px solid rgba(255,255,255,0.1);">
                          </div>
                        </a>
                        <div class="card-body d-flex flex-column p-4">
                          <div class="d-flex justify-content-between align-items-start mb-2">
                            <a href="/lender/listings/<%= item.id %>" class="text-decoration-none text-light pe-2" style="min-width: 0; flex: 1;">
                              <h5 class="card-title mb-0 text-truncate" title="<%= item.title %>"><%= item.title %></h5>
                            </a>
                            <span class="fs-5 fw-bold text-orange flex-shrink-0">$<%= parseFloat(item.dailyRate).toFixed(2) %></span>
                          </div>

                          <p class="card-text text-muted small mb-4">
                            <i class="bi bi-tag me-1"></i><%= item.category %> &middot; <%= item.condition %>
                          </p>
                          <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                            <a href="/lender/listings/<%= item.id %>" class="btn btn-sm btn-outline-light">Manage Details</a>
                            <div class="dropdown">
                              <button class="btn btn-sm btn-alternate px-2 py-1" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                              </button>
                              <ul class="dropdown-menu dropdown-menu-dark shadow">
                                <li><a class="dropdown-item" href="/lender/listings/<%= item.id %>/edit"><i class="bi bi-pencil me-2 text-info"></i>Edit</a></li>
                                <li><a class="dropdown-item" href="/lender/listings/<%= item.id %>/images"><i class="bi bi-image me-2 text-success"></i>Photos</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                  <form action="/lender/listings/<%= item.id %>?_method=DELETE" method="POST" class="m-0 delete-listing-form">
                                    <button type="submit" class="dropdown-item text-danger" data-listing-title="<%= item.title %>"><i class="bi bi-trash me-2"></i>Delete</button>
                                  </form>
                                </li>
                              </ul>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div class="tab-pane fade" id="draft" role="tabpanel">
              <% if (draftListings.length === 0) { %>
                <div class="text-center py-5 bg-dark rounded border border-secondary">
                  <i class="bi bi-pencil-square display-4 text-muted mb-3 d-block"></i>
                  <h4 class="text-light">No drafts</h4>
                  <p class="text-muted">You don't have any incomplete listings.</p>
                </div>
              <% } else { %>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                  <% draftListings.forEach(function(item) { %>
                    <div class="col">
                      <div class="card h-100 bg-dark border-secondary listing-card shadow-sm hover-lift">
                        <a href="/lender/listings/<%= item.id %>" class="text-decoration-none">
                          <div class="position-relative">
                            <span class="badge bg-secondary position-absolute top-0 start-0 m-2 shadow"><i class="bi bi-pencil me-1"></i>Draft</span>
                            <img src="<%= getPrimaryImage(item) %>" class="card-img-top object-fit-cover opacity-50" alt="<%= item.title %>" style="height: 200px; border-bottom: 1px solid rgba(255,255,255,0.1);">
                          </div>
                        </a>
                        <div class="card-body d-flex flex-column p-4">
                          <a href="/lender/listings/<%= item.id %>" class="text-decoration-none text-light pe-2" style="min-width: 0;">
                            <h5 class="card-title mb-2 text-truncate" title="<%= item.title %>"><%= item.title %></h5>
                          </a>
                          <p class="card-text text-muted small mb-4">
                            <i class="bi bi-tag me-1"></i><%= item.category %> &middot; <%= item.condition %>
                          </p>
                          <div class="mt-auto d-flex gap-2 pt-3 border-top border-secondary">
                            <a href="/lender/listings/<%= item.id %>" class="btn btn-sm btn-outline-light flex-fill">Review</a>
                            <form action="/lender/listings/<%= item.id %>/publish?_method=PUT" method="POST" class="m-0 flex-fill">
                              <button type="submit" class="btn btn-sm btn-success w-100">Publish</button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div class="tab-pane fade" id="suspended" role="tabpanel">
              <% if (suspendedListings.length === 0) { %>
                <div class="text-center py-5 bg-dark rounded border border-secondary">
                  <i class="bi bi-shield-check display-4 text-muted mb-3 d-block"></i>
                  <h4 class="text-light">All clear</h4>
                  <p class="text-muted">None of your listings are currently suspended by moderation.</p>
                </div>
              <% } else { %>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                  <% suspendedListings.forEach(function(item) { %>
                    <div class="col">
                      <div class="card h-100 bg-dark border-danger border-opacity-50 listing-card shadow-sm hover-lift">
                        <div class="position-relative">
                          <span class="badge bg-danger position-absolute top-0 start-0 m-2 shadow"><i class="bi bi-exclamation-triangle me-1"></i>Suspended</span>
                          <img src="<%= getPrimaryImage(item) %>" class="card-img-top object-fit-cover opacity-25" alt="<%= item.title %>" style="height: 200px; filter: grayscale(100%);">
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                          <h5 class="card-title text-light mb-2 text-truncate" title="<%= item.title %>"><%= item.title %></h5>
                          <p class="card-text text-muted small mb-4">
                            Please contact support to resolve the issue with this listing.
                          </p>
                          <div class="mt-auto pt-3 border-top border-secondary">
                            <button type="button" class="btn btn-sm btn-outline-danger w-100 btn-contact-support" data-listing-title="<%= item.title %>">
                              Contact Support
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

          </div>
        </div>

      </div>
    </main>

    <div class="modal fade" id="deleteListingModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
          <div class="modal-header border-secondary">
            <h5 class="modal-title text-white">
              <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirm Deletion
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light">
            Are you sure you want to delete <strong class="text-orange" id="deleteListingTitle">this listing</strong>?
            <br><br>
            <small class="text-muted">This action will permanently archive your listing and remove it from public search results. This cannot be undone.</small>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-alternate" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
              <i class="bi bi-trash me-2"></i>Delete Listing
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="supportModal" tabindex="-1" aria-hidden="true" data-bs-theme="dark">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg rounded-4">
          <div class="modal-header border-secondary p-4">
            <h5 class="modal-title text-white fw-bold">
              <i class="bi bi-headset text-info me-2"></i>Contact Support
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-light p-4">
            <p>Send a message to the moderation team regarding your suspended listing:<br><strong class="text-warning fs-5 mt-1 d-block" id="supportListingTitle"></strong></p>
            <div class="mb-2 mt-4">
              <label for="supportMessage" class="form-label text-muted small text-uppercase fw-bold">Message</label>
              <textarea class="form-control bg-black text-white border-secondary rounded-3 p-3" id="supportMessage" rows="4" placeholder="Explain the situation or request an appeal..."></textarea>
            </div>
          </div>
          <div class="modal-footer border-secondary p-3">
            <button type="button" class="btn btn-alternate rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-info rounded-pill px-4 fw-bold shadow-sm" data-bs-dismiss="modal" onclick="alert('Message sent to the GameLend Support Team!');">
              <i class="bi bi-send me-2"></i>Send Message
            </button>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // --- Delete Listing Modal Logic ---
        const deleteForms = document.querySelectorAll('.delete-listing-form');
        const deleteModalEl = document.getElementById('deleteListingModal');
        if (deleteModalEl) {
          const deleteModal = new bootstrap.Modal(deleteModalEl);
          const confirmBtn = document.getElementById('confirmDeleteBtn');
          const deleteListingTitle = document.getElementById("deleteListingTitle");
          let currentForm = null;

          deleteForms.forEach(form => {
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              currentForm = form;
              
              const submitBtn = form.querySelector('button[type="submit"]');
              const title = submitBtn ? submitBtn.getAttribute("data-listing-title") : "this listing";
              if (deleteListingTitle) {
                deleteListingTitle.textContent = title;
              }
              
              deleteModal.show();
            });
          });

          if (confirmBtn) {
            confirmBtn.addEventListener('click', () => {
              if (currentForm) {
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Deleting...';
                confirmBtn.disabled = true;
                currentForm.submit();
              }
            });
          }
        }

        // --- NEW: Contact Support Modal Logic ---
        const supportBtns = document.querySelectorAll('.btn-contact-support');
        const supportModalEl = document.getElementById('supportModal');
        if (supportModalEl) {
          const supportModal = new bootstrap.Modal(supportModalEl);
          const supportListingTitle = document.getElementById('supportListingTitle');
          const supportMessage = document.getElementById('supportMessage');

          supportBtns.forEach(btn => {
            btn.addEventListener('click', () => {
              if (supportListingTitle) {
                supportListingTitle.textContent = btn.getAttribute('data-listing-title');
              }
              if (supportMessage) {
                supportMessage.value = ''; // clear previous text
              }
              supportModal.show();
            });
          });
        }
      });
    </script>
  </body>
</html>
