<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) ? currentUser.firstName : 'Lender';
  
  let badgeClass = 'bg-success';
  let statusIcon = 'bi-check-circle';
  if (listing.status === 'Draft') { badgeClass = 'bg-secondary'; statusIcon = 'bi-pencil'; }
  if (listing.status === 'Suspended') { badgeClass = 'bg-danger'; statusIcon = 'bi-exclamation-triangle'; }
  if (listing.status === 'Deleted') { badgeClass = 'bg-danger'; statusIcon = 'bi-trash'; }

  if (listing && listing.images && listing.images.length > 0) {
    listing.images.sort((a, b) => {
      if (a.isPrimary && !b.isPrimary) return -1;
      if (!a.isPrimary && b.isPrimary) return 1;
      return 0;
    });
  }

  const isVG = listing.category === 'Video Game' && listing.videoGameDetails;
  const isCon = listing.category === 'Console' && listing.consoleDetails;
  const isAcc = listing.category === 'Accessory' && listing.accessoryDetails;
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= listing.title %> - GameLend</title>
    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    <style>
      .backdrop-blur {
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }
      .detail-box {
        transition: transform 0.2s ease;
      }
      .detail-box:hover {
        transform: translateY(-2px);
      }
      .action-btn-group .btn {
        transition: all 0.2s ease;
      }
      .action-btn-group .btn:hover {
        transform: translateX(4px);
      }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit"><i class="bi bi-search fs-5"></i></button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="lender-header mb-4">
          <a href="/lender/listings" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Inventory
          </a>
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
              <h1 class="mb-1"><%= listing.title %></h1>
            </div>
            
            <div class="mt-3 mt-md-0 d-flex align-items-center gap-3">
              <button id="toggleBorrowerViewBtn" class="btn btn-outline-info shadow-sm">
                <i class="bi bi-eye me-2"></i>View as Borrower
              </button>
              
              <span class="badge <%= badgeClass %> fs-6 px-3 py-2 shadow-sm rounded">
                <i class="bi <%= statusIcon %> me-2"></i><%= listing.status %>
              </span>
            </div>
          </div>
        </div>

        <div id="borrowerViewBanner" class="alert alert-info d-none mb-4 d-flex align-items-center shadow-sm">
          <i class="bi bi-info-circle-fill fs-4 me-3"></i>
          <div>
            <strong>Borrower Preview Mode Active</strong><br>
            This is exactly how your listing appears to the public. Lender-specific actions and internal earnings stats are hidden.
          </div>
        </div>

        <div class="row">
          <div class="col-lg-8">

            <div class="section-card mb-4 p-0 overflow-hidden bg-transparent border-0">
              <% if (listing.images && listing.images.length > 0) { %>
                <div class="position-relative shadow-sm rounded-4 overflow-hidden">
                  
                  <div class="position-absolute top-0 end-0 m-3 z-3">
                    <span class="badge bg-dark bg-opacity-75 border border-secondary rounded-pill px-3 py-2 fs-6 shadow-sm backdrop-blur">
                      <i class="bi bi-images me-2"></i><span id="imageCounter">1 / <%= listing.images.length %></span>
                    </span>
                  </div>

                  <div id="listingCarousel" class="carousel slide" data-bs-ride="carousel" data-total-images="<%= listing.images.length %>">
                    <div class="carousel-inner" style="background-color: var(--color-black); aspect-ratio: 16/9;">
                      <% listing.images.forEach(function(img, index) { %>
                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>" style="height: 100%;">
                          <img src="<%= img.imageUrl %>" class="d-block w-100 h-100" style="object-fit: contain;" alt="Listing Image <%= index + 1 %>">
                        </div>
                      <% }); %>
                    </div>
                    
                    <% if (listing.images.length > 1) { %>
                      <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                      </button>
                      <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                      </button>
                    <% } %>
                  </div>
                </div>
              <% } else { %>
                <div class="rounded-4 border border-secondary d-flex flex-column align-items-center justify-content-center" style="background-color: rgba(0,0,0,0.2); aspect-ratio: 16/9;">
                  <i class="bi bi-camera display-1 text-muted mb-3"></i>
                  <p class="text-muted">No images uploaded yet.</p>
                </div>
              <% } %>
            </div>

            <div class="section-card mb-4">
              <h3 class="h5 mb-4"><i class="bi bi-info-circle me-2 text-primary"></i>Core Details</h3>
              
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                    <label class="text-muted d-block small text-uppercase fw-bold mb-2">Category</label>
                    <div class="fs-5 d-flex align-items-center"><i class="bi bi-tag me-2 text-primary"></i><%= listing.category %></div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                    <label class="text-muted d-block small text-uppercase fw-bold mb-2">Condition</label>
                    <div class="fs-5 d-flex align-items-center"><i class="bi bi-star-fill text-warning me-2"></i><%= listing.condition %></div>
                  </div>
                </div>
              </div>

              <div class="p-4 bg-dark border border-secondary rounded-3 detail-box shadow-sm">
                <label class="text-muted d-block small text-uppercase fw-bold mb-3">Description</label>
                <p class="text-light mb-0" style="white-space: pre-wrap; line-height: 1.7; font-size: 1.05rem;"><%= listing.description %></p>
              </div>
            </div>

            <div class="section-card mb-4">
              <h3 class="h5 mb-4"><i class="bi bi-gear me-2 text-info"></i>Item Specifics</h3>
              <div class="row g-3">
                <% if (isVG) { %>
                  <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                      <label class="text-muted d-block small text-uppercase fw-bold mb-1">Platform</label>
                      <div class="fs-6 fw-semibold"><%= listing.videoGameDetails.platform %></div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                      <label class="text-muted d-block small text-uppercase fw-bold mb-1">Genre</label>
                      <div class="fs-6 fw-semibold"><%= listing.videoGameDetails.genre %></div>
                    </div>
                  </div>
                  <% if (listing.videoGameDetails.esrbRating) { %>
                    <div class="col-md-4">
                      <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                        <label class="text-muted d-block small text-uppercase fw-bold mb-1">ESRB Rating</label>
                        <div class="fs-6 fw-semibold"><%= listing.videoGameDetails.esrbRating %></div>
                      </div>
                    </div>
                  <% } %>
                  <% if (listing.videoGameDetails.publisher) { %>
                    <div class="col-md-4">
                      <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                        <label class="text-muted d-block small text-uppercase fw-bold mb-1">Publisher</label>
                        <div class="fs-6 fw-semibold"><%= listing.videoGameDetails.publisher %></div>
                      </div>
                    </div>
                  <% } %>
                  <% if (listing.videoGameDetails.releaseYear) { %>
                    <div class="col-md-4">
                      <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                        <label class="text-muted d-block small text-uppercase fw-bold mb-1">Release Year</label>
                        <div class="fs-6 fw-semibold"><%= listing.videoGameDetails.releaseYear %></div>
                      </div>
                    </div>
                  <% } %>
                <% } else if (isCon) { %>
                  <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                      <label class="text-muted d-block small text-uppercase fw-bold mb-1">Console Type</label>
                      <div class="fs-6 fw-semibold"><%= listing.consoleDetails.consoleType %></div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                      <label class="text-muted d-block small text-uppercase fw-bold mb-1">Controllers Included</label>
                      <div class="fs-6 fw-semibold"><%= listing.consoleDetails.controllersIncluded ? listing.consoleDetails.controllerQuantity : 'None' %></div>
                    </div>
                  </div>
                  <% if (listing.consoleDetails.storageCapacity) { %>
                    <div class="col-md-6">
                      <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                        <label class="text-muted d-block small text-uppercase fw-bold mb-1">Storage</label>
                        <div class="fs-6 fw-semibold"><%= listing.consoleDetails.storageCapacity %></div>
                      </div>
                    </div>
                  <% } %>
                  <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                      <label class="text-muted d-block small text-uppercase fw-bold mb-1">Cables Included</label>
                      <div class="fs-6 fw-semibold"><%= listing.consoleDetails.cablesIncluded ? 'Yes' : 'No' %></div>
                    </div>
                  </div>
                <% } else if (isAcc) { %>
                  <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                      <label class="text-muted d-block small text-uppercase fw-bold mb-1">Accessory Type</label>
                      <div class="fs-6 fw-semibold"><%= listing.accessoryDetails.accessoryType %></div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                      <label class="text-muted d-block small text-uppercase fw-bold mb-1">Connectivity</label>
                      <div class="fs-6 fw-semibold"><%= listing.accessoryDetails.isWireless ? 'Wireless' : 'Wired' %></div>
                    </div>
                  </div>
                  <% if (listing.accessoryDetails.compatiblePlatforms) { %>
                    <div class="col-md-6">
                      <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                        <label class="text-muted d-block small text-uppercase fw-bold mb-1">Compatibility</label>
                        <div class="fs-6 fw-semibold"><%= listing.accessoryDetails.compatiblePlatforms %></div>
                      </div>
                    </div>
                  <% } %>
                  <% if (listing.accessoryDetails.brand) { %>
                    <div class="col-md-6">
                      <div class="p-3 bg-dark border border-secondary rounded-3 h-100 detail-box shadow-sm">
                        <label class="text-muted d-block small text-uppercase fw-bold mb-1">Brand</label>
                        <div class="fs-6 fw-semibold"><%= listing.accessoryDetails.brand %></div>
                      </div>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </div>

          </div>

          <div class="col-lg-4">
            
            <div class="section-card mb-4 sticky-top" style="top: 100px;">
              <h3 class="h5 mb-4"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Pricing & Stats</h3>
              
              <div class="mb-4 text-center pb-4 border-bottom border-secondary">
                <span class="d-block text-muted text-uppercase fw-bold mb-2 small">Daily Rental Rate</span>
                <span class="display-5 fw-bold text-orange">$<%= parseFloat(listing.dailyRate).toFixed(2) %></span>
              </div>

              <div class="d-flex justify-content-between align-items-center p-3 bg-dark border border-secondary rounded-3 mb-3 shadow-sm">
                <span class="text-muted fw-semibold"><i class="bi bi-box-seam me-2"></i>Quantity Available:</span>
                <span class="fw-bold fs-5"><%= listing.quantity %></span>
              </div>
              
              <div class="lender-only-panel">
                <div class="d-flex justify-content-between align-items-center p-3 bg-dark border border-secondary rounded-3 mb-4 shadow-sm">
                  <span class="text-muted fw-semibold"><i class="bi bi-cash-stack me-2"></i>Total Earnings:</span>
                  <span class="fw-bold text-success fs-5">$<%= parseFloat(listing.totalEarnings || 0).toFixed(2) %></span>
                </div>
              </div>

              <hr class="border-secondary my-4 lender-only-panel" />

              <% if (listing.status === 'Active' || listing.status === 'Draft') { %>
                
                <div class="lender-only-panel">
                  <h3 class="h6 text-uppercase text-muted fw-bold mb-3">Lender Actions</h3>
                  <div class="d-grid gap-2 action-btn-group">
                    
                    <a href="/lender/listings/<%= listing.id %>/edit" class="btn btn-alternate text-start">
                      <i class="bi bi-pencil-square me-2 text-primary"></i>Edit Details
                    </a>
                    
                    <a href="/lender/listings/<%= listing.id %>/images" class="btn btn-alternate text-start">
                      <i class="bi bi-images me-2 text-success"></i>Manage Photos
                    </a>
                    
                    <button id="shareListingBtn" data-listing-id="<%= listing.id %>" class="btn btn-alternate text-start">
                      <i class="bi bi-share me-2 text-info"></i>Share Listing
                    </button>
                    
                    <% if (listing.status === 'Draft') { %>
                      <form action="/lender/listings/<%= listing.id %>/publish?_method=PUT" method="POST" class="m-0 mt-2">
                        <button type="submit" class="btn btn-main w-100 py-2 shadow-sm fw-bold">
                          <i class="bi bi-globe me-2"></i>Publish Listing
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>

                <div class="borrower-only-panel d-none">
                  <h3 class="h6 text-uppercase text-muted fw-bold mb-3">Borrower Actions</h3>
                  <button class="btn btn-main w-100 py-2 shadow-sm fw-bold mb-3" disabled>
                    <i class="bi bi-calendar-check me-2"></i>Request to Borrow
                  </button>
                </div>

              <% } else { %>
                <div class="alert alert-danger mb-0 rounded-3 shadow-sm">
                  <div class="d-flex align-items-center justify-content-center text-danger mb-2">
                    <i class="bi bi-shield-lock-fill fs-4 me-2"></i>
                    <strong>Listing Locked</strong>
                  </div>
                  <p class="small text-center mb-0">This listing cannot be edited because it is currently suspended or deleted by moderation.</p>
                </div>
              <% } %>
            </div>

          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li><a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/listing-detail.js"></script>
  </body>
</html>
