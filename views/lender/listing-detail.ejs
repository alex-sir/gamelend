<% 
  const userName = (typeof currentUser !== 'undefined' && currentUser && currentUser.firstName) ? currentUser.firstName : 'Lender';
  let badgeClass = 'badge-active';
  if (listing.status === 'Draft') badgeClass = 'badge-draft';
  if (listing.status === 'Suspended') badgeClass = 'badge-suspended';
  if (listing.status === 'Deleted') badgeClass = 'badge-suspended'; 

  if (listing && listing.images && listing.images.length > 0) {
    listing.images.sort((a, b) => {
      if (a.isPrimary && !b.isPrimary) return -1;
      if (!a.isPrimary && b.isPrimary) return 1;
      return 0;
    });
  }

  // Setup sub-type variables for easy reference
  const isVG = listing.category === 'Video Game' && listing.videoGameDetails;
  const isCon = listing.category === 'Console' && listing.consoleDetails;
  const isAcc = listing.category === 'Accessory' && listing.accessoryDetails;
%>

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= listing.title %> - GameLend</title>
    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/lender/lender.css" />
    <style>
      .badge-active { background-color: var(--color-success); color: white; }
      .badge-draft { background-color: var(--color-gray-hover); color: white; }
      .badge-suspended { background-color: var(--color-danger); color: white; }
      .image-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
        margin-top: 15px;
      }
      .gallery-img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 8px;
        cursor: pointer;
        transition: opacity 0.2s;
        border: 1px solid var(--color-gray-hover);
      }
      .gallery-img:hover { opacity: 0.8; }
      .main-image-container {
        width: 100%;
        height: 400px;
        border-radius: 12px;
        overflow: hidden;
        background-color: var(--color-black);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--color-gray-hover);
      }
      .main-image-container img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }
      .spec-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }
      .spec-item {
        background: rgba(255,255,255,0.02);
        padding: 10px 15px;
        border-radius: 8px;
        border-left: 3px solid var(--color-blue);
      }
    </style>
  </head>
  <body class="lender-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Lender</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/lender/listings" method="GET">
            <input class="form-control" type="search" name="q" placeholder="Search your listings..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit"><i class="bi bi-search fs-5"></i></button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Lender Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-speedometer2 me-1"></i>Dashboards
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li><a class="dropdown-item" href="/<%= currentUser.role %>/dashboard"><%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %> Dashboard</a></li>
                  <% } else { %>
                    <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= userName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/profile">Profile Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1 py-4">
      <div class="container">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <a href="/lender/listings" class="text-decoration-none text-muted mb-2 d-inline-block">
              <i class="bi bi-arrow-left me-1"></i>Back to My Listings
            </a>
            <h1 class="h2 mb-0 d-flex align-items-center gap-3">
              <%= listing.title %>
              <span class="badge <%= badgeClass %> fs-6 fw-normal px-3 py-2 rounded-pill"><%= listing.status %></span>
            </h1>
          </div>
        </div>

        <div class="row">
          <div class="col-lg-8">
            <div class="section-card mb-4">
              
              <% if (listing.images && listing.images.length > 0) { %>
                <div class="main-image-container mb-3 shadow-sm">
                  <img id="mainImage" src="<%= listing.images[0].imageUrl %>" alt="<%= listing.title %>">
                </div>
                
                <% if (listing.images.length > 1) { %>
                  <div class="image-gallery">
                    <% listing.images.forEach((img, index) => { %>
                      <img src="<%= img.imageUrl %>" 
                           class="gallery-img <%= index === 0 ? 'border-primary border-2' : '' %>" 
                           onclick="document.getElementById('mainImage').src=this.src; document.querySelectorAll('.gallery-img').forEach(i => i.classList.remove('border-primary', 'border-2')); this.classList.add('border-primary', 'border-2');"
                           alt="Thumbnail">
                    <% }) %>
                  </div>
                <% } %>
              <% } else { %>
                <div class="main-image-container mb-3">
                  <div class="text-center text-muted">
                    <i class="bi bi-image display-1 d-block mb-3"></i>
                    <p>No images uploaded yet.</p>
                  </div>
                </div>
              <% } %>

            </div>

            <div class="section-card mb-4">
              <h2 class="h4 mb-3">Description</h2>
              <p class="text-light" style="white-space: pre-wrap; line-height: 1.6;"><%= listing.description %></p>
            </div>

            <div class="section-card mb-4">
              <h2 class="h4 mb-3">Item Specifics</h2>
              
              <div class="spec-grid">
                <div class="spec-item">
                  <span class="text-muted d-block small text-uppercase fw-bold mb-1">Category</span>
                  <span class="fs-5"><i class="bi bi-tag me-2 text-primary"></i><%= listing.category %></span>
                </div>
                <div class="spec-item">
                  <span class="text-muted d-block small text-uppercase fw-bold mb-1">Condition</span>
                  <span class="fs-5"><i class="bi bi-star me-2 text-warning"></i><%= listing.condition %></span>
                </div>

                <% if (isVG) { %>
                  <div class="spec-item">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Platform</span>
                    <span class="fs-5"><%= listing.videoGameDetails.platform %></span>
                  </div>
                  <div class="spec-item">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Genre</span>
                    <span class="fs-5"><%= listing.videoGameDetails.genre %></span>
                  </div>
                  <% if (listing.videoGameDetails.esrbRating) { %>
                    <div class="spec-item">
                      <span class="text-muted d-block small text-uppercase fw-bold mb-1">ESRB Rating</span>
                      <span class="fs-5 fw-bold"><%= listing.videoGameDetails.esrbRating %></span>
                    </div>
                  <% } %>
                  <% if (listing.videoGameDetails.releaseYear) { %>
                    <div class="spec-item">
                      <span class="text-muted d-block small text-uppercase fw-bold mb-1">Release Year</span>
                      <span class="fs-5"><%= listing.videoGameDetails.releaseYear %></span>
                    </div>
                  <% } %>
                <% } else if (isCon) { %>
                  <div class="spec-item">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Console Type</span>
                    <span class="fs-5"><%= listing.consoleDetails.consoleType %></span>
                  </div>
                  <% if (listing.consoleDetails.storageCapacity) { %>
                    <div class="spec-item">
                      <span class="text-muted d-block small text-uppercase fw-bold mb-1">Storage</span>
                      <span class="fs-5"><%= listing.consoleDetails.storageCapacity %></span>
                    </div>
                  <% } %>
                  <div class="spec-item">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Controllers Included</span>
                    <span class="fs-5"><%= listing.consoleDetails.controllersIncluded ? listing.consoleDetails.controllerQuantity : 'None' %></span>
                  </div>
                  <div class="spec-item">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Cables Included</span>
                    <span class="fs-5"><%= listing.consoleDetails.cablesIncluded ? 'Yes' : 'No' %></span>
                  </div>
                <% } else if (isAcc) { %>
                  <div class="spec-item">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Accessory Type</span>
                    <span class="fs-5"><%= listing.accessoryDetails.accessoryType %></span>
                  </div>
                  <% if (listing.accessoryDetails.compatiblePlatforms) { %>
                    <div class="spec-item">
                      <span class="text-muted d-block small text-uppercase fw-bold mb-1">Compatibility</span>
                      <span class="fs-5"><%= listing.accessoryDetails.compatiblePlatforms %></span>
                    </div>
                  <% } %>
                  <div class="spec-item">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Connectivity</span>
                    <span class="fs-5"><%= listing.accessoryDetails.isWireless ? 'Wireless' : 'Wired' %></span>
                  </div>
                  <% if (listing.accessoryDetails.brand) { %>
                    <div class="spec-item">
                      <span class="text-muted d-block small text-uppercase fw-bold mb-1">Brand</span>
                      <span class="fs-5"><%= listing.accessoryDetails.brand %></span>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            
            <div class="section-card sticky-top" style="top: 100px;">
              <div class="text-center mb-4">
                <span class="d-block text-muted text-uppercase fw-bold mb-1">Daily Rate</span>
                <span class="display-5 fw-bold text-orange">$<%= parseFloat(listing.dailyRate).toFixed(2) %></span>
                <span class="text-muted">/ day</span>
              </div>

              <div class="d-flex justify-content-between mb-3 pb-3 border-bottom border-secondary">
                <span class="text-muted">Quantity Available:</span>
                <span class="fw-bold"><%= listing.quantity %></span>
              </div>
              
              <div class="d-flex justify-content-between mb-4">
                <span class="text-muted">Total Earnings:</span>
                <span class="fw-bold text-success">$0.00 <small class="text-muted fw-normal">(Demo)</small></span>
              </div>

              <% if (listing.status === 'Active' || listing.status === 'Draft') { %>
                <div>
                  <h3 class="h6 mb-2">Actions</h3>
                  <div class="d-grid gap-2">
                    <a href="/lender/listings/<%= listing.id %>/edit" class="btn btn-alternate">
                      <i class="bi bi-pencil-square me-2"></i>Edit Details
                    </a>
                    <a href="/lender/listings/<%= listing.id %>/images" class="btn btn-alternate">
                      <i class="bi bi-images me-2"></i>Manage Images
                    </a>
                    
                    <% if (listing.status === 'Draft') { %>
                      <form action="/lender/listings/<%= listing.id %>/publish?_method=PUT" method="POST" class="m-0 mt-2">
                        <button type="submit" class="btn btn-success w-100">
                          <i class="bi bi-globe me-2"></i>Publish Listing
                        </button>
                      </form>
                    <% } %>

                  </div>
                </div>
              <% } else { %>
                <div class="alert alert-danger mb-0">
                  <div class="d-flex align-items-center justify-content-center text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                    <strong>Listing Unavailable</strong>
                  </div>
                  <p class="small text-center mb-0">This listing cannot be edited because it is suspended or deleted.</p>
                </div>
              <% } %>
              
              <% if (listing.status === 'Draft') { %>
                <div class="mt-4 pt-3 border-top border-secondary text-center">
                  <div class="d-inline-flex align-items-center text-warning px-3 py-2 rounded" style="background: rgba(255,193,7,0.05); border: 1px solid rgba(255,255,255, 0.2);">
                    <i class="bi bi-eye-slash-fill me-1"></i> Draft (Hidden)
                  </div>
                </div>
              <% } %>

            </div>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="row justify-content-center mx-auto">
          <div class="col-md-3 mb-4">
            <h5>About</h5>
            <ul>
              <li><a href="/about">About GameLend</a></li>
              <li><a href="/about#team">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Support</h5>
            <ul>
              <li><a href="/about#faq">FAQ</a></li>
              <li><a href="/about#contact">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-4">
            <h5>Connect</h5>
            <ul>
              <li><a href="https://github.com/alex-sir/gamelend" target="_blank" rel="noopener noreferrer"><i class="bi bi-github me-2"></i>GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="copyright">
          <p>&copy; <%= new Date().getFullYear() %> GameLend. A WSU CPTS 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
