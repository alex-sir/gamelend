<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameLend · Moderate Listings</title>
    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin/admin.css" />
  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-controller me-2"></i>GameLend <span class="ms-1" style="font-size: 0.85rem; font-weight: 400">Admin</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/admin/search" method="GET">
            <input class="form-control" type="search" name="query" placeholder="Search users, listings, or categories..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Admin Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <a href="/admin/dashboard" class="btn btn-alternate">
                <i class="bi bi-house me-1"></i> Dashboard
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        
        <div class="admin-header mb-3">
          <div class="d-flex gap-2 mb-3">
            <a href="/admin/dashboard" class="btn btn-alternate">
              <i class="bi bi-house me-2"></i>Main Dashboard
            </a>
            <a href="/admin/moderation" class="btn btn-alternate">
              <i class="bi bi-arrow-left me-2"></i>Moderation Hub
            </a>
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h1>Moderate Listings</h1>
              <p>Review flagged listings and apply moderation actions.</p>
            </div>
          </div>
        </div>

        <form action="/admin/listings/bulk" method="POST" id="bulkActionForm">
          <input type="hidden" name="bulkAction" id="bulkActionInput" value="">

          <section class="admin-section mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="m-0">
                <select class="form-select form-select-sm" onchange="window.location.href='/admin/listings?status=' + this.value">
                  <option value="">All statuses</option>
                  <option value="Active" <%= (locals.currentStatus === 'Active') ? 'selected' : '' %>>Active</option>
                  <option value="Suspended" <%= (locals.currentStatus === 'Suspended') ? 'selected' : '' %>>Suspended</option>
                  <option value="Deleted" <%= (locals.currentStatus === 'Deleted') ? 'selected' : '' %>>Deleted</option>
                </select>
              </div>

              <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#bulkRestoreModal"><i class="bi bi-arrow-counterclockwise me-1"></i> Restore</button>
                <button type="button" class="btn btn-sm btn-outline-warning text-warning" data-bs-toggle="modal" data-bs-target="#bulkSuspendModal"><i class="bi bi-pause-circle me-1"></i> Suspend</button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#bulkDeleteModal"><i class="bi bi-trash me-1"></i> Delete</button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-dark table-striped table-sm align-middle mb-0 text-nowrap">
                <thead>
                  <tr>
                    <th scope="col">Select</th>
                    <th scope="col">Listing</th>
                    <th scope="col">Owner</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (listings && listings.length > 0) { %>
                    <% listings.forEach(listing => { %>
                      <tr>
                        <td><input class="form-check-input" type="checkbox" name="listingIds" value="<%= listing.id %>" /></td>
                        <td>
                          <div class="d-flex align-items-center">
                            <div class="fw-bold"><%= listing.title %></div>
                            <% if (listing.reports && listing.reports.length > 0) { %>
                              <span class="ms-2 badge bg-danger" title="<%= listing.reports.length %> active reports">
                                <i class="bi bi-flag-fill me-1"></i><%= listing.reports.length %>
                              </span>
                            <% } %>
                          </div>
                          <small class="text-muted">ID: LST-<%= listing.id %></small>
                        </td>
                        <td><%= listing.lender ? (listing.lender.firstName + ' ' + listing.lender.lastName) : 'Unknown' %></td>
                        <td>
                          <span class="badge <%= listing.status === 'Deleted' ? 'bg-danger' : (listing.status === 'Suspended' ? 'bg-warning text-dark' : 'bg-success') %>">
                            <%= listing.status || 'Active' %>
                          </span>
                        </td>
                        <td class="text-end">
                          <button type="button" class="btn btn-sm btn-outline-light me-1" data-bs-toggle="modal" data-bs-target="#viewModal<%= listing.id %>"><i class="bi bi-eye"></i></button>
                          <% if (listing.reports && listing.reports.length > 0) { %>
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1" title="Dismiss Reports" data-bs-toggle="modal" data-bs-target="#dismissListingReportsModal<%= listing.id %>"><i class="bi bi-x-circle"></i></button>
                          <% } %>
                          
                          <% if (listing.status === 'Suspended' || listing.status === 'Deleted') { %>
                            <button type="button" class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal" data-bs-target="#restoreModal<%= listing.id %>"><i class="bi bi-arrow-counterclockwise"></i></button>
                          <% } else { %>
                            <button type="button" class="btn btn-sm btn-outline-secondary disabled me-1"><i class="bi bi-arrow-counterclockwise"></i></button>
                          <% } %>

                          <% if (listing.status === 'Active') { %>
                            <button type="button" class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#suspendModal<%= listing.id %>"><i class="bi bi-pause-circle"></i></button>
                          <% } else { %>
                            <button type="button" class="btn btn-sm btn-outline-secondary disabled me-1"><i class="bi bi-pause-circle"></i></button>
                          <% } %>

                          <% if (listing.status !== 'Deleted') { %>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= listing.id %>"><i class="bi bi-trash"></i></button>
                          <% } else { %>
                            <button type="button" class="btn btn-sm btn-outline-secondary disabled"><i class="bi bi-trash"></i></button>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center py-3">No listings found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </section>

          <div class="modal fade" id="bulkRestoreModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-dark border-success">
                <div class="modal-body p-4">Restore selected listings to <strong>Active</strong>?</div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" onclick="document.getElementById('bulkActionInput').value='restore'" class="btn btn-success">Confirm Restore</button>
                </div>
              </div>
            </div>
          </div>

          <div class="modal fade" id="bulkSuspendModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-dark border-warning">
                <div class="modal-body p-4">Suspend selected listings? They will be hidden from the catalog.</div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" onclick="document.getElementById('bulkActionInput').value='suspend'" class="btn btn-warning text-dark fw-bold">Confirm Suspend</button>
                </div>
              </div>
            </div>
          </div>

          <div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-dark border-danger">
                <div class="modal-body p-4">Delete selected listings? This action is permanent.</div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" onclick="document.getElementById('bulkActionInput').value='delete'" class="btn btn-danger">Confirm Delete</button>
                </div>
              </div>
             </div>
          </div>
        </form>

        <% if (listings) { listings.forEach(listing => { %>
          <div class="modal fade" id="viewModal<%= listing.id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header"><h5>Listing Details: <%= listing.title %></h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body p-4">
                  <p><strong>Owner:</strong> <%= listing.lender ? (listing.lender.firstName + ' ' + listing.lender.lastName + ' (' + listing.lender.email + ')') : 'N/A' %></p>
                  <p><strong>Description:</strong></p>
                  <p class="text-muted"><%= listing.description %></p>
                  
                  <% if (listing.reports && listing.reports.length > 0) { %>
                    <hr class="border-secondary">
                    <h6 class="text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>Report History</h6>
                    <div class="list-group list-group-flush bg-transparent">
                      <% listing.reports.forEach(report => { %>
                        <div class="list-group-item bg-transparent text-light border-secondary px-0">
                          <div class="d-flex justify-content-between">
                            <span class="badge bg-danger mb-2 text-uppercase" style="font-size: 0.65rem;"><%= report.reason %></span>
                            <small class="text-muted"><%= new Date(report.createdAt).toLocaleDateString() %></small>
                          </div>
                          <p class="mb-1 small"><%= report.details %></p>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="modal fade" id="suspendModal<%= listing.id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-dark border-warning">
                <div class="modal-header border-warning"><h5 class="modal-title text-warning">Suspend Listing</h5></div>
                <form action="/admin/listings/<%= listing.id %>/suspend" method="POST">
                  <div class="modal-body p-4">Suspend <strong><%= listing.title %></strong>?</div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Suspend</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <% if (listing.reports && listing.reports.length > 0) { %>
            <div class="modal fade" id="dismissListingReportsModal<%= listing.id %>" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark text-light border-secondary">
                  <div class="modal-header border-secondary">
                    <h5 class="modal-title">Dismiss Reports</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body p-4">
                    <p>Are you sure you want to dismiss all pending reports for <strong><%= listing.title %></strong>?</p>
                  </div>
                  <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <form action="/admin/listings/<%= listing.id %>/dismiss-reports" method="POST">
                      <button type="submit" class="btn btn-secondary">Dismiss Reports</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <div class="modal fade" id="restoreModal<%= listing.id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-dark border-success">
                <div class="modal-header border-success"><h5 class="modal-title text-success">Restore Listing</h5></div>
                <form action="/admin/listings/<%= listing.id %>/unsuspend" method="POST">
                  <div class="modal-body p-4">Restore <strong><%= listing.title %></strong> to Active status?</div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold">Restore</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <div class="modal fade" id="deleteModal<%= listing.id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-dark border-danger">
                <div class="modal-header border-danger"><h5 class="modal-title text-danger">Delete Listing</h5></div>
                <form action="/admin/listings/<%= listing.id %>/remove" method="POST">
                  <div class="modal-body p-4">Permanently delete <strong><%= listing.title %></strong>?</div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold">Delete</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% })} %>

      </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>