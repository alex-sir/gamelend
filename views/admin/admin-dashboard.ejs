<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - GameLend</title>
    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1 role">Admin</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex">
            <input class="form-control" type="search" placeholder="Search users, listings, or rentals" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Admin Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-shield-lock me-1"></i>Admin Menu
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a></li>
                  <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i><%= currentUser ? currentUser.username : 'Account' %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        <div class="admin-header mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h1>Admin Home</h1>
              <p>Overview of GameLend activity and quick admin actions.</p>
            </div>
          </div>
        </div>

        <section class="admin-section mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2>Moderation</h2>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <h6 class="mb-2">Users</h6>
              <ul class="list-group moderation-links">
                <a href="/admin/users" class="list-group-item list-group-item-action">
                  <span><i class="bi bi-people me-2"></i> Manage Users</span>
                </a>
              </ul>
            </div>

            <div class="col-md-4">
              <h6 class="mb-2">Listings</h6>
              <ul class="list-group moderation-links">
                <a href="/admin/listings" class="list-group-item list-group-item-action">
                  <span><i class="bi bi-controller me-2"></i> Moderate Listings</span>
                </a>
              </ul>
            </div>

            <div class="col-md-4">
              <h6 class="mb-2">Categories</h6>
              <ul class="list-group moderation-links">
                <a href="/admin/categories" class="list-group-item list-group-item-action">
                  <span><i class="bi bi-tags me-2"></i> Manage Categories</span>
                </a>
              </ul>
            </div>
          </div>
        </section>

        <section class="admin-section mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2>Configuration & Analytics</h2>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
               <ul class="list-group moderation-links">
                <a href="/admin/analytics" class="list-group-item list-group-item-action">
                  <span><i class="bi bi-graph-up me-2"></i> Platform Analytics</span>
                </a>
              </ul>
            </div>
            <div class="col-md-6">
               <ul class="list-group moderation-links">
                <a href="/admin/settings" class="list-group-item list-group-item-action">
                  <span><i class="bi bi-gear me-2"></i> Global Settings</span>
                </a>
              </ul>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer class="mt-auto">
      <div class="container">
        <div class="copyright text-center py-3">
          <p>&copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>