<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - GameLend</title>
    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1" style="font-size: 0.85rem; font-weight: 400">Admin</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex">
            <input class="form-control" type="search" placeholder="Search users, listings, or rentals" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title">Admin Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              
              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-shield-lock me-1"></i>Portals
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a></li>
                  <li><a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href="/">Platform Home</a></li>
                </ul>
              </div>

              <div class="dropdown">
                <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-person-circle me-1"></i>
                  <%= locals.currentUser ? locals.currentUser.email.split('@')[0] : 'Admin Account' %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li><a class="dropdown-item text-danger" href="/auth/logout">Log Out</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        <div class="admin-header mb-4 border-bottom border-secondary pb-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h1>Admin Dashboard</h1>
              <p class="text-muted mb-0">Overview of GameLend activity and quick admin actions.</p>
            </div>
          </div>
        </div>

        <section class="admin-section mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Moderation Hub</h2>
          </div>

          <div class="row g-4">
            <div class="col-md-4">
              <h6 class="mb-2 text-uppercase text-muted" style="letter-spacing: 1px; font-size: 0.8rem;">Users</h6>
              <div class="list-group moderation-links shadow-sm">
                <a href="/admin/users" class="list-group-item list-group-item-action py-3">
                  <div class="d-flex w-100 justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-people me-2 fs-5 text-primary"></i> Manage Users</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                  </div>
                  <small class="text-muted ms-4 ps-1 d-block mt-1">Suspend accounts and assign roles.</small>
                </a>
              </div>
            </div>

            <div class="col-md-4">
              <h6 class="mb-2 text-uppercase text-muted" style="letter-spacing: 1px; font-size: 0.8rem;">Inventory</h6>
              <div class="list-group moderation-links shadow-sm">
                <a href="/admin/listings" class="list-group-item list-group-item-action py-3">
                  <div class="d-flex w-100 justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-controller me-2 fs-5 text-success"></i> Moderate Listings</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                  </div>
                  <small class="text-muted ms-4 ps-1 d-block mt-1">Review and delete flagged games.</small>
                </a>
              </div>
            </div>

            <div class="col-md-4">
              <h6 class="mb-2 text-uppercase text-muted" style="letter-spacing: 1px; font-size: 0.8rem;">Classification</h6>
              <div class="list-group moderation-links shadow-sm">
                <a href="/admin/categories" class="list-group-item list-group-item-action py-3">
                  <div class="d-flex w-100 justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-tags me-2 fs-5 text-warning"></i> Manage Categories</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                  </div>
                  <small class="text-muted ms-4 ps-1 d-block mt-1">Add or edit equipment categories.</small>
                </a>
              </div>