<!doctype html>
<html lang="en" data-bs-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Results - GameLend Admin</title>

  <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/app.css" />
  <link rel="stylesheet" href="/css/admin/admin.css" />
</head>

<body class="admin-page d-flex flex-column min-vh-100">
  <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
    <div class="container-fluid">
      <a class="navbar-brand" href="/admin/dashboard">
        <i class="bi bi-controller me-2"></i>GameLend
        <span class="ms-1 role">Admin</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="mx-lg-4 mt-2 mb-0 search-bar">
        <form class="d-flex" action="/admin/search" method="GET">
          <input class="form-control" type="search" name="query" placeholder="Search users, listings, or categories..." value="<%= query %>" aria-label="Search" />
          <button class="btn btn-primary search-submit" type="submit">
            <i class="bi bi-search fs-5"></i>
          </button>
        </form>
      </div>

      <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
        <div class="offcanvas-header">
          <h5 class="offcanvas-title">Admin Menu</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
          <div class="ms-auto d-flex align-items-center gap-3">
            <a href="/admin/dashboard" class="btn btn-alternate">
              <i class="bi bi-house me-1"></i> Dashboard
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main class="py-4">
    <div class="container">
      <div class="admin-header mb-4">
        <h1>Search Results</h1>
        <p class="text-muted">Showing results for "<span class="text-white fw-bold"><%= query %></span>"</p>
      </div>

      <!-- Users Results -->
      <section class="admin-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2>Users (<%= results.users.length %>)</h2>
          <a href="/admin/users" class="section-footer-link">View all users</a>
        </div>
        <% if (results.users.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% results.users.forEach(user => { %>
                  <tr>
                    <td><%= user.firstName %> <%= user.lastName %></td>
                    <td><%= user.email %></td>
                    <td><span class="badge bg-secondary"><%= user.role %></span></td>
                    <td>
                      <% if (user.isSuspended) { %>
                        <span class="badge bg-danger">Suspended</span>
                      <% } else { %>
                        <span class="badge bg-success">Active</span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <a href="/admin/users?query=<%= user.email %>" class="btn btn-sm btn-outline-primary">Manage</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted italic">No users found matching your query.</p>
        <% } %>
      </section>

      <!-- Listings Results -->
      <section class="admin-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2>Listings (<%= results.listings.length %>)</h2>
          <a href="/admin/listings" class="section-footer-link">View all listings</a>
        </div>
        <% if (results.listings.length > 0) { %>
          <div class="row g-3">
            <% results.listings.forEach(listing => { %>
              <div class="col-md-6">
                <div class="metric-card h-100 d-flex justify-content-between align-items-center">
                  <div>
                    <h5 class="mb-1"><%= listing.title %></h5>
                    <p class="mb-0 text-muted small"><%= listing.category %> · $<%= listing.dailyRate %>/day</p>
                  </div>
                  <a href="/admin/listings?query=<%= encodeURIComponent(listing.title) %>" class="btn btn-sm btn-outline-primary">View</a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted italic">No listings found matching your query.</p>
        <% } %>
      </section>

      <!-- Categories Results -->
      <section class="admin-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2>Categories (<%= results.categories.length %>)</h2>
          <a href="/admin/categories" class="section-footer-link">Manage categories</a>
        </div>
        <% if (results.categories.length > 0) { %>
          <div class="d-flex flex-wrap gap-2">
            <% results.categories.forEach(cat => { %>
              <div class="metric-card py-2 px-3">
                <i class="bi bi-tag-fill me-2 text-primary"></i><%= cat.name %>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted italic">No categories found matching your query.</p>
        <% } %>
      </section>
    </div>
  </main>

  <footer class="mt-auto">
    <div class="container text-center py-4 border-top border-secondary">
      <p class="text-muted mb-0">&copy; 2026 GameLend Admin Portal.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
