<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameLend · Moderate Categories</title>


    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin/admin.css" />

  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1" style="font-size: 0.85rem; font-weight: 400">
            Admin
          </span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/admin/search" method="GET">
            <input
              class="form-control"
              type="search"
              name="query"
              placeholder="Search categories"
              aria-label="Search"
            />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Admin Menu</h5>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="offcanvas"
            ></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <div class="dropdown">
                <button
                  class="btn btn-alternate dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                >
                  <i class="bi bi-person-circle me-1"></i>Admin Dashboard
                </button>

                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li>
                    <a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a>
                  </li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <a class="dropdown-item" href="/">Home</a>
                  </li>
                </ul>
              </div>

              <div class="dropdown">
                <button
                  class="btn btn-alternate dropdown-toggle"
                  type="button"
                  data-bs-toggle="dropdown"
                >
                  <i class="bi bi-person-circle me-1"></i>
                  <%= locals.currentUser ? locals.currentUser.email.split('@')[0] : 'Account' %>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                  <li>
                    <a class="dropdown-item" href="/lender/profile">Profile Settings</a>
                  </li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <a class="dropdown-item" href="/auth/logout">Log Out</a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        
        <div class="admin-header mb-3">
          <div class="d-flex gap-2 mb-3">
            <a href="/admin/dashboard" class="btn btn-alternate">
              <i class="bi bi-house me-2"></i>Main Dashboard
            </a>
            <a href="/admin/moderation" class="btn btn-alternate">
              <i class="bi bi-arrow-left me-2"></i>Moderation Hub
            </a>
          </div>

          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h1>Moderate Categories</h1>
              <p>
                Define and manage the categories used to classify reports, listings, and moderation actions.
              </p>
            </div>
          </div>
        </div>

        <section class="admin-section mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2>Category list</h2>
            <button class="btn btn-main btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
              <i class="bi bi-plus-circle me-1"></i>Add category
            </button>
          </div>

          <div class="table-responsive">
            <table class="table table-dark table-striped table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Applies to</th>
                  <th scope="col">Status</th>
                  <th scope="col">Listings</th>
                  <th scope="col">Last updated</th>
                  <th scope="col" class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (categories && categories.length > 0) { %>
                  <% categories.forEach(category => { %>
                    <tr>
                      <td><%= category.name %></td>
                      <td>Listings</td>
                      <td>
                        <span class="badge bg-<%= category.status === 'Hidden' ? 'secondary' : (category.status === 'Review' ? 'warning text-dark' : 'success') %>">
                          <%= category.status %>
                        </span>
                      </td>
                      <td><%= category.listingsCount || 0 %></td>
                      <td><%= new Date(category.updatedAt || category.createdAt).toLocaleDateString() %></td>
                      <td class="text-end">
                        <form action="/admin/categories/<%= category.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category? Listings using it will retain their text but it will be removed from navigation.');">
                          <button class="btn btn-sm btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-3">No categories found.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          </div>

          <div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                  <h5 class="modal-title">Add New Category</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/admin/categories" method="POST">
                  <div class="modal-body p-4">
                    <div class="mb-3">
                      <label for="categoryName" class="form-label text-muted small">Category Name</label>
                      <input type="text" class="form-control bg-dark text-light border-secondary" id="categoryName" name="name" required placeholder="e.g., Controllers">
                    </div>
                    <div class="mb-3">
                      <label for="categoryDesc" class="form-label text-muted small">Description (Optional)</label>
                      <textarea class="form-control bg-dark text-light border-secondary" id="categoryDesc" name="description" rows="2" placeholder="Brief description of items in this category..."></textarea>
                    </div>
                  </div>
                  <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-main fw-bold">Create Category</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </section>

        <section class="admin-section mb-4">
          <h2 class="mb-2">How categories are used</h2>
          <p class="mb-1">
            Categories help structure listings and reports so moderators can
            quickly filter and prioritize work.
          </p>
          <p class="mb-0">
            Updating a category here will affect any future reports and listings
            that use it, but existing records keep their current labels.
          </p>
        </section>
      </div>
    </main>

    <footer class="mt-auto">
      <div class="container">
        <div class="copyright text-center py-3">
          <p>&copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>