<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameLend · Manage Users</title>
    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin.css?v=1.2" />
  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1" style="font-size: 0.85rem; font-weight: 400">Admin</span>
        </a>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        <div class="admin-header mb-3">
          <a href="/admin/dashboard" class="btn btn-alternate mb-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
          </a>
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h1>Manage Users</h1>
              <p>Review GameLend users, roles, and account status.</p>
            </div>
          </div>
        </div>

        <section class="admin-section mb-4">
          <div class="table-responsive">
            <table class="table table-dark table-striped table-sm align-middle mb-0 text-nowrap">
              <thead>
                <tr>
                  <th scope="col">User</th>
                  <th scope="col">Email</th>
                  <th scope="col">Role</th>
                  <th scope="col">Status</th>
                  <th scope="col">Joined</th>
                  <th scope="col" class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (users && users.length > 0) { %>
                  <% users.forEach(user => { %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-uppercase" style="width: 32px; height: 32px; font-size: 0.85rem">
                            <%= user.email.charAt(0) %>
                          </div>
                          <div>
                            <div><%= user.email.split('@')[0] %></div>
                          </div>
                        </div>
                      </td>
                      <td><%= user.email %></td>
                      <td>
                        <% if (user.role === 'admin') { %>
                          <span class="badge bg-info text-dark">Admin</span>
                        <% } else { %>
                          <span class="badge bg-secondary text-capitalize"><%= user.role %></span>
                        <% } %>
                      </td>
                      <td>
                        <% if (user.isSuspended) { %>
                          <span class="badge bg-danger">Suspended</span>
                        <% } else { %>
                          <span class="badge bg-success">Active</span>
                        <% } %>
                      </td>
                      <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                      <td class="text-end">
                        
                        <button type="button" class="btn btn-sm btn-outline-warning me-1" title="Change Role" data-bs-toggle="modal" data-bs-target="#roleModal<%= user.id %>">
                          <i class="bi bi-shield-lock"></i>
                        </button>
                        
                        <% if (!user.isSuspended) { %>
                          <form action="/admin/users/<%= user.id %>/suspend" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to suspend this user?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Suspend User">
                              <i class="bi bi-slash-circle"></i>
                            </button>
                          </form>
                        <% } else { %>
                         <form action="/admin/users/<%= user.id %>/unsuspend" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to restore this user\'s access?');">
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Restore User">
                              <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                          </form> 
                        <% } %>
                        
                      </td>
                    </tr>

                    <div class="modal fade" id="roleModal<%= user.id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered text-wrap">
                        <div class="modal-content bg-dark text-light border-secondary">
                          <div class="modal-header border-secondary">
                            <h5 class="modal-title">Change Role: <%= user.email.split('@')[0] %></h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <form action="/admin/users/<%= user.id %>/role" method="POST">
                            <div class="modal-body">
                              <label class="form-label text-start w-100">Select a new role for this user:</label>
                              <select name="newRole" class="form-select bg-dark text-light border-secondary">
                                <option value="borrower" <%= user.role === 'borrower' ? 'selected' : '' %>>Borrower</option>
                                <option value="lender" <%= user.role === 'lender' ? 'selected' : '' %>>Lender</option>
                                <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                              </select>
                            </div>
                            <div class="modal-footer border-secondary">
                              <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-warning text-dark fw-bold">Save Role</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-3">No users found in the database.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>

    <footer class="mt-auto">
      <div class="container">
        <div class="copyright text-center py-3">
          <p>&copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>