<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameLend · Manage Users</title>
    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin.css?v=1.2" />
    
    <style>
      .role-card {
        border-width: 2px;
        transition: all 0.2s ease-in-out;
        opacity: 0.7;
      }
      .role-card:hover {
        opacity: 1;
        background-color: rgba(255, 255, 255, 0.05);
      }
      /* Highlight the card when the hidden radio button is checked */
      .btn-check:checked + .role-card {
        border-color: #ffc107 !important; /* Bootstrap Warning Yellow */
        background-color: rgba(255, 193, 7, 0.08) !important;
        opacity: 1;
      }
      .btn-check:checked + .role-card .icon-wrapper i {
        color: #ffc107 !important;
      }
    </style>
  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-controller me-2"></i>GameLend
          <span class="ms-1" style="font-size: 0.85rem; font-weight: 400">Admin</span>
        </a>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        
        <div class="admin-header mb-3">
          <div class="d-flex gap-2 mb-3">
            <a href="/admin/dashboard" class="btn btn-alternate">
              <i class="bi bi-house me-2"></i>Main Dashboard
            </a>
            <a href="/admin/moderation" class="btn btn-alternate">
              <i class="bi bi-arrow-left me-2"></i>Moderation Hub
            </a>
          </div>
          
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h1>Manage Users</h1>
              <p>Review GameLend users, roles, and account status.</p>
            </div>
          </div>
        </div>

        <section class="admin-section mb-4">
          <div class="table-responsive">
            <table class="table table-dark table-striped table-sm align-middle mb-0 text-nowrap">
              <thead>
                <tr>
                  <th scope="col">User</th>
                  <th scope="col">Email</th>
                  <th scope="col">Role</th>
                  <th scope="col">Status</th>
                  <th scope="col">Joined</th>
                  <th scope="col" class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (users && users.length > 0) { %>
                  <% users.forEach(user => { %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-uppercase" style="width: 32px; height: 32px; font-size: 0.85rem">
                            <%= user.email.charAt(0) %>
                          </div>
                          <div>
                            <div class="d-flex align-items-center">
                              <div><%= user.email.split('@')[0] %></div>
                              <% 
                                let totalUserReports = 0;
                                if (user.listings) {
                                  user.listings.forEach(l => {
                                    if (l.reports) totalUserReports += l.reports.length;
                                  });
                                }
                              %>
                              <% if (totalUserReports > 0) { %>
                                <span class="ms-2 badge bg-danger" title="<%= totalUserReports %> active reports against this user">
                                  <i class="bi bi-flag-fill me-1"></i><%= totalUserReports %>
                                </span>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td><%= user.email %></td>
                      <td>
                        <% if (user.role === 'admin') { %>
                          <span class="badge bg-info text-dark">Admin</span>
                        <% } else { %>
                          <span class="badge bg-secondary text-capitalize"><%= user.role %></span>
                        <% } %>
                      </td>
                      <td>
                        <% if (user.isSuspended) { %>
                          <span class="badge bg-danger">Suspended</span>
                        <% } else { %>
                          <span class="badge bg-success">Active</span>
                        <% } %>
                      </td>
                      <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                      <td class="text-end">
                        
                        <% if (totalUserReports > 0) { %>
                          <button type="button" class="btn btn-sm btn-outline-light me-1" title="View Reports" data-bs-toggle="modal" data-bs-target="#userReportsModal<%= user.id %>">
                            <i class="bi bi-eye"></i>
                          </button>
                          <button type="button" class="btn btn-sm btn-outline-secondary me-1" title="Dismiss Reports" data-bs-toggle="modal" data-bs-target="#dismissUserReportsModal<%= user.id %>">
                            <i class="bi bi-x-circle"></i>
                          </button>
                        <% } %>

                        <button type="button" class="btn btn-sm btn-outline-warning me-1" title="Change Role" data-bs-toggle="modal" data-bs-target="#roleModal<%= user.id %>">
                          <i class="bi bi-shield-lock"></i>
                        </button>
                        
                        <% if (!user.isSuspended) { %>
                          <button type="button" class="btn btn-sm btn-outline-danger" title="Suspend User" data-bs-toggle="modal" data-bs-target="#suspendModal<%= user.id %>">
                            <i class="bi bi-slash-circle"></i>
                          </button>
                        <% } else { %>
                          <button type="button" class="btn btn-sm btn-outline-success" title="Restore User" data-bs-toggle="modal" data-bs-target="#restoreModal<%= user.id %>">
                            <i class="bi bi-arrow-counterclockwise"></i>
                          </button>
                        <% } %>
                        
                      </td>
                    </tr>

                    <% if (totalUserReports > 0) { %>
                      <div class="modal fade" id="userReportsModal<%= user.id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                          <div class="modal-content bg-dark text-light border-danger">
                            <div class="modal-header border-danger">
                              <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Reports for <%= user.email.split('@')[0] %></h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                              <div class="list-group list-group-flush bg-transparent">
                                <% user.listings.forEach(listing => { %>
                                  <% if (listing.reports) { listing.reports.forEach(report => { %>
                                    <div class="list-group-item bg-transparent text-light border-secondary px-0">
                                      <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                          <span class="badge bg-danger text-uppercase me-2" style="font-size: 0.65rem;"><%= report.reason %></span>
                                          <small class="text-white-50">On listing: <strong><%= listing.title %></strong></small>
                                        </div>
                                          <div class="text-end">
                                            <div class="text-muted small mb-1"><%= new Date(report.createdAt).toLocaleDateString() %></div>
                                          </div>
                                      </div>
                                      <p class="mb-0 small"><%= report.details %></p>
                                    </div>
                                  <% }) } %>
                                <% }) %>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% } %>

                    <% if (totalUserReports > 0) { %>
                      <div class="modal fade" id="dismissUserReportsModal<%= user.id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content bg-dark text-light border-secondary">
                            <div class="modal-header border-secondary">
                              <h5 class="modal-title">Dismiss Reports</h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                              <p>Are you sure you want to dismiss all pending reports against <strong><%= user.email.split('@')[0] %></strong>?</p>
                              <p class="text-muted small mb-0">This will mark all reports as "Dismissed" and clear them from the moderation queue.</p>
                            </div>
                            <div class="modal-footer border-secondary">
                              <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                              <form action="/admin/users/<%= user.id %>/dismiss-reports" method="POST">
                                <button type="submit" class="btn btn-secondary">Dismiss Reports</button>
                              </form>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% } %>

                    <div class="modal fade" id="roleModal<%= user.id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered text-wrap">
                        <div class="modal-content bg-dark text-light border-secondary shadow-lg">
                          
                          <div class="modal-header border-secondary border-bottom-0 pb-0">
                            <h5 class="modal-title fs-4 fw-semibold">
                              <i class="bi bi-shield-lock text-warning me-2"></i>Change Role
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          
                          <form action="/admin/users/<%= user.id %>/role" method="POST">
                            <div class="modal-body pt-3">
                              <p class="text-muted mb-4">Update platform permissions for <strong class="text-white"><%= user.email.split('@')[0] %></strong>.</p>
                              
                              <div class="d-flex flex-column gap-3">
                                
                                <div>
                                  <input type="radio" class="btn-check" name="newRole" id="roleBorrower<%= user.id %>" value="borrower" <%= user.role === 'borrower' ? 'checked' : '' %>>
                                  <label class="btn btn-outline-secondary text-start p-3 d-flex align-items-center rounded-3 role-card w-100 m-0" for="roleBorrower<%= user.id %>">
                                    <div class="icon-wrapper me-3">
                                      <i class="bi bi-person fs-2 text-light"></i>
                                    </div>
                                    <div>
                                      <div class="fw-bold text-light fs-5">Borrower</div>
                                      <small class="text-muted d-block text-wrap" style="line-height: 1.2;">Standard account. Can browse listings and rent equipment.</small>
                                    </div>
                                  </label>
                                </div>

                                <div>
                                  <input type="radio" class="btn-check" name="newRole" id="roleLender<%= user.id %>" value="lender" <%= user.role === 'lender' ? 'checked' : '' %>>
                                  <label class="btn btn-outline-secondary text-start p-3 d-flex align-items-center rounded-3 role-card w-100 m-0" for="roleLender<%= user.id %>">
                                    <div class="icon-wrapper me-3">
                                      <i class="bi bi-controller fs-2 text-light"></i>
                                    </div>
                                    <div>
                                      <div class="fw-bold text-light fs-5">Lender</div>
                                      <small class="text-muted d-block text-wrap" style="line-height: 1.2;">Creator account. Can list items, manage rentals, and borrow.</small>
                                    </div>
                                  </label>
                                </div>

                                <div>
                                  <input type="radio" class="btn-check" name="newRole" id="roleAdmin<%= user.id %>" value="admin" <%= user.role === 'admin' ? 'checked' : '' %>>
                                  <label class="btn btn-outline-secondary text-start p-3 d-flex align-items-center rounded-3 role-card w-100 m-0" for="roleAdmin<%= user.id %>">
                                    <div class="icon-wrapper me-3">
                                      <i class="bi bi-shield-star fs-2 text-light"></i>
                                    </div>
                                    <div>
                                      <div class="fw-bold text-light fs-5">Admin</div>
                                      <small class="text-muted d-block text-wrap" style="line-height: 1.2;">Full platform access. Can moderate users, listings, and settings.</small>
                                    </div>
                                  </label>
                                </div>

                              </div>
                            </div>
                            
                            <div class="modal-footer border-secondary border-top-0 pt-0 mt-2">
                              <button type="button" class="btn btn-dark border-secondary text-light px-3" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Save Changes</button>
                            </div>
                          </form>
                          
                        </div>
                      </div>
                    </div>

                    <div class="modal fade" id="suspendModal<%= user.id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered text-wrap">
                        <div class="modal-content bg-dark text-light border-danger shadow-lg">
                          
                          <div class="modal-header border-danger border-bottom-0 pb-0">
                            <h5 class="modal-title fs-4 fw-semibold">
                              <i class="bi bi-exclamation-triangle text-danger me-2"></i>Suspend User
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          
                          <form action="/admin/users/<%= user.id %>/suspend" method="POST">
                            <div class="modal-body pt-3">
                              <p class="text-muted mb-0">Are you sure you want to suspend <strong class="text-white"><%= user.email.split('@')[0] %></strong>?</p>
                              
                              <div class="mt-4 p-3 bg-danger bg-opacity-10 rounded border border-danger border-opacity-25">
                                <div class="d-flex align-items-start">
                                  <i class="bi bi-info-circle text-danger mt-1 me-3 fs-5"></i>
                                  <div>
                                    <strong class="text-danger d-block mb-1">What happens next?</strong>
                                    <small class="text-danger-emphasis d-block" style="line-height: 1.4;">This user will immediately lose access to their account. Their active listings will be hidden from the marketplace, and pending rentals may be cancelled.</small>
                                  </div>
                                </div>
                              </div>

                              <div class="mt-4">
                                <label for="reason<%= user.id %>" class="form-label text-light fw-semibold">Reason for Suspension</label>
                                <textarea 
                                  class="form-control bg-dark text-light border-secondary" 
                                  id="reason<%= user.id %>" 
                                  name="reason" 
                                  rows="3" 
                                  placeholder="e.g., Repeated violations of terms of service..."
                                  required
                                ></textarea>
                                <small class="text-muted mt-1 d-block">This reason will be shown to the user when they attempt to log in.</small>
                              </div>
                            </div>
                            
                            <div class="modal-footer border-danger border-top-0 pt-0 mt-3">
                              <button type="button" class="btn btn-dark border-secondary text-light px-3" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-danger fw-bold px-4">Confirm Suspension</button>
                            </div>
                          </form>
                          
                        </div>
                      </div>
                    </div>

                    <div class="modal fade" id="restoreModal<%= user.id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered text-wrap">
                        <div class="modal-content bg-dark text-light border-success shadow-lg">
                          
                          <div class="modal-header border-success border-bottom-0 pb-0">
                            <h5 class="modal-title fs-4 fw-semibold">
                              <i class="bi bi-shield-check text-success me-2"></i>Restore Access
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          
                          <form action="/admin/users/<%= user.id %>/unsuspend" method="POST">
                            <div class="modal-body pt-3">
                              <p class="text-muted mb-0">Are you sure you want to restore access for <strong class="text-white"><%= user.email.split('@')[0] %></strong>?</p>
                              
                              <div class="mt-4 p-3 bg-success bg-opacity-10 rounded border border-success border-opacity-25">
                                <div class="d-flex align-items-start">
                                  <i class="bi bi-check-circle text-success mt-1 me-3 fs-5"></i>
                                  <div>
                                    <strong class="text-success d-block mb-1">Account Reactivation</strong>
                                    <small class="text-success-emphasis d-block" style="line-height: 1.4;">The user will regain full platform access based on their current role (<span class="text-capitalize"><%= user.role %></span>). Note: Any previously suspended listings must be manually restored.</small>
                                  </div>
                                </div>
                              </div>
                            </div>
                            
                            <div class="modal-footer border-success border-top-0 pt-0 mt-3">
                              <button type="button" class="btn btn-dark border-secondary text-light px-3" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-success fw-bold px-4">Restore Account</button>
                            </div>
                          </form>
                          
                        </div>
                      </div>
                    </div>

                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-3">No users found in the database.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>

    <footer class="mt-auto">
      <div class="container">
        <div class="copyright text-center py-3">
          <p>&copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>