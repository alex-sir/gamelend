<!doctype html>
<html lang="en" data-bs-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard - GameLend</title>


  <link rel="icon" href="/assets/icons/controller.png" type="image/png" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
    rel="stylesheet" />

  <link rel="stylesheet" href="/css/app.css" />
  <link rel="stylesheet" href="/css/admin/admin.css" />
</head>

<body class="admin-page d-flex flex-column min-vh-100">
  <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
    <div class="container-fluid">
      <a class="navbar-brand" href="/admin/dashboard">
        <i class="bi bi-controller me-2"></i>GameLend
        <span class="ms-1 role">Admin</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="mx-lg-4 mt-2 mb-0 search-bar">
        <form class="d-flex" action="/admin/search" method="GET">
          <input class="form-control" type="search" name="query" placeholder="Search users, listings, or categories..." aria-label="Search" />
          <button class="btn btn-primary search-submit" type="submit">
            <i class="bi bi-search fs-5"></i>
          </button>
        </form>
      </div>



      <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
        <div class="offcanvas-header">
          <h5 class="offcanvas-title">Admin Menu</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
          <div class="ms-auto d-flex align-items-center gap-3">
            <div class="dropdown">
              <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle me-1"></i>Admin Dashboard
              </button>

              <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                <li>
                  <a class="dropdown-item" href="/borrower/dashboard">Borrower Dashboard</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/lender/dashboard">Lender Dashboard</a>
                </li>
                <li>
                  <hr class="dropdown-divider" />
                </li>
                <li>
                  <a class="dropdown-item" href="/">Home</a>
                </li>
              </ul>
            </div>

            <div class="dropdown">
              <button class="btn btn-alternate dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle me-1"></i>
                <%= locals.currentUser ? locals.currentUser.email.split('@')[0] : 'Account' %>
              </button>
              <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                <li>
                  <a class="dropdown-item" href="/lender/profile">Profile Settings</a>
                </li>
                <li>
                  <hr class="dropdown-divider" />
                </li>
                <li>
                  <a class="dropdown-item" href="/auth/logout">Log Out</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main class="py-4">
    <div class="container">
      <div class="admin-header mb-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h1>Admin Home</h1>
            <p>Overview of GameLend activity and quick admin actions.</p>
          </div>
        </div>
      </div>

      <section class="admin-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h2>Analytics</h2>
          <a href="/admin/analytics" class="section-footer-link">
            View full analytics <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <div class="metric-card">
              <div class="metric-label">Total Inventory</div>
              <div class="metric-value">
                <%= metrics.activeListings %>
              </div>

            </div>
          </div>
          <div class="col-md-4">
            <div class="metric-card">
              <div class="metric-label">Completed Rentals (30 days)</div>
              <div class="metric-value">
                <%= metrics.completedRentals %>
              </div>

            </div>
          </div>
          <div class="col-md-4">
            <div class="metric-card">
              <div class="metric-label">Platform Revenue (30 days)</div>
              <div class="metric-value">$<%= metrics.totalRevenue %>
              </div>

            </div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-lg-8">
            <div class="metric-card h-100">
              <h5 class="mb-3">Revenue Overview</h5>
              <div style="height: 300px;">
                <canvas id="revenueChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="metric-card h-100">
              <h5 class="mb-3">Listing Categories</h5>
              <div style="height: 300px;">
                <canvas id="categoryChart"></canvas>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Chart.js and Dashboard Script -->
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          Chart.defaults.color = '#888';
          Chart.defaults.font.family = "'Open Sans', sans-serif";

          // --- Revenue Chart (Area Chart Rehaul) ---
          const revCtx = document.getElementById('revenueChart').getContext('2d');
          const revenueData = JSON.parse('<%- JSON.stringify(chartData.revenue) %>');
          
          const revGradient = revCtx.createLinearGradient(0, 0, 0, 300);
          revGradient.addColorStop(0, 'rgba(255, 125, 31, 0.4)');
          revGradient.addColorStop(1, 'rgba(255, 125, 31, 0)');

          new Chart(revCtx, {
            type: 'line',
            data: {
              labels: revenueData.map(d => d.label),
              datasets: [{
                label: 'Platform Revenue',
                data: revenueData.map(d => d.value),
                borderColor: '#FF7D1F',
                backgroundColor: revGradient,
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointRadius: 4,
                pointHoverRadius: 6,
                pointBackgroundColor: '#FF7D1F',
                pointBorderColor: '#1a1d21'
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  mode: 'index',
                  intersect: false,
                  backgroundColor: '#2b3035',
                  titleColor: '#FF7D1F',
                  bodyColor: '#fff',
                  borderColor: '#444',
                  borderWidth: 1,
                  callbacks: {
                    label: function(context) {
                      return ' Revenue: $' + parseFloat(context.parsed.y).toFixed(2);
                    }
                  }
                }
              },
              scales: {
                y: { 
                  beginAtZero: true,
                  grid: { color: 'rgba(255, 255, 255, 0.05)' },
                  ticks: { 
                    callback: value => '$' + value
                  }
                },
                x: { 
                  grid: { display: false }
                }
              }
            }
          });

          // --- Category Distribution Chart ---
          const catCtx = document.getElementById('categoryChart').getContext('2d');
          const catData = JSON.parse('<%- JSON.stringify(chartData.categories) %>');
          
          new Chart(catCtx, {
            type: 'doughnut',
            data: {
              labels: catData.map(d => d.label),
              datasets: [{
                data: catData.map(d => d.value),
                backgroundColor: ['#FF7D1F', '#4A90E2', '#50E3C2', '#B8E986', '#8E44AD'],
                borderWidth: 2,
                borderColor: '#1a1d21',
                hoverOffset: 15
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: { color: '#CCC', padding: 20, usePointStyle: true }
                },
                tooltip: {
                  backgroundColor: '#2b3035',
                  callbacks: {
                    label: function(context) {
                      const total = context.dataset.data.reduce((a, b) => a + b, 0);
                      const percentage = ((context.parsed / total) * 100).toFixed(1);
                      return ` ${context.label}: ${context.parsed} listings (${percentage}%)`;
                    }
                  }
                }
              },
              cutout: '75%'
            }
          });
        });
      </script>

      <section class="admin-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h2>Moderation</h2>
          <a href="/admin/moderation" class="section-footer-link">
            Open moderation hub <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <div class="row g-3">
          <div class="col-md-4">
            <h6 class="mb-2">Users</h6>
            <ul class="list-group moderation-links">
              <a href="/admin/users" class="list-group-item list-group-item-action">
                <span><i class="bi bi-people me-2"></i> Manage Users</span>

              </a>
            </ul>
          </div>

          <div class="col-md-4">
            <h6 class="mb-2">Listings</h6>
            <ul class="list-group moderation-links">
              <a href="/admin/listings" class="list-group-item list-group-item-action">
                <span>
                  <i class="bi bi-controller me-2"></i> Moderate Listings
                </span>

              </a>
            </ul>
          </div>

          <div class="col-md-4">
            <h6 class="mb-2">Categories</h6>
            <ul class="list-group moderation-links">
              <a href="/admin/categories" class="list-group-item list-group-item-action">
                <span>
                  <i class="bi bi-tags me-2"></i> Manage Categories
                </span>
              </a>
            </ul>
          </div>
        </div>
      </section>

      <section class="admin-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2>Moderator Activity</h2>
          <span class="badge bg-secondary">Last 10 actions</span>
        </div>

        <% if (locals.auditLogs && auditLogs.length > 0) { %>
          <div class="list-group">
            <% auditLogs.forEach(log => { %>
              <div class="list-group-item list-group-item-action bg-dark text-light border-secondary mb-2 rounded shadow-sm">
                <div class="d-flex w-100 justify-content-between align-items-start">
                  <div>
                    <span class="badge bg-primary mb-1"><%= log.action %></span>
                    <h6 class="mb-1 text-white"><%= log.details %></h6>
                    <small class="text-muted">
                      Target: <span class="text-info"><%= log.targetType %></span> <%= log.targetId ? '(ID: ' + log.targetId + ')' : '' %>
                    </small>
                  </div>
                  <div class="text-end">
                    <small class="text-muted d-block mb-1"><%= new Date(log.createdAt).toLocaleString() %></small>
                    <small class="text-white-50">
                      <i class="bi bi-person-fill me-1"></i>
                      <%= log.admin ? (log.admin.firstName + ' ' + log.admin.lastName) : 'Admin' %>
                    </small>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-5 border border-secondary rounded border-dashed">
            <i class="bi bi-journal-text fs-1 text-muted mb-3 d-block"></i>
            <p class="text-muted mb-0">No moderator activity logged yet.</p>
          </div>
        <% } %>
      </section>

      <section class="admin-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h2>Configuration</h2>
          <a href="/admin/settings" class="section-footer-link">
            Open full settings <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <p class="mb-0 text-muted">
          Manage core GameLend admin settings from the configuration panel.
        </p>
      </section>
    </div>
  </main>

  <footer>
    <div class="container">
      <div class="row justify-content-center mx-auto">
        <div class="col-md-3 mb-4">
          <h5>About</h5>
          <ul>
            <li><a href="/">About GameLend</a></li>
            <li><a href="/">Our Team</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h5>Support</h5>
          <ul>
            <li><a href="/">FAQ</a></li>
            <li><a href="/">Contact Us</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h5>Connect</h5>
          <ul>
            <li>
              <a href="https://github.com/alex-sir/gamelend" target="_blank"><i class="bi bi-github me-2"></i>GitHub</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="copyright">
        <p>
          &copy; 2026 GameLend. A WSU CPT_S 489 Course Project. All rights
          reserved.
        </p>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>