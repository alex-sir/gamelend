<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameLend · Analytics Hub</title>
    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin/admin.css" />
  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-controller me-2"></i>GameLend <span class="ms-1" style="font-size: 0.85rem; font-weight: 400">Admin</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="mx-lg-4 mt-2 mb-0 search-bar">
          <form class="d-flex" action="/admin/search" method="GET">
            <input class="form-control" type="search" name="query" placeholder="Search users, listings, or categories..." aria-label="Search" />
            <button class="btn btn-primary search-submit" type="submit">
              <i class="bi bi-search fs-5"></i>
            </button>
          </form>
        </div>

        <div class="offcanvas offcanvas-end" id="navbarNav" tabindex="-1">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title">Admin Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
          </div>
          <div class="offcanvas-body">
            <div class="ms-auto d-flex align-items-center gap-3">
              <a href="/admin/dashboard" class="btn btn-alternate">
                <i class="bi bi-house me-1"></i> Dashboard
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        
        <div class="admin-header mb-3">
          <a href="/admin/dashboard" class="btn btn-alternate mb-3">
            <i class="bi bi-house me-2"></i>Main Dashboard
          </a>

          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h1>Analytics Hub</h1>
              <p>Deep dive into GameLend performance, usage, and revenue.</p>
            </div>
          </div>
        </div>

        <section class="admin-section mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2>Key Metrics</h2>
          </div>

          <div class="row g-3">
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Active Listings</div>
                <div class="metric-value"><%= metrics.activeListings %></div>
                <div class="metric-trend text-success">
                  <i class="bi bi-arrow-up-right me-1"></i> Live right now
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Completed Rentals</div>
                <div class="metric-value"><%= metrics.completedRentals %></div>
                <div class="metric-trend text-info">
                  <i class="bi bi-clock-history me-1"></i> All-Time
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Platform Revenue</div>
                <div class="metric-value">$<%= Number(metrics.totalRevenue).toFixed(2) %></div>
                <div class="metric-trend text-success">
                  <i class="bi bi-currency-dollar me-1"></i> Total Earnings
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Total Active Users</div>
                <div class="metric-value"><%= metrics.activeRenters + metrics.activeOwners %></div>
                <div class="metric-trend text-warning">
                  <i class="bi bi-people me-1"></i> Verified accounts
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="admin-section mb-4">
            <h2 class="mb-3">Performance Overview</h2>
            <div class="row">
              <div class="col-md-6 mb-4">
                <div class="p-4 bg-dark rounded border border-secondary border-opacity-25" style="height: 350px;">
                  <canvas id="categoryChart"></canvas>
                </div>
              </div>
              <div class="col-md-6 mb-4">
                <div class="p-4 bg-dark rounded border border-secondary border-opacity-25" style="height: 350px;">
                  <canvas id="rentalStatusChart"></canvas>
                </div>
              </div>
            </div>
        </section>

      </div>
    </main>

    <footer class="mt-auto">
      <div class="container">
        <div class="row justify-content-center mx-auto pb-3">
          <div class="col-md-3 mb-3">
            <h5 class="text-light">About</h5>
            <ul class="list-unstyled">
              <li><a href="/" class="text-decoration-none text-muted">About GameLend</a></li>
              <li><a href="/" class="text-decoration-none text-muted">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-3">
            <h5 class="text-light">Support</h5>
            <ul class="list-unstyled">
              <li><a href="/" class="text-decoration-none text-muted">FAQ</a></li>
              <li><a href="/" class="text-decoration-none text-muted">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-3">
            <h5 class="text-light">Connect</h5>
            <ul class="list-unstyled">
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" class="text-decoration-none text-muted">
                  <i class="bi bi-github me-2"></i>GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright text-center pt-3 border-top border-secondary">
          <p class="text-muted mb-0">
            &copy; <%= new Date().getFullYear() %> GameLend. A WSU CPT_S 489 Course Project. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script id="chartDataJson" type="application/json">
      <%- JSON.stringify(chartData) %>
    </script>
    <script>
      const chartData = JSON.parse(document.getElementById('chartDataJson').textContent);
      
      // Category Chart (Doughnut)
      const catCtx = document.getElementById('categoryChart').getContext('2d');
      new Chart(catCtx, {
        type: 'doughnut',
        data: {
          labels: chartData.listingsByCategory.map(d => d.category),
          datasets: [{
            data: chartData.listingsByCategory.map(d => d.count),
            backgroundColor: [
              'rgba(255, 99, 132, 0.7)',
              'rgba(54, 162, 235, 0.7)',
              'rgba(255, 206, 86, 0.7)',
              'rgba(75, 192, 192, 0.7)',
              'rgba(153, 102, 255, 0.7)',
              'rgba(255, 159, 64, 0.7)'
            ],
            borderColor: '#212529',
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { color: '#f8f9fa' } },
            title: { display: true, text: 'Active Listings by Category', color: '#f8f9fa', font: { size: 16 } }
          }
        }
      });

      // Rental Status Chart (Bar)
      const statusCtx = document.getElementById('rentalStatusChart').getContext('2d');
      new Chart(statusCtx, {
        type: 'bar',
        data: {
          labels: chartData.rentalsByStatus.map(d => d.status),
          datasets: [{
            label: 'Rentals',
            data: chartData.rentalsByStatus.map(d => d.count),
            backgroundColor: 'rgba(54, 162, 235, 0.7)',
            borderColor: 'rgba(54, 162, 235, 1)',
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            title: { display: true, text: 'Rentals by Status', color: '#f8f9fa', font: { size: 16 } }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { color: '#adb5bd', stepSize: 1 },
              grid: { color: 'rgba(255,255,255,0.1)' }
            },
            x: {
              ticks: { color: '#adb5bd' },
              grid: { display: false }
            }
          }
        }
      });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin/quick-nav.js"></script>
  </body>
</html>