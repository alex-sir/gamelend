<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameLend · Analytics Hub</title>
    <link rel="icon" href="/assets/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/admin/admin.css" />
  </head>

  <body class="admin-page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-controller me-2"></i>GameLend <span class="ms-1" style="font-size: 0.85rem; font-weight: 400">Admin</span>
        </a>
      </div>
    </nav>

    <main class="py-4">
      <div class="container">
        
        <div class="admin-header mb-3">
          <a href="/admin/dashboard" class="btn btn-alternate mb-3">
            <i class="bi bi-house me-2"></i>Main Dashboard
          </a>

          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h1>Analytics Hub</h1>
              <p>Deep dive into GameLend performance, usage, and revenue.</p>
            </div>
          </div>
        </div>

        <section class="admin-section mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2>Key Metrics</h2>
          </div>

          <div class="row g-3">
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Active Listings</div>
                <div class="metric-value"><%= metrics.activeListings %></div>
                <div class="metric-trend text-success">
                  <i class="bi bi-arrow-up-right me-1"></i> Live right now
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Completed Rentals</div>
                <div class="metric-value"><%= metrics.completedRentals %></div>
                <div class="metric-trend text-info">
                  <i class="bi bi-clock-history me-1"></i> All-Time
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Platform Revenue</div>
                <div class="metric-value">$<%= Number(metrics.totalRevenue).toFixed(2) %></div>
                <div class="metric-trend text-success">
                  <i class="bi bi-currency-dollar me-1"></i> Total Earnings
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="metric-card">
                <div class="metric-label">Total Active Users</div>
                <div class="metric-value"><%= metrics.activeRenters + metrics.activeOwners %></div>
                <div class="metric-trend text-warning">
                  <i class="bi bi-people me-1"></i> Verified accounts
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="admin-section mb-4">
            <h2 class="mb-3">Performance Overview</h2>
            <div class="p-5 text-center bg-dark rounded border border-secondary border-opacity-25">
                <i class="bi bi-graph-up fs-1 text-muted d-block mb-3"></i>
                <p class="text-muted mb-0">Detailed traffic and rental charts will appear here as the marketplace grows.</p>
            </div>
        </section>

      </div>
    </main>

    <footer class="mt-auto">
      <div class="container">
        <div class="row justify-content-center mx-auto pb-3">
          <div class="col-md-3 mb-3">
            <h5 class="text-light">About</h5>
            <ul class="list-unstyled">
              <li><a href="/" class="text-decoration-none text-muted">About GameLend</a></li>
              <li><a href="/" class="text-decoration-none text-muted">Our Team</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-3">
            <h5 class="text-light">Support</h5>
            <ul class="list-unstyled">
              <li><a href="/" class="text-decoration-none text-muted">FAQ</a></li>
              <li><a href="/" class="text-decoration-none text-muted">Contact Us</a></li>
            </ul>
          </div>
          <div class="col-md-3 mb-3">
            <h5 class="text-light">Connect</h5>
            <ul class="list-unstyled">
              <li>
                <a href="https://github.com/alex-sir/gamelend" target="_blank" class="text-decoration-none text-muted">
                  <i class="bi bi-github me-2"></i>GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="copyright text-center pt-3 border-top border-secondary">
          <p class="text-muted mb-0">
            &copy; <%= new Date().getFullYear() %> GameLend. A WSU CPT_S 489 Course Project. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>