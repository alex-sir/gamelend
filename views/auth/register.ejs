<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account - GameLend</title>
    <link rel="icon" href="/icons/controller.png" type="image/png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <style>
      /* Custom styling for role selection cards */
      .role-select-card {
        cursor: pointer;
        border: 2px solid var(--color-gray-hover);
        transition: all 0.2s ease-in-out;
      }
      .role-select-card:hover {
        border-color: var(--color-orange);
      }
      .form-check-input:checked + .role-select-card {
        border-color: var(--color-blue);
        background-color: rgba(8, 75, 166, 0.1) !important;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100" style="background: linear-gradient(rgba(18, 18, 18, 0.9), rgba(18, 18, 18, 0.9)), url('/images/gaming-collage.jpg') center/cover; background-attachment: fixed;">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
        </a>
      </div>
    </nav>

    <main class="flex-grow-1 d-flex align-items-center justify-content-center py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-lg border-primary border-top border-4" style="background-color: var(--color-gray);">
              <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                  <i class="bi bi-person-plus display-1 text-primary"></i>
                  <h2 class="mt-3 fw-bold">Join GameLend</h2>
                  <p class="text-muted">Create an account to start borrowing or lending</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div><%= error %></div>
                  </div>
                <% } %>

                <form action="/auth/register" method="POST">
                  
                  <div class="mb-4">
                    <label class="form-label d-block mb-3">I want to...</label>
                    <div class="row g-3">
                      <div class="col-6">
                        <input type="radio" class="btn-check" name="role" id="role-borrower" value="borrower" autocomplete="off" checked>
                        <label class="btn role-select-card w-100 h-100 p-3 bg-dark text-start rounded-3" for="role-borrower">
                          <i class="bi bi-bag-check fs-4 mb-2 d-block text-orange" style="color: var(--color-orange);"></i>
                          <div class="fw-bold">Borrow Games</div>
                          <small class="text-muted">Find and rent items</small>
                        </label>
                      </div>
                      <div class="col-6">
                        <input type="radio" class="btn-check" name="role" id="role-lender" value="lender" autocomplete="off">
                        <label class="btn role-select-card w-100 h-100 p-3 bg-dark text-start rounded-3" for="role-lender">
                          <i class="bi bi-box-seam fs-4 mb-2 d-block text-primary"></i>
                          <div class="fw-bold">Lend Games</div>
                          <small class="text-muted">Earn from your collection</small>
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="email" class="form-label">Email address</label>
                    <div class="input-group">
                      <span class="input-group-text bg-dark border-secondary"><i class="bi bi-envelope text-muted"></i></span>
                      <input type="email" class="form-control bg-dark text-white border-secondary" id="email" name="email" required placeholder="name@example.com">
                    </div>
                  </div>
                  
                  <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                      <span class="input-group-text bg-dark border-secondary"><i class="bi bi-lock text-muted"></i></span>
                      <input type="password" class="form-control bg-dark text-white border-secondary" id="password" name="password" required placeholder="Create a secure password" minlength="6">
                    </div>
                  </div>

                  <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-main btn-lg">Create Account</button>
                  </div>
                  
                  <div class="text-center mt-4">
                    <p class="text-muted mb-0">Already have an account? <a href="/auth/login" style="color: var(--color-orange);">Log in here</a></p>
                  </div>
                </form>

              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
