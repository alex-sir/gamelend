<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account - GameLend</title>
    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <style>
      .auth-card {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5);
      }
      .form-floating > .form-control:focus ~ label,
      .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--color-orange);
      }
      .role-select-card {
        cursor: pointer;
        border: 2px solid var(--color-gray-hover);
        border-radius: 0.75rem;
        transition: all 0.2s ease-in-out;
      }
      .role-select-card:hover {
        border-color: var(--color-orange);
      }
      .form-check-input:checked + .role-select-card {
        border-color: var(--color-blue);
        background-color: rgba(8, 75, 166, 0.1);
      }
      .form-check-input:checked + .role-select-card .role-icon {
        color: var(--color-blue) !important;
      }
      .form-check-input:focus + .role-select-card {
        box-shadow: 0 0 0 0.25rem rgba(8, 75, 166, 0.25);
      }
      .back-btn {
        transition: color 0.2s;
      }
      .back-btn:hover {
        color: var(--color-orange) !important;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100" style="background: linear-gradient(rgba(18, 18, 18, 0.95), rgba(18, 18, 18, 0.95)), url('/images/gaming-collage.svg') center/cover; background-attachment: fixed;">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
        </a>
      </div>
    </nav>

    <main class="flex-grow-1 d-flex align-items-center py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-10 col-lg-7">
            <div class="card bg-dark auth-card">
              <div class="card-body p-4 p-md-5">
                
                <a href="/" class="text-muted text-decoration-none mb-4 d-inline-block back-btn">
                  <i class="bi bi-arrow-left me-1"></i> Back to Home
                </a>

                <div class="text-center mb-5">
                  <h1 class="h2 font-weight-bold">Join the Community</h1>
                  <p class="text-muted">Create an account to start borrowing or lending gaming equipment.</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div><%= error %></div>
                  </div>
                <% } %>

                <form action="/auth/register" method="POST" class="needs-validation" novalidate>
                  
                  <div class="mb-4">
                    <label class="form-label mb-3 fw-bold">I want to...</label>
                    <div class="row g-3">
                      <div class="col-sm-6">
                        <label class="w-100">
                          <input class="form-check-input position-absolute opacity-0" type="radio" name="role" id="roleBorrower" value="borrower" required checked>
                          <div class="role-select-card p-3 text-center h-100">
                            <i class="bi bi-bag-check fs-2 text-muted role-icon mb-2 d-block"></i>
                            <h5 class="mb-1">Borrow Games</h5>
                            <small class="text-muted">Find and rent equipment</small>
                          </div>
                        </label>
                      </div>
                      <div class="col-sm-6">
                        <label class="w-100">
                          <input class="form-check-input position-absolute opacity-0" type="radio" name="role" id="roleLender" value="lender" required>
                          <div class="role-select-card p-3 text-center h-100">
                            <i class="bi bi-box-seam fs-2 text-muted role-icon mb-2 d-block"></i>
                            <h5 class="mb-1">Lend Games</h5>
                            <small class="text-muted">List items and earn money</small>
                          </div>
                        </label>
                      </div>
                    </div>
                  </div>

                  <hr class="border-secondary my-4">

                  <div class="row g-3 mb-3">
                    <div class="col-md-6">
                      <div class="form-floating">
                        <input type="text" class="form-control bg-dark text-white border-secondary" id="firstName" name="firstName" placeholder="First Name" required>
                        <label for="firstName" class="text-muted">First Name</label>
                        <div class="invalid-feedback">First name is required.</div>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-floating">
                        <input type="text" class="form-control bg-dark text-white border-secondary" id="lastName" name="lastName" placeholder="Last Name" required>
                        <label for="lastName" class="text-muted">Last Name</label>
                        <div class="invalid-feedback">Last name is required.</div>
                      </div>
                    </div>
                  </div>

                  <div class="form-floating mb-3">
                    <input type="email" class="form-control bg-dark text-white border-secondary" id="email" name="email" placeholder="name@example.com" required>
                    <label for="email" class="text-muted">Email Address</label>
                    <div class="invalid-feedback">Please provide a valid email.</div>
                  </div>
                  
                  <div class="form-floating mb-4">
                    <input type="password" class="form-control bg-dark text-white border-secondary" id="password" name="password" placeholder="Password" required minlength="6">
                    <label for="password" class="text-muted">Password (Min 6 characters)</label>
                    <div class="invalid-feedback">Password must be at least 6 characters long.</div>
                  </div>

                  <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-main btn-lg py-3">Create Account</button>
                  </div>
                  
                  <div class="text-center">
                    <p class="text-muted mb-0">Already have an account? <a href="/auth/login" class="text-decoration-none" style="color: var(--color-orange); font-weight: 600;">Log in here</a></p>
                  </div>
                </form>

              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/form-validation.js"></script>
  </body>
</html>
