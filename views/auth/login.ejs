<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In - GameLend</title>
    <link rel="icon" href="/icons/controller.svg" type="image/svg+xml" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <style>
      .auth-card {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5);
      }
      .form-floating > .form-control:focus ~ label,
      .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--color-orange);
      }
      .back-btn {
        transition: color 0.2s;
      }
      .back-btn:hover {
        color: var(--color-orange) !important;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100" style="background: linear-gradient(135deg, rgba(8, 75, 166, 0.1) 0%, #121212 40%, #121212 60%, rgba(220, 83, 30, 0.1) 100%); background-attachment: fixed;">
    
    <nav class="navbar navbar-primary navbar-expand-lg sticky-top p-lg-3">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">
          <i class="bi bi-controller me-2"></i>GameLend
        </a>
      </div>
    </nav>

    <main class="flex-grow-1 d-flex align-items-center py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-8 col-lg-5">
            <div class="card bg-dark auth-card">
              <div class="card-body p-5">
                
                <a href="/" class="text-muted text-decoration-none mb-4 d-inline-block back-btn">
                  <i class="bi bi-arrow-left me-1"></i> Back to Home
                </a>
                
                <div class="text-center mb-4">
                  <i class="bi bi-person-circle display-4 text-orange mb-3 d-block"></i>
                  <h1 class="h3 font-weight-bold">Welcome Back</h1>
                  <p class="text-muted">Log in to manage your rentals and listings.</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div><%= error %></div>
                  </div>
                <% } %>

                <form action="/auth/login" method="POST" class="needs-validation" novalidate>
                  
                  <div class="form-floating mb-3">
                    <input type="email" class="form-control bg-dark text-white border-secondary" id="email" name="email" placeholder="name@example.com" required>
                    <label for="email" class="text-muted">Email address</label>
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                  </div>
                  
                  <div class="form-floating mb-4">
                    <input type="password" class="form-control bg-dark text-white border-secondary" id="password" name="password" placeholder="Password" required>
                    <label for="password" class="text-muted">Password</label>
                    <div class="invalid-feedback">Please enter your password.</div>
                  </div>

                  <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-main btn-lg py-3">Log In</button>
                  </div>
                  
                  <div class="text-center">
                    <p class="text-muted mb-0">Don't have an account? <a href="/auth/register" class="text-decoration-none" style="color: var(--color-orange); font-weight: 600;">Sign up here</a></p>
                  </div>
                </form>

              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/form-validation.js"></script>

    <!-- Suspension Modal -->
    <% if (typeof suspended !== 'undefined' && suspended) { %>
      <div class="modal fade" id="suspensionModal" tabindex="-1" aria-labelledby="suspensionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content bg-dark text-light border-danger shadow-lg">
            <div class="modal-header border-danger">
              <h5 class="modal-title d-flex align-items-center" id="suspensionModalLabel">
                <i class="bi bi-exclamation-octagon-fill text-danger me-2 fs-3"></i>
                Account Suspended
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p class="fs-5">Your access to GameLend has been temporarily restricted.</p>
              
              <div class="bg-danger bg-opacity-10 p-3 rounded border border-danger border-opacity-25 mb-4">
                <p class="mb-1 fw-bold text-danger">Reason for suspension:</p>
                <p class="mb-0 text-light"><%= suspensionReason || "No specific reason provided." %></p>
              </div>
              
              <p class="text-muted">If you believe this is a mistake or would like to appeal, please contact our moderation team at <strong class="text-white">support@gamelend.com</strong>.</p>
            </div>
            <div class="modal-footer border-top-0 pt-0">
              <button type="button" class="btn btn-danger px-4 fw-bold" data-bs-dismiss="modal">I Understand</button>
            </div>
          </div>
        </div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          var suspensionModal = new bootstrap.Modal(document.getElementById('suspensionModal'));
          suspensionModal.show();
        });
      </script>
    <% } %>
  </body>
</html>
